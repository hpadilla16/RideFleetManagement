# Example
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleet_management?schema=public"
PORT=4000
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="12h"
ALLOW_PUBLIC_REGISTER="false"
SENTRY_DSN=""
SENTRY_ENV="production"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Example
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleet_management?schema=public"
PORT=4000
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="12h"
ALLOW_PUBLIC_REGISTER="false"
SENTRY_DSN=""
SENTRY_ENV="production"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Performance tuning (defaults are sane; override only when you know why)
# Prisma connection pool (per worker process). Default 6.
# Math: ~2 API droplets × 4 workers + 1 BullMQ worker proc = 9 PG clients;
# 9 × 6 = 54 connections, leaving headroom against Supabase pooler cap (~60).
# Raise on paid tiers with a larger pooler. Do NOT raise blindly — pgbouncer
# silently hangs `prisma db push` when oversubscribed.
DATABASE_POOL_SIZE="6"
# Pool acquisition timeout in seconds. Default 10. When the pool is exhausted
# Prisma throws P2024 after this many seconds; the global error handler maps
# that to HTTP 503 + Retry-After: 5.
DATABASE_POOL_TIMEOUT="10"
# Postgres statement_timeout in ms (cancels runaway queries). Default 15s.
DATABASE_STATEMENT_TIMEOUT_MS="15000"
# Postgres idle_in_transaction_session_timeout in ms. Default 30s.
DATABASE_IDLE_TX_TIMEOUT_MS="30000"
# Threshold (ms) above which Prisma queries log a warn line. Set to 0 to disable.
PRISMA_SLOW_QUERY_MS="200"
# Threshold (ms) above which HTTP requests log a warn line + drop a Sentry breadcrumb.
SLOW_REQUEST_MS="1000"

# --- Public base URLs for customer-facing links ------------------------------
# Every link the backend emails or encodes into a QR is built from these. None
# of them were listed here before 2026-08-17, so scripts/env-diff-check.sh could
# not flag a droplet that was missing one — the links worked by luck, not by
# configuration, and a miss silently degrades to http://localhost:3000.
#
# SET CUSTOMER_PORTAL_BASE_URL. It is not interchangeable with the other two:
# five link builders read it with NO fallback chain at all and drop straight to
# http://localhost:3000 when it is unset — booking-engine.service.js (3 links),
# customer-portal.routes.js, and the customer password-reset link in
# customers.routes.js. Setting only APP_BASE_URL silently breaks those five.
#
# Three different resolution orders exist today:
#   * those five builders:            CUSTOMER_PORTAL_BASE_URL only.
#   * the ~11 other portal builders:  CUSTOMER_PORTAL_BASE_URL -> APP_BASE_URL
#                                     -> FRONTEND_BASE_URL.
#   * /sign/:token (T&C signing):     APP_BASE_URL -> FRONTEND_BASE_URL ->
#                                     CUSTOMER_PORTAL_BASE_URL, because that
#                                     page is served by the MAIN Next app, the
#                                     same deployment as the agent's wizard.
#
# One deployment serves both today, so a single hostname in all three is the
# normal configuration. Set APP_BASE_URL to the staff app explicitly if the
# customer portal is ever split onto its own hostname — otherwise signing links
# would follow the portal to a deployment that has no /sign route.
CUSTOMER_PORTAL_BASE_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
FRONTEND_BASE_URL="http://localhost:3000"

# Optional Redis pub/sub for cross-worker cache invalidation (Phase 3 L-1).
# When set, every cache.del / cache.invalidate / cache.clear is broadcast
# to other workers/instances so they can drop their local copies. Reads
# stay in-memory and synchronous — Redis is invalidation-only, not a
# read-through L2. Leave unset for single-worker / single-instance prod.
REDIS_URL=""
REDIS_INVALIDATION_CHANNEL="fleet:cache-invalidate"

# Supabase Storage (16h). Buckets must exist in the Supabase dashboard;
# see doc/storage-bucket-setup.md for the one-time provisioning steps.
# SUPABASE_URL is the same project URL Prisma points at (just the
# https://<project>.supabase.co part — no /storage/v1 suffix).
SUPABASE_URL=""
# SERVICE ROLE key — Settings → API → service_role secret. NOT the anon key.
# Backend-only; never ship this to a client.
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket names. Override only if your Supabase project uses non-default names.
SUPABASE_STORAGE_PHOTOS_BUCKET="inspection-photos"
SUPABASE_STORAGE_RECEIPTS_BUCKET="payment-receipts"
# Inventory Helper photos + PDFs (beta.145/147). The bucket must exist in
# Supabase Storage AND the flag below must be "true" — otherwise photos fall
# back to inline base64 and inventory PDFs are regenerated on every download
# (works, but heavier). Added to .env.example (2026-06-09) so
# env-diff-check.sh catches a droplet .env that's missing them.
SUPABASE_STORAGE_INVENTORY_BUCKET="inventory-photos"
# Master switch for storing inspection/inventory photos in Supabase Storage
# (shared with rental-agreement inspection photos — see
# rental-agreements/inspection-photos.js).
INSPECTION_PHOTOS_STORAGE_ENABLED="false"

# ============================================================================
# TL International franchise integration (round 5)
# ============================================================================
# Feature flag — when "false" the worker registers but the bootstrap UI
# is hidden and scheduled syncs are skipped at the orchestrator level.
# Ship dark, flip on once Hector pastes a cookie. Default: false.
TL_INTEGRATION_ENABLED="false"
# Back-office base URL. Override only for staging mirrors.
TL_INTERNATIONAL_BASE_URL="https://newadmin.tlinternationalgroup.com"
# Cron expression for the repeatable sync. Tenant-scoped overrides live in
# Tenant.integrationConfig.tlInternational.cronOverride.
TL_INTERNATIONAL_CRON="*/15 * * * *"
# Be polite — sleep between detail fetches to avoid hammering TL.
# Legacy fixed-delay value (used as fallback when MIN/MAX below are unset).
TL_INTERNATIONAL_DETAIL_DELAY_MS="2000"
# TL Integration stealth knobs — randomize the per-detail-fetch sleep so
# request cadence doesn't form an obvious 2s-on-the-dot pattern. The
# worker sleeps a random value in [MIN_MS, MAX_MS) between each detail
# fetch within a sync run.
TL_INTERNATIONAL_DETAIL_DELAY_MIN_MS=3000
TL_INTERNATIONAL_DETAIL_DELAY_MAX_MS=5000
# Skip cron-triggered syncs between 02:00-06:00 AST (UTC-4, no DST in PR).
# Manual "Run now" from the UI ignores this and runs at any hour.
# Set to "false" to disable the nightly pause.
TL_INTERNATIONAL_QUIET_HOURS_ENABLED=true
# Maximum jitter applied to each cron-triggered run (0-180000ms / 0-3min).
# Set to 0 to disable jitter; manual runs always bypass.
TL_INTERNATIONAL_JITTER_MAX_MS=180000
# Override the rotation pool with a single fixed UA. Leave commented out
# to let the worker pick a random UA from the hardcoded pool per run.
# TL_INTERNATIONAL_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Edg/120"
# Residential proxy URL — REQUIRED IN PROD. TL's CloudFlare binds the session
# cookie to the IP that earned it (Hector's residential PR IP). The droplet
# egresses from NYC, so without this proxy EVERY request (raw fetch + Puppeteer)
# is bounced to login.php and surfaces as a misleading "expired cookie" error —
# even with a freshly pasted cookie. Both tl-international.service.js (fetch
# dispatcher) and puppeteer-browser.js (Chromium --proxy-server) read this.
# Reach the proxy over Tailscale, e.g. http://100.x.y.z:8888. Tracked here
# (uncommented) on purpose so scripts/env-diff-check.sh fails the deploy if it's
# missing from the droplet .env. Leave empty ONLY for local dev / unit tests.
TL_INTERNATIONAL_PROXY_URL=""
# Puppeteer navigation timeout in ms for the CloudFlare-protected pages
# (/dashboard.php and detail JSON when raw fetch is bounced). 30s is
# conservative — challenges typically settle in 3-5s. Default: 30000.
TL_PUPPETEER_TIMEOUT_MS="30000"
# Puppeteer viewport. Wider viewports look more like a real desktop
# session. Defaults: 1366x900.
TL_PUPPETEER_VIEWPORT_WIDTH="1366"
TL_PUPPETEER_VIEWPORT_HEIGHT="900"
# Encryption key for IntegrationCredential.encryptedPayload — 32 bytes,
# base64-encoded. Generate ONCE with:
#     openssl rand -base64 32
# Required if any IntegrationCredential row exists. KEEP THIS SAFE — if
# you lose it, every stored cookie is permanently unrecoverable.
INTEGRATION_ENC_KEY=""

# --- Economy (RezLight) booking-source integration (2026-07-05) --------------
# Feature flag — when "false" the worker does NOT register the economy.sync
# handler and the scheduler does not start. Ship dark; flip on once Hector
# pastes credentials + configures at least one enabled area. Default: false.
ECONOMY_INTEGRATION_ENABLED="false"
# RezLight portal base URL. Override only for a staging mirror.
ECONOMY_BASE="https://rezlight.economyrentacar.com/Production"
# Autonomous sync cadence (minutes) + startup delay (seconds).
ECONOMY_SYNC_INTERVAL_MINUTES="15"
ECONOMY_SYNC_STARTUP_DELAY_SECONDS="60"
# Near-term date window for the list sweep. The account sees the FULL ~92k-row
# history — the worker NEVER sweeps it all; it filters pickups to
# [today - LOOKBACK, today + LOOKAHEAD] via rgDatePickup.
ECONOMY_DATE_WINDOW_LOOKBACK_DAYS="2"
ECONOMY_DATE_WINDOW_LOOKAHEAD_DAYS="30"
# Bounded list fetch. The lookup is sorted by rgDatePickup DESCENDING and
# paginated: the worker fetches pages of ECONOMY_LOOKUP_PAGE_SIZE rows and STOPS
# as soon as a page crosses below the window's start (desc order → no later page
# can be in-window) OR the hard ECONOMY_MAX_PAGES cap is hit. This bounds the
# sweep at PAGE_SIZE * MAX_PAGES rows — it NEVER walks the full ~92k history. If
# the cap is hit before crossing the window start, the service WARNs (the window
# is wider than the cap) instead of silently truncating.
ECONOMY_LOOKUP_PAGE_SIZE="200"
ECONOMY_MAX_PAGES="25"
# Politeness sleep (ms) between per-row processing within a run.
ECONOMY_DETAIL_DELAY_MIN_MS="500"
ECONOMY_DETAIL_DELAY_MAX_MS="1500"
# When "true", auto-create a lightweight Customer from Economy data when the
# ONLY thing blocking promotion is customer_not_found (mirrors TL). Default off.
ECONOMY_AUTO_CREATE_CUSTOMERS="false"
# Detail enrichment (pickup/dropoff TIME, phone, email, flight) is ON by
# default — contract captured live 2026-07-28 (command=load, resDocType=R).
# Set to "false" only as a kill switch; imports then fall back to the
# date-only/phoneless list rows (the old "everything at 8pm" behavior).
# ECONOMY_DETAIL_ENABLED="true"
# Escape hatch for the detail command itself (default "load").
# ECONOMY_DETAIL_COMMAND="load"
# Override the UA rotation pool with a single fixed UA (optional).
# ECONOMY_USER_AGENT=""

# --- NU Car Rentals (affiliates portal) booking-source integration (2026-07-09)
# GLOBAL feature flag. When != "true" the nu.sync worker is NOT registered and
# the scheduler does not start. Ship dark; flip on once Hector pastes NU
# credentials + configures the enabled FLL location. Default: false.
NU_INTEGRATION_ENABLED="false"
# NU affiliates portal base URL + page paths. Override only if routes move.
NU_BASE="https://affiliates.nucarrentals.com"
NU_LOGIN_PATH="/AffiliateLOGIN.aspx"
NU_RESERVATIONS_PATH="/affiliates.aspx"
# Autonomous sync cadence (minutes) + startup delay (seconds).
NU_SYNC_INTERVAL_MINUTES="15"
NU_SYNC_STARTUP_DELAY_SECONDS="60"
# Near-term date window for the date-range postback (Rental Date). NU is 1:1 FLL;
# the worker queries pickups in [today - LOOKBACK, today + LOOKAHEAD]. Per-config
# lookbackDays/lookaheadDays on NuLocationConfig override these when set.
NU_DATE_WINDOW_LOOKBACK_DAYS="2"
NU_DATE_WINDOW_LOOKAHEAD_DAYS="30"
# When "true", auto-create a lightweight Customer from NU data when the ONLY
# thing blocking promotion is customer_not_found (mirrors Economy). Default off.
NU_AUTO_CREATE_CUSTOMERS="false"
# Override the UA rotation pool with a single fixed UA (optional).
# NU_USER_AGENT=""

# --- Flexways (MobilityPS) booking-source integration (2026-07-13) -----------
# GLOBAL feature flag. When != "true" the flexways.sync worker is NOT registered
# and the scheduler does not start. Ship dark; flip on once Hector saves Flexways
# credentials + maps at least one enabled sede. Default: false.
FLEXWAYS_INTEGRATION_ENABLED="false"
# MobilityPS portal base URL (override only if it moves).
FLEXWAYS_BASE="https://system.mobilityps.com"
# Autonomous sync cadence (minutes) + startup delay (seconds).
FLEXWAYS_SYNC_INTERVAL_MINUTES="15"
FLEXWAYS_SYNC_STARTUP_DELAY_SECONDS="60"
# Near-term date window (Flexways is multi-sede; the worker queries pickups in
# [today - LOOKBACK, today + LOOKAHEAD] per sede). Per-sede lookbackDays/
# lookaheadDays on FlexwaysLocationConfig override these when set.
FLEXWAYS_DATE_WINDOW_LOOKBACK_DAYS="2"
FLEXWAYS_DATE_WINDOW_LOOKAHEAD_DAYS="30"
# When "true", auto-create a lightweight Customer from Flexways data when the ONLY
# thing blocking promotion is customer_not_found (mirrors NU/Economy). Default off.
FLEXWAYS_AUTO_CREATE_CUSTOMERS="false"
# OPTIONAL residential proxy for the grid fetch, in case reCAPTCHA v3 scores the
# datacenter IP low from the droplet (same mitigation as TL_INTERNATIONAL_PROXY_URL).
# Unset → egress from the droplet. e.g. "http://100.x.y.z:8888" over Tailscale.
FLEXWAYS_PROXY_URL=""

# --- Advantage (TSD RezCentral) booking-source integration (2026-07-16) ------
# GLOBAL feature flag. When != "true" the advantage.sync worker is NOT registered
# and the scheduler does not start. Ship dark; flip on once Hector saves Advantage
# credentials + maps at least one enabled (TSD account, branch) config. Default: false.
ADVANTAGE_INTEGRATION_ENABLED="false"
# TSD RezCentral base URL + app root (override only if TSD moves them).
ADVANTAGE_BASE="https://rezcentral.tsdasp.net"
ADVANTAGE_ROOT_PATH="/WebRezClient/"
# Autonomous sync cadence (minutes) + startup delay (seconds).
ADVANTAGE_SYNC_INTERVAL_MINUTES="15"
ADVANTAGE_SYNC_STARTUP_DELAY_SECONDS="60"
# Near-term date window (the worker queries pickups — the report's `Date Out` — in
# [today - LOOKBACK, today + LOOKAHEAD] per config). Per-config lookbackDays/
# lookaheadDays on AdvantageLocationConfig override these when set.
ADVANTAGE_DATE_WINDOW_LOOKBACK_DAYS="2"
ADVANTAGE_DATE_WINDOW_LOOKAHEAD_DAYS="30"
# When "true", auto-create a lightweight Customer from Advantage data when the ONLY
# thing blocking promotion is customer_not_found (mirrors NU/Economy/Flexways).
# NOTE: ~50% of Advantage rows carry no email, so with this ON those rows each get
# their OWN customer (by design — decision A, 2026-07-14). Default off.
ADVANTAGE_AUTO_CREATE_CUSTOMERS="false"
# How the report screen's date range is driven. MEASURED 2026-07-17 on the live
# DOM: CalFrom/CalTo are ASP.NET Calendar SERVER CONTROLS (<table>), not text
# inputs — a day is selected by postback, never by posting "MM/DD/YYYY".
#   "explicit" (DEFAULT, and what production must run) — drive the calendars to
#     the real sync window via __doPostBack('_ctl0$cphMaster1$CalFrom','<days
#     since 2000-01-01>'), then CalTo, then Submit. The ONLY mode that covers the
#     forward window (the sync asks for today-2 → today+30).
#   "mtd" — fire "Current MTD" (sets the range) then Submit (runs it). 2
#     postbacks, server-authoritative, and its window is exactly what the grid's
#     "Rows: N" footer counts → the RECONCILIATION path for the go-live check.
#     ⚠️ Covers the 1st→today ONLY: it fetches NONE of the lookahead, and 44% of
#     this feed is booked 3+ days before pickup. Not a production setting.
#   "none" — leave whatever range the screen defaults to.
# ("shortcut" is accepted as a legacy alias for "mtd".) Every mode is
# window-filtered client-side, so this only affects how much the SERVER returns —
# i.e. COVERAGE, never correctness. Any mode whose server range cannot reach the
# requested window logs a warning and puts an uncoveredDays count in the run notes.
ADVANTAGE_RANGE_MODE="explicit"
ADVANTAGE_RANGE_SHORTCUT_FIELD="cmdMonthTD"
# Portal timezone for the report's wall-clock dates (Advantage Orlando = Eastern).
ADVANTAGE_TIME_ZONE="America/New_York"

# Shared secret for /api/internal/* endpoints hit by the scraper droplet
# (pricing-engine run + citations ingest). The droplet sends it as
# Authorization: Bearer $BACKEND_INTERNAL_TOKEN. Generate with: openssl rand -hex 32
BACKEND_INTERNAL_TOKEN=""

# HTTP Basic Auth for the API docs (/api/docs and /api/docs/openapi.json). Without BOTH set,
# the docs return 503 (disabled). Share these with integrators who need the API reference.
DOCS_USER=""
DOCS_PASS=""

# Market Intelligence — Kayak all-in confirmation gate (2026-07-03).
# Kayak's effectiveDailyPrice is currently a TEASER (totalPrice/lorDays without
# taxes/fees). The pricing path (suggestions + AUTO rules + run comparison)
# EXCLUDES KAYAK-source RateOffer rows until the scraper team confirms the
# number is ALL-IN — feeding a teaser into the tax-aware gross-up would
# back-solve base rates ~18-25% too low and self-undercut via the live AUTO
# rules. Set to the literal "true" ONLY after that confirmation. Display
# surfaces (dashboard/charts/exports) always include Kayak regardless.
# OPERATIONAL: dotenv loads once at boot — flipping this requires editing the
# droplet .env AND `docker compose -f docker-compose.prod.yml restart backend worker`
# (no rebuild). Global across tenants; per-tenant DB config is a Fase B item.
KAYAK_EFFECTIVE_IS_ALL_IN="false"

# Market Intelligence auto-apply MASTER kill switch (2026-07-20). When "true",
# Engine A (tax-aware MI) may write LIVE per-class rental prices (RateDailyPrice)
# on the cron — but ONLY for profiles whose per-profile `autoApply` flag is ALSO
# true, and ONLY through the money guardrails (per-location floorBase + ceilingBase
# + maxDeltaPct on MarketPricingConfig; a beyond-band move is HELD, never applied).
# When "false" (default) the whole auto-apply path is DARK: the cron writes nothing
# and Engine B (PricingRule) keeps its current behavior unchanged. This is the
# instant-off — flip it on the droplet .env + `restart backend worker` (no rebuild).
MARKET_AUTOAPPLY_ENABLED="false"

# Quotes module (2026-07-17) — hours before a saved quote expires (lazy flip on read)
QUOTE_TTL_HOURS="72"

# ── Dejavoo / SPIn card terminal ──────────────────────────────────────────────
# These are the PLATFORM's terminal credentials — International Rental Corp's
# live merchant account. Since 2026-08-26 terminal config is PER TENANT: each
# tenant's own iPOS Auth Key + TPN live in AppSetting
# `tenant:<id>:paymentGatewayConfig` (Settings → Payment Gateway → SPIn Terminal),
# the Auth Key encrypted at rest under INTEGRATION_ENC_KEY. The charge path
# resolves tenant config FIRST and only then considers these.
SPIN_AUTH_KEY=""
SPIN_TPN=""
SPIN_MERCHANT_NUMBER="1"
SPIN_CALLBACK_URL=""
SPIN_PROXY_TIMEOUT="120"
#
# May a tenant with NO terminal of their own charge through the PLATFORM
# terminal above? Ships "true" so IRC — live on these env vars today, with no
# AppSetting row yet — does not go dark at deploy. Every such charge writes a
# WARN naming the tenant ("FALLING BACK TO THE PLATFORM TERMINAL"), so the
# migration backlog shows up in the logs instead of in a chargeback.
# Set to "false" once every tenant has their own Auth Key + TPN saved: the
# platform terminal then becomes unreachable from the charge path and an
# unconfigured tenant gets a clear 409 at the counter instead of settling into
# somebody else's merchant account.
# NOTE: a HALF-configured tenant (Auth Key without TPN, or vice versa) is
# refused in BOTH modes — it is never paired with the platform's other half.
SPIN_ALLOW_ENV_FALLBACK="true"
#
# Local dev without a terminal: synthetic approvals, no credentials needed.
# NEVER "true" in production.
SPIN_DRY_RUN="false"

# ── RIDE'S OWN SUBSCRIPTION BILLING (tenant subscriptions, 2026-08-27) ────────
#
# READ THIS BEFORE TOUCHING ANY OF IT: BILLING_AUTHNET_* is money flowing TO
# RIDE — a tenant paying for their Ride Fleet Manager subscription, on RIDE's
# Authorize.Net merchant account. The AUTHNET_* variables elsewhere in this file
# are the per-tenant RENTAL gateway: money flowing to the TENANT, on the
# TENANT's merchant account. The names are deliberately unalike because mixing
# them up would deposit our subscription revenue into a customer's bank account.
# Never copy a value from one set to the other.
#
# All of these are ENV, never AppSetting: the AppSetting table is readable by
# any settings code path and lands in every DB backup beside tenant data.
#
# env-diff-check.sh reads the KEY NAMES from this file, so a deploy that forgets
# one of these fails loudly instead of running half-configured.
#
# MUST be exactly "production" or "sandbox". There is NO default: the client
# throws on anything else. That is deliberate — the old behaviour defaulted to
# sandbox, so a misspelled value meant every enrollment silently went to the
# sandbox and NOBODY WAS EVER BILLED, with no error anywhere.
#
# WHEN IT THROWS, PRECISELY: on FIRST USE, not at boot. billingEnv() is called
# from inside the Authorize.Net call paths, so a missing or misspelled value
# does NOT take the API down during a deploy — the container starts, every
# other module works, and the failure surfaces the first time somebody opens an
# enrollment link or the reconciler polls. Reassuring for a deploy; also the
# reason a typo here can sit unnoticed until it is in front of a customer. Run
# scripts/env-diff-check.sh, which reads the key names from this file.
#
# This is also the ONLY switch between the rehearsal gateway and the real one:
# "sandbox" makes hosted-page card validation testMode (no authorization reaches
# the card networks), "production" makes it liveMode (a small authorization,
# immediately voided). There is deliberately no separate validation flag — one
# that outlived its rehearsal would hide a dead card until the first real bill.
# Rehearse with ENV/LOGIN_ID/TRANSACTION_KEY all pointing at sandbox, then move
# all three to production together.
BILLING_AUTHNET_ENV=""
BILLING_AUTHNET_LOGIN_ID=""
BILLING_AUTHNET_TRANSACTION_KEY=""
# HMAC-SHA512 key from the Authorize.Net merchant portal ("Signature Key" under
# Account > Settings > API Credentials & Keys), used to verify the billing
# webhook. THIS IS THE ONLY AUTHENTICATION ON
# POST /api/public/billing/authorizenet/webhook — there is no token and no
# session — so an empty or wrong value means every genuine delivery is rejected
# with a 401 and stored nowhere, silently, while the portal shows green. The
# 72-hour heartbeat in the reconciler exists to catch exactly that.
#
# NOT the same key as the per-tenant rental gateway's, which lives in the
# AppSetting paymentGatewayConfig. The two never share a route or a lookup.
BILLING_AUTHNET_SIGNATURE_KEY=""
# Where billing alarms go: a subscription falling PAST_DUE, a drift correction,
# a charge date that passed with no transaction, the webhook-silence heartbeat.
# THE PLATFORM OWNER, not the tenant — who to email on the TENANT side is design
# open question 11 and is deliberately unanswered, so this phase tells the owner
# and lets him decide who to call. Falls back to OPS_NOTIFICATION_EMAIL; with
# neither set the alarms are logged and nothing is sent.
BILLING_OWNER_NOTIFICATION_EMAIL=""
# Kill switch for the daily reconciliation sweep (worker container only). Any
# value but "false" leaves it on. It makes zero Authorize.Net calls while no
# tenant is enrolled, so leaving it on before the first subscriber is free.
#
# Tuning knobs, deliberately NOT listed as keys here so they do not become
# things every deploy must set — all have working defaults in code:
#   BILLING_RECONCILE_INTERVAL_HOURS   (24)  how often the sweep runs
#   BILLING_RECONCILE_STARTUP_SECONDS  (180) delay after worker boot
#   BILLING_WEBHOOK_STALE_DAYS         (7)   refuse events older than this
#   BILLING_SILENCE_GRACE_DAYS         (2)   how late a charge may be before
#                                            the silence detector goes looking
#   BILLING_HEARTBEAT_HOURS            (72)  silence window before alarming
BILLING_RECONCILE_ENABLED="true"
# Public origin the enrollment links point at, e.g. https://ridefleetmanager.com
BILLING_BASE_URL=""
# Hard deadline on each Authorize.Net call. A timeout means UNKNOWN, never
# "failed" — callers resolve it by asking Authorize.Net what happened, never by
# retrying, because a blind retry is how a customer gets charged twice.
BILLING_AUTHNET_TIMEOUT_MS="20000"
#
# ─── TENANT SUSPENSION (Phase 5) — THE HIGHEST-BLAST-RADIUS SWITCHES HERE ────
#
# NONE OF THESE ARE DECLARED AS KEYS, ON PURPOSE. Every one defaults to the
# safe/off value in code, and a key listed here becomes a name every deploy must
# set (scripts/env-diff-check.sh fails on a missing name). A gate that runs on
# every authenticated request must not be one broken deploy check away from
# being switched on by somebody pasting a value to make the check pass.
#
#   TENANT_SUSPENSION_ENFORCEMENT  (unset ⇒ off)
#       off      nothing is gated. THE DEFAULT, and how Phase 5 ships.
#       log      the gate decides and LOGS what it would have blocked, then
#                lets the request through. Run this for a full billing cycle
#                and read the '[tenant-suspension] WOULD BLOCK' lines: each one
#                is a route a real suspended-tenant workflow needed. That is how
#                the allowlist gets proven complete against real traffic.
#       enforce  blocked requests get 403 TENANT_SUSPENDED.
#       ANY OTHER VALUE RESOLVES TO off — a typo must not gate the platform.
#
#   TENANT_SUSPENSION_DISABLED     (unset ⇒ not killed)
#       "true" forces `off` no matter what the line above says. The 2am
#       kill-switch, read at call time, no redeploy. Same shape as
#       TWO_FACTOR_ENFORCEMENT_DISABLED. Separate from the mode variable so
#       restoring afterwards is putting one value back, not remembering two.
#
#   BILLING_DUNNING_ENABLED        (unset ⇒ false)
#       Automatic PAST_DUE → SUSPENDED after the grace window. ITS OWN SWITCH,
#       deliberately not the one above: setting Tenant.status='SUSPENDED'
#       already darkens a tenant's public booking site and stops their
#       integration syncs, so auto-suspension is a real production action even
#       on a build where no staff member would be locked out.
#
#   BILLING_DUNNING_GRACE_DAYS     (6)
#       Days PAST_DUE before access is cut. The owner's number ("3 × 2 days").
#       Clamped to a minimum of 1: a 0 would suspend on the first decline and
#       delete the grace window entirely.
#
# INTENDED ROLLOUT — four separate, individually reversible steps:
#   1. deploy with everything unset            nothing changes
#   2. TENANT_SUSPENSION_ENFORCEMENT=log       learn the allowlist
#   3. TENANT_SUSPENSION_ENFORCEMENT=enforce   the gate bites, manual suspends
#   4. BILLING_DUNNING_ENABLED=true            and only now, automatically


# ── THIRD-PARTY KEYS A TENANT MAY *NOT* SILENTLY INHERIT (2026-08-27) ─────────
# Read backend/src/lib/tenant-provider-credential.js before changing anything here.
#
# The platform holds credentials for several third-party providers. They are the
# HOUSE keys: they bill the platform's account, and anything sent under them is
# processed by that provider under the PLATFORM's contract, not the tenant's.
#
# Twice now a tenant inherited one by accident, because the code said
# `tenantKey || process.env.HOUSE_KEY`:
#   2026-08-26  every tenant charged through the platform SPIn terminal;
#   2026-08-27  Corpusa's traffic citations (driver name, licence details,
#               vehicle, location) were sent to api.anthropic.com under the
#               platform account — 14 documents, no log line, found during a UK
#               GDPR due-diligence exercise.
#
# THE RULE NOW: a tenant that has configured nothing makes NO external call.
# The keys below are unreachable for a tenant unless something explicitly names
# that tenant for that feature.
#
# The platform keys themselves. Leave EMPTY unless the platform genuinely needs
# its own (e.g. the public marketplace AI search, which has no tenant at all).
ANTHROPIC_API_KEY=""
TELNYX_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
SMS_FROM_NUMBER=""
#
# ── THE OPT-IN ───────────────────────────────────────────────────────────────
# Preferred door: the per-tenant flag in that feature's own settings
# (`allowPlatformKeyFallback` on the citation-OCR config, `smsAllowPlatformKeyFallback`
# in Tenant.settingsJson). It is per tenant, per feature, and visible to the
# operator next to the key itself.
#
# Second door — THESE VARS: a comma-separated list of tenant IDs, per feature.
# They exist for one case only: a tenant that is live on a platform key TODAY
# and would go dark the moment this change deploys. List them here so the deploy
# does not break them, then migrate them to their own key and delete the entry.
#
# There is NO wildcard. A literal "*" is dropped, on purpose — a wildcard is
# blanket silent inheritance with a nicer name, which is the thing being removed.
# Every resolution that uses a platform key writes a WARN naming the tenant and
# the feature ("USING THE PLATFORM CREDENTIAL FOR A TENANT"), on every call, so
# the backlog lives in the logs instead of in a GDPR questionnaire.
PLATFORM_KEY_ALLOW_CITATION_OCR=""
PLATFORM_KEY_ALLOW_KIOSK_ID_OCR=""
PLATFORM_KEY_ALLOW_REVIEW_PROOF=""
PLATFORM_KEY_ALLOW_SMS=""
