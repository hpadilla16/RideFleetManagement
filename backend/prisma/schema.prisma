// VozIA Fase 4 (2026-07-03): per-user idempotency ledger for write endpoints
// consumed by the VozIA voice agent (POST /reservations/:id/notes today;
// payment endpoints arrive in Fase 6). One row per (userId, key); replay
// returns the stored response instead of re-running the handler. Rows expire
// after 24h and are opportunistically cleaned on insert. userId is a plain
// scalar (no FK) — the ledger must survive user deletion for audit purposes.
model IdempotencyKey {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String
  key          String
  kind         String
  requestHash  String
  statusCode   Int?
  responseBody String?
  status       String   @default("IN_PROGRESS")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([userId, key])
  @@index([userId, kind, createdAt])
}

