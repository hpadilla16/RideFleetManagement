// Per-tenant, per-day rollup of the count() metrics that
// reservationsService.summary() returns. Updated by an out-of-band
// refresh path (manual today, scheduler-ready) so the dashboard
// endpoint can serve from a single-row read instead of running 5
// COUNT() queries per request.
//
// `day` is a calendar date in the tenant's local timezone (not UTC),
// stored as a DateTime at midnight for that day. The unique constraint
// on (tenantId, day) lets the refresh path use upsert.
//
// tenantId is NOT NULL on purpose. Postgres unique indexes don't treat
// NULL as equal — a (NULL, day) upsert would insert a duplicate row
// every time, causing unbounded table growth and unreliable findUnique
// reads. SUPER_ADMIN cross-tenant summary requests intentionally fall
// through to live aggregation (already cached for 30s at the route
// layer) and never write to this table.
model ReservationDailyCounter {
  id            String   @id @default(cuid())
  tenantId      String
  day           DateTime
  pickupsToday  Int      @default(0)
  returnsToday  Int      @default(0)
  checkedOut    Int      @default(0)
  feeAdvisories Int      @default(0)
  noShows       Int      @default(0)
  refreshedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, day])
  @@index([tenantId, refreshedAt])
}

// Action Board kiosk tokens.
//
// Each token authorizes one read-only kiosk display (a TV mounted in the
// store) to fetch the day's pickups + returns for ONE location. Tokens are
// long-lived by design — the TV stays plugged in, and the URL embedded in
// its bookmark is the entire auth.
//
// Tenant + Location are stored as plain string IDs (no Prisma relations) to
// keep this model self-contained and avoid back-reference churn on the two
// most-touched tables in the schema. Tenant-isolation is enforced at the
// service layer via the embedded tenantId — every call resolves the token
// then re-checks tenantId before returning data.
//
// Revoked tokens stay in the table (revokedAt set, not deleted) so the
// admin UI can show audit history and a re-issue flow doesn't lose label
// continuity.
model StoreBoardToken {
  id         String    @id @default(cuid())
  tenantId   String
  locationId String
  // Human-readable label set when the admin mints the token, e.g.
  // "Front Counter Display" or "Service Bay Monitor". Shown in the admin
  // CRUD list so they know which physical TV a token belongs to.
  label      String
  // 32-char URL-safe random string. Generated server-side. Never hashed —
  // matches the existing addendum signature-token pattern; the URL itself
  // is the credential and rotation is by mint+revoke, not by hashing.
  token      String    @unique
  // Optional pointer to the User who minted this token, for audit. Stored
  // as plain string ID (no FK) so user deletion doesn't cascade-delete the
  // token row.
  createdBy  String?
  createdAt  DateTime  @default(now())
  // Bumped on every successful kiosk fetch so admins can see "last seen 3
  // min ago" and detect a TV that lost connection.
  lastSeenAt DateTime?
  // Soft-delete. Set when admin revokes; row stays for audit. Service
  // refuses to serve data for tokens with revokedAt non-null.
  revokedAt  DateTime?

  @@index([tenantId])
  @@index([locationId])
}

// =============================================================================
// Market scraper — Rate Highway-style market intelligence pipeline.
//
// MarketScrapeProfile: per-tenant configuration that defines a scrape job —
//   target location + lookahead window + LOR + frequency + schedule + pricing
//   strategy applied to the cheapest-price results. One Rate can be the target
//   of multiple profiles (e.g. a Daily profile for the 1-14 day window and a
//   Weekly profile for the 15-30 day window, like Rate Highway uses).
//
// MarketScrapeRun: one execution of a profile. Stores aggregate metrics
//   (request counts, observations produced) and run status. The Observations
//   it produced live in MarketObservation.
//
// MarketObservation: the unit fact. One row per (run, pickupDate, sipp,
//   vendor) — i.e. for a given scrape execution and search day, this records
//   one competitor listing we saw for one car class from one vendor. Cheapest-
//   per-(profile, pickupDate, sipp) is derived on read (or by an upstream
//   aggregator before applying a strategy).
//
// Comparison vs current RateDailyPrice + the auto-apply ("correction") step
// run on top of these tables; they don't need their own persistent state
// for MVP — the import endpoint (/api/rates/:id/daily-prices/import) is the
// audit trail for what got applied.
// =============================================================================

enum MarketScrapeFrequency {
  // Run every day at scheduleHour:scheduleMinute (local to runTimezone).
  DAILY
  // Run every Monday at scheduleHour:scheduleMinute. Lower-volume use case
  // for tenants who don't want daily noise.
  WEEKLY
  // Run every `frequencyDays` days (e.g. 3 or 4). Used for the far-term
  // (days 29-60) outlook profile where daily refreshes are wasteful — prices
  // out there move slowly. Cadence is tenant-configurable per profile.
  EVERY_N_DAYS
}

enum MarketScrapeRunStatus {
  PENDING
  RUNNING
  SUCCESS
  // Some requests succeeded, some failed. Partial data still usable but
  // gaps exist for the failed (date, sipp) combinations.
  PARTIAL
  FAILED
}

enum MarketObservationStatus {
  // Found a price for this (sipp, pickupDate, vendor).
  FOUND
  // Source returned this SIPP slot but marked it sold out / closed.
  CLOSED
  // Raw category from the source couldn't be mapped to an ACRISS code. Stored
  // with rawCategory populated so we can extend the SIPP map.
  UNMAPPED
  // Scrape errored for this (date, sipp) — e.g. timeout, anti-bot block.
  ERROR
}

enum MarketPricingStrategy {
  // SuggestedPrice = cheapestCompetitor - strategyAmount.
  CHEAPEST_MINUS_AMOUNT
  // SuggestedPrice = cheapestCompetitor (no discount).
  MATCH_CHEAPEST
  // SuggestedPrice = cheapestCompetitor * (1 + strategyPct/100). For "price-up"
  // when our brand commands a premium.
  CHEAPEST_PLUS_PCT
  // SuggestedPrice = MAX(cheapestCompetitor, strategyFloor). Hard floor.
  STATIC_FLOOR
}

model MarketScrapeProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Human-readable label, must be unique per tenant. Example: "SJU 1-14 Daily"
  // or "SJU 15-30 Weekly" mirroring Rate Highway's naming convention.
  name String

  // Airport code or Location.code in the tenant's location catalog. The
  // scraper looks up the matching Location row when generating the search URL.
  locationCode String

  // Lookahead window relative to "today". A profile with windowStartDay=1,
  // windowEndDay=14 scrapes pickup dates tomorrow .. today+14. Splitting
  // near-term (1-14) vs longer-out (15-30) lets tenants apply different
  // strategies (close-in is less price-sensitive than far-out).
  windowStartDay Int
  windowEndDay   Int

  // Length of rental. 3 days is the typical leisure default; Rate Highway
  // uses 1 (Daily profile) + 7 (Weekly profile).
  lorDays Int @default(3)

  // When + how often the scheduler kicks this profile off.
  frequency      MarketScrapeFrequency @default(DAILY)
  // Cadence in days when frequency=EVERY_N_DAYS. Ignored for DAILY/WEEKLY.
  // Defaults to 1; the standard "far-term outlook" profile (days 29-60) uses 4.
  frequencyDays  Int                   @default(1)
  scheduleHour   Int                   @default(4)
  scheduleMinute Int                   @default(1)
  runTimezone    String                @default("America/Puerto_Rico")

  // JSON array of source codes the scraper should query, e.g. ["EXPEDIA"].
  // Future: ["EXPEDIA", "KAYAK", "PRICELINE"] for multi-source coverage.
  sources Json

  active Boolean @default(true)

  // Pricing strategy applied to (cheapest competitor per (date, sipp)) to
  // produce the SuggestedAmount we'd push to RateDailyPrice. Reusing the
  // same vocabulary as the standalone scraper CLI.
  strategy       MarketPricingStrategy @default(CHEAPEST_MINUS_AMOUNT)
  strategyAmount Decimal?              @db.Decimal(10, 2)
  strategyPct    Decimal?              @db.Decimal(5, 2)
  strategyFloor  Decimal?              @db.Decimal(10, 2)

  // The Rate whose RateDailyPrice rows we update with the suggestions. Null
  // until the tenant wires it up — profiles without a target run for
  // research only (XLSX output, no auto-apply).
  targetRateId String?
  targetRate   Rate?   @relation("MarketScrapeProfileTargetRate", fields: [targetRateId], references: [id])

  // When true, the Correction stage POSTs the suggestions to
  // /api/rates/:id/daily-prices/import after each successful run.
  // When false, the scrape produces an XLSX for human review only.
  autoApply Boolean @default(false)

  // Last-run tracking for the Activity Queue UI.
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastRunStatus MarketScrapeRunStatus?
  lastRunError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs         MarketScrapeRun[]
  observations MarketObservation[]
  rateOffers   RateOffer[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@index([targetRateId])
}

// Tax-aware pricing config per (tenant, location). Lets the engine back-solve the
// BASE rate to upload from a target ALL-IN price, undoing Expedia's taxes + fees +
// brokerage. connectionType chooses the formula (see pricing-grossup.js):
//   TITANIUM: all_in = base × (1 + taxes) × (1 + brokerage)
//   AMADEUS : all_in = base × (1 + brokerage) + base × taxes
// Opt-in: a location WITHOUT a config keeps the legacy behavior (no gross-up).
model MarketPricingConfig {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationCode     String // "SJU", "MCO", ...
  connectionType   String   @default("TITANIUM") // TITANIUM | AMADEUS
  taxes            Json     @default("[]") // [{ name: "PR tax", pct: 11.5 }, ...]
  brokeragePct     Decimal  @default(0) @db.Decimal(6, 3)
  floorBase        Decimal? @db.Decimal(10, 2) // per-location floor (BASE rate); null = none
  ceilingBase      Decimal? @db.Decimal(10, 2) // per-location ceiling (BASE rate); null = none
  // Max allowed |delta %| vs the CURRENT live resolved price for an AUTO write. A move beyond
  // this band is HELD (never applied, never clamped) so a broken scrape can't push a live price
  // out of band. null = NOT configured → AUTO writes fail-closed HOLD for this location.
  maxDeltaPct      Decimal? @db.Decimal(6, 3)
  // Utilization-based dynamic tiers (Fase 2): [{ maxPct, adjustAmount?, adjustPct? }] applied
  // ON TOP of the base margin, using projected utilization from the Availability Forecast.
  utilizationRules Json     @default("[]")
  currency         String   @default("USD")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, locationCode])
  @@index([tenantId])
}

// Money trail for every per-class rental price write the Market Intelligence engine makes
// (auto OR manual). One row per (rate, vehicleType, pickup date) decision. This is the
// audit of record for MI price changes — AuditLog can't be reused because it hard-requires
// a reservationId (a price change has no reservation). Additive, no FK relations so it never
// blocks a write and can't cascade-delete history.
model PriceChangeLog {
  id              String   @id @default(cuid())
  tenantId        String?
  locationCode    String?
  rateId          String
  vehicleTypeId   String?
  date            DateTime // the pickup date the daily price applies to
  oldDaily        Decimal? @db.Decimal(10, 2) // current live resolved BASE for that class/date
  newDaily        Decimal? @db.Decimal(10, 2) // the value written (or the rejected suggestion when held)
  deltaPct        Decimal? @db.Decimal(10, 3)
  runId           String? // MarketScrapeRun that drove it (null for legacy/manual-adhoc)
  competitorBasis String? // vendor + price that drove the suggestion, e.g. "Hertz @ $78.67 all-in"
  engine          String // MARKET_A | manual
  outcome         String // applied | held | clamped
  reason          String? // held/clamped reason
  oldFromFallback Boolean  @default(false) // oldDaily came from the header fallback (pre-existing cross-price data gap)
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([rateId, date])
  @@index([runId])
}

model MarketScrapeRun {
  id        String                @id @default(cuid())
  profileId String
  profile   MarketScrapeProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  status    MarketScrapeRunStatus @default(PENDING)

  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationSec Int?

  // Per-request counters so the Activity Queue can show "14 of 15 OK".
  requestsOk  Int @default(0)
  requestsErr Int @default(0)

  // Total observations produced (across all requests). Equivalent to the
  // count of MarketObservation rows for this run.
  observationsCount Int @default(0)

  // The number of classes the Correction step actually wrote (base rate). 0 means
  // the profile was research-only, everything was HELD, or there was no diff.
  pricesApplied Int @default(0)

  // Set when the AUTO auto-apply orchestrator has processed this run. Guards the
  // 15-min internal trigger from re-computing + re-logging an already-applied
  // latest run when no newer scrape run exists (efficiency + audit-bloat).
  autoApplyAt DateTime?

  errorMessage String?

  observations MarketObservation[]
  rateOffers   RateOffer[]

  @@index([profileId, startedAt])
}

model MarketObservation {
  id    String          @id @default(cuid())
  runId String
  run   MarketScrapeRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Denormalized profileId so we can query observations across runs of the
  // same profile (e.g. "show me the 30-day price history for SIPP=IFAR
  // pickup=2026-05-20 at SJU"). Always equal to run.profileId.
  profileId String
  profile   MarketScrapeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  observedAt DateTime @default(now())
  pickupDate DateTime @db.Date
  returnDate DateTime @db.Date
  lorDays    Int

  sipp        String
  // What the source actually returned before we ran it through the SIPP map.
  // Useful for debugging UNMAPPED rows ("our scraper saw 'Premium Convertible'
  // but didn't know how to map it").
  rawCategory String?
  vendor      String?

  source String @default("EXPEDIA")

  dailyPrice          Decimal? @db.Decimal(10, 2)
  totalPrice          Decimal? @db.Decimal(10, 2)
  // Total / LOR — the "real" per-day cost including fees & taxes. The daily
  // price Expedia shows prominently is pre-tax teaser; the effectiveDailyPrice
  // is what the customer actually pays per day.
  effectiveDailyPrice Decimal? @db.Decimal(10, 2)
  currency            String   @default("USD")

  status MarketObservationStatus @default(FOUND)

  @@index([profileId, pickupDate, sipp])
  @@index([runId])
  @@index([pickupDate, sipp])
}

// Where a RateOffer was scraped FROM (2026-07-02). The direct-Expedia scraper
// has been down (blocked) since Jul 1, so ingest pivots to the Kayak
// metasearch engine, which returns offers from many OTAs in one query.
enum RateSource {
  // Kayak metasearch — primary source. One search yields offers quoted by
  // multiple OTAs (Expedia, Priceline, EconomyBookings, Kayak itself...).
  KAYAK
  // Legacy direct-Expedia scraper (down since 2026-07-01). Kept so historic
  // rows and any future revival remain representable.
  EXPEDIA_DIRECT
  // CarRentals.com direct.
  CARRENTALS
}

// Market-intelligence rate offers (2026-07-02) — the new Kayak-based ingest
// table, replacing the direct-Expedia MarketObservation pipeline that went
// down Jul 1. Each row is one offer identified by the canonical triple:
//   source   — where we scraped (KAYAK metasearch, direct OTA...)
//   provider — the OTA quoting the price (Expedia, Priceline, ...)
//   supplier — the rental agency behind the car (Hertz, Zezgo, Dollar...)
// The scraper upserts on rateoffer_identity_key; `id` is DB-generated and
// never supplied by the scraper.
model RateOffer {
  // DB-side default (not client cuid()) — the droplet scraper writes raw SQL
  // and must be able to omit id entirely (Innovation review 2026-07-02).
  id    String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  runId String
  run   MarketScrapeRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Denormalized profileId so we can query offers across runs of the same
  // profile (e.g. "30-day price history for Compact SUV at SJU"). Always
  // equal to run.profileId.
  profileId String
  profile   MarketScrapeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  observedAt DateTime @default(now())

  // Where we scraped: KAYAK metasearch, direct OTA...
  source   RateSource
  // OTA quoting the price: Expedia, Priceline, EconomyBookings, KAYAK...
  provider String
  // Rental agency: Hertz, Zezgo, Dollar... "" when unknown — NOT NULL so the
  // dedup unique works (Postgres treats NULLs as distinct in unique indexes).
  supplier String

  pickupDate DateTime @db.Date
  returnDate DateTime @db.Date
  lorDays    Int

  // ACRISS code, best-effort mapping (lossy — secondary to rawCategory).
  sipp        String
  // Raw source label ("Compact SUV"...). Part of the identity key because the
  // SIPP mapping is lossy.
  rawCategory String
  // "Nissan Kicks or similar".
  carExample  String?

  dailyPrice          Decimal? @db.Decimal(10, 2)
  totalPrice          Decimal? @db.Decimal(10, 2)
  // Total / LOR — the "real" all-in per-day cost including fees & taxes, vs.
  // the pre-tax teaser dailyPrice sources show prominently.
  effectiveDailyPrice Decimal? @db.Decimal(10, 2)
  currency            String   @default("USD")

  // Reuses the existing MarketObservationStatus enum on purpose — same
  // FOUND/CLOSED/UNMAPPED/ERROR lifecycle applies to offers.
  status MarketObservationStatus @default(FOUND)

  @@unique([runId, source, provider, supplier, rawCategory, sipp, pickupDate, returnDate], name: "rateoffer_identity_key", map: "rateoffer_identity_key")
  @@index([source, provider, pickupDate, sipp])
  @@index([profileId, observedAt])
}

// =============================================================================
// PRICING INTELLIGENCE — per-Rate rules + suggestion queue
// =============================================================================
//
// PricingRule lives on a Rate. The pricing-suggestion-engine worker runs after
// every successful MarketScrapeRun, evaluates each active rule against the
// freshest observations for the rule's Rate (matched by Rate→Location and
// Rate's SIPP class), and produces a PricingSuggestion.
//
// If rule.mode = AUTO and |delta| <= rule.autoMaxDeltaPct → suggestion is
// written AUTO_APPLIED and Rate.daily is updated in the same transaction.
// Otherwise → suggestion is PENDING and surfaced in the Suggestions Inbox
// for human approval (48h expiration default).
//
// Spec: doc/market-intelligence-plan-2026-06-05.md
//
// =============================================================================

enum PricingRuleMode {
  // Worker writes the new price directly to Rate.daily when within guardrails.
  AUTO
  // Worker writes a PENDING PricingSuggestion; user approves manually.
  SUGGEST
}

enum PricingRuleStrategy {
  // Position N-th cheapest in the observed market. targetN required.
  NTH_CHEAPEST
  // Track a single named competitor. targetVendor required.
  CHASE_VENDOR
  // Compute nothing; rule is informational. Useful when tenant wants the
  // market dashboard without auto-pricing.
  MANUAL
}

enum PricingSuggestionStatus {
  PENDING // Awaiting human review (SUGGEST mode or AUTO over delta cap).
  APPLIED // User clicked Approve; Rate.daily updated.
  AUTO_APPLIED // Worker wrote directly without human review.
  REJECTED // User clicked Reject; reason captured.
  EXPIRED // 48h elapsed without action; rule re-evaluates next cycle.
}

model PricingRule {
  id String @id @default(cuid())

  // Each Rate owns 0..1 PricingRule. Unique so we can upsert by rateId.
  rateId String @unique
  rate   Rate   @relation(fields: [rateId], references: [id], onDelete: Cascade)

  // Denormalized for cheap tenant-scoped queries.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // SIPP class this rule defends (e.g. "IFAR" = mid-size SUV). Required for
  // multi-SIPP tenants where one MarketScrapeProfile observes many SIPPs in
  // one session — the engine reads rule.sipp directly so it knows which
  // SIPP's observations to compute against. Nullable so legacy rows (pre
  // multi-SIPP) fall back to resolveSippForRate's profile-based heuristic.
  sipp String?

  mode     PricingRuleMode     @default(SUGGEST)
  strategy PricingRuleStrategy @default(NTH_CHEAPEST)

  // For NTH_CHEAPEST: 1 = cheapest, 2 = 2nd cheapest, ... up to 10.
  targetN Int?

  // For CHASE_VENDOR: vendor name to match against MarketObservation.vendor.
  // Match is case-insensitive contains (so "Hertz" matches "Hertz Local Edition").
  targetVendor String?

  // Padding applied to the computed target price. Negative = undercut.
  // Example: targetN=2 + paddingPct=-2 → "2% cheaper than the 2nd cheapest".
  paddingPct Decimal @default(0) @db.Decimal(5, 2)

  // Safety guardrails — clamped after strategy + padding.
  floorPrice   Decimal @db.Decimal(10, 2)
  ceilingPrice Decimal @db.Decimal(10, 2)

  // For AUTO mode only: if |computed delta| exceeds this %, fall through to
  // PENDING instead of auto-applying. Protects against bad scraper data.
  // Null = no cap (always auto-apply). Recommended: 15.
  autoMaxDeltaPct Decimal? @db.Decimal(5, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // userId
  updatedBy String?

  suggestions PricingSuggestion[]

  @@index([tenantId, active])
}

model PricingSuggestion {
  id String @id @default(cuid())

  ruleId String
  rule   PricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Denormalized for inbox queries without join.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  rateId   String
  rate     Rate   @relation(fields: [rateId], references: [id], onDelete: Cascade)

  // What the rate.daily was when the engine ran.
  currentPrice   Decimal @db.Decimal(10, 2)
  // What the engine would set it to.
  suggestedPrice Decimal @db.Decimal(10, 2)
  // Cached deltas so the inbox doesn't recompute.
  deltaAmount    Decimal @db.Decimal(10, 2)
  deltaPct       Decimal @db.Decimal(6, 2)

  // Structured explanation: { strategy, targetVendor, targetN, marketMin,
  // marketMedian, yourRank, observationIds: [...], guardrailsHit: ['floor'|'ceiling'|'autoMaxDelta'] }
  reason Json

  status PricingSuggestionStatus @default(PENDING)

  appliedAt      DateTime?
  appliedBy      String?
  rejectedReason String?

  // PENDING entries auto-expire after 48h so old suggestions don't pile up.
  // The expire check runs as part of the daily engine pass.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([ruleId])
  @@index([rateId, status])
  @@index([expiresAt])
}

// Path D per-tenant volume metrics for promotion criteria automation.
// Written by daily 02:00-ET snapshot job. Read by the promotion-flagger
// service that surfaces candidates in SUPER_ADMIN review queue once a tenant
// crosses 2+ thresholds for 7 consecutive days.
//
// See doc/multitenancy-hybrid-architecture.md sections 7 + 8.
model LoadObservation {
  id                     String   @id @default(cuid())
  tenantId               String
  observedAt             DateTime @default(now())
  windowStart            DateTime
  windowEnd              DateTime
  reservationsCreated    Int      @default(0)
  concurrentStaffPeak    Int      @default(0)
  cacheInvalidations     Int      @default(0)
  inspectionMediaUploads Int      @default(0)
  voiceAgentMinutes      Int      @default(0)
  tierAtObservation      String   @default("STANDARD")

  @@index([tenantId, observedAt(sort: Desc)])
}

// Pillar 2 — per-tenant/per-location fee rates for the checkin fee engine.
// Resolution order in fee-engine.service.js:
//   1. location-specific (locationId != null)
//   2. tenant-default (locationId = null)
//   3. hardcoded fallback in code (HARDCODED_RATES const)
//
// Phase A SQL creates two partial unique indexes that Prisma cannot model:
//   - one-tenant-default per (tenantId, feeType) where locationId IS NULL
//   - one-location-override per (tenantId, locationId, feeType) where locationId IS NOT NULL
// These live in the DB only — do not let `prisma db push` drift the schema
// or it will try to drop them.
//
// feeType: EXCESS_MILEAGE | FUEL_REFILL | CLEANING_LIGHT | CLEANING_MEDIUM | CLEANING_HEAVY | SMOKING
// unit:    PER_MILE | PER_GALLON | FLAT
model FeeRate {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String?
  feeType    String
  unit       String
  amount     Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, locationId])
}

// V2 — Audit history for per-tenant Fee Rate changes.
// Captures every CREATE / UPDATE / TOGGLE / DELETE against the FeeRate table
// (writes happen via fee-rate-audit.service.recordChange inside the same
// Prisma transaction as the underlying mutation; insert failures degrade to
// a logger.warn — audit is best-effort, NOT a barrier to the user flow).
//
// No FK to FeeRate so DELETEs don't cascade away the audit trail. feeRateId
// is a string ref for convenience, nullable to handle deleted rows.
model FeeRateAuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  feeRateId   String?
  feeType     String
  locationId  String?
  actorUserId String?
  actorEmail  String?
  actorRole   String?
  changeType  String // CREATE | UPDATE | DELETE | TOGGLE
  before      Json?
  after       Json?
  changedAt   DateTime @default(now())

  @@index([tenantId, changedAt])
  @@index([feeRateId])
  @@index([changedAt])
}

/// Module-access grant/revoke trail (2026-07-25).
///
/// paymentActions authorizes charging and refunding a customer's card, so
/// "who gave this agent the ability to refund, and when" has to be answerable.
/// Those changes previously wrote only an AppSetting row and left no trace.
///
/// This is a STANDALONE table, modelled on FeeRateAuditLog, because AuditLog is
/// reservation-scoped: its `reservationId` is a REQUIRED String with a required
/// relation, and a permission change has no reservation to attach to. Writing
/// module-access rows into AuditLog is impossible, not merely awkward — the
/// first attempt did exactly that and every insert threw
/// PrismaClientValidationError into a best-effort catch, producing zero rows.
///
/// Holds IDs only, never emails or names: the actor and target are resolvable
/// by join, so there is no reason to copy PII into an audit row.
model ModuleAccessAuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  /// 'USER' (per-person override) | 'TENANT' (the tenant-wide switch)
  scope        String
  /// null when scope = 'TENANT'
  targetUserId String?
  actorUserId  String?
  actorRole    String?
  /// [{ module, from, to }] — only the keys that actually changed
  changed      Json
  changedAt    DateTime @default(now())

  @@index([tenantId, changedAt])
  @@index([targetUserId, changedAt])
  @@index([changedAt])
}

// PR-5 — Endpoint-level performance telemetry (PERF pillar).
// Distinct from `LoadObservation` (business volume): this table captures raw
// per-request samples (HTTP method, normalized route, status, duration, db
// time, cache hit) at a configurable sample rate (default 1%).
//
// Writes come from `backend/src/middleware/endpoint-load-sampler.js` and are
// fire-and-forget so a Prisma error never breaks the request.
//
// Daily rollup into `EndpointLoadObservationDaily` is done by
// `backend/src/jobs/endpoint-load-rollup.js` (wired to cron in PR-6).
model EndpointLoadObservation {
  id         String   @id @default(cuid())
  tenantId   String? // nullable for public/anonymous endpoints
  method     String // GET, POST, etc.
  route      String // normalized route pattern, e.g. "/api/reservations/:id"
  statusCode Int
  durationMs Int // total duration in ms
  dbTimeMs   Int? // db time if measurable
  cacheHit   Boolean? // null if endpoint doesn't use cache
  observedAt DateTime @default(now())

  @@index([tenantId, observedAt])
  @@index([route, observedAt])
  @@index([observedAt])
}

// PR-5 — Daily aggregation of EndpointLoadObservation.
// One row per (tenantId, route, day). `cacheHitRate` is null when the endpoint
// does not use the cache (i.e. all samples had cacheHit=null).
model EndpointLoadObservationDaily {
  id            String   @id @default(cuid())
  tenantId      String?
  route         String
  day           DateTime // truncated to midnight UTC
  requestCount  Int
  p50DurationMs Int
  p95DurationMs Int
  p99DurationMs Int
  errorCount    Int
  cacheHitRate  Float? // 0.0-1.0, null if not cached

  @@unique([tenantId, route, day])
  @@index([day])
}

// ============================================================================
// TL International franchise integration (round 5 — 2026-05-20)
//
// Pulls reservation pickups from the TL International back-office (Zezgo
// franchise channel hub) every 15 minutes, stages them into
// ExternalReservation, and hybrid-promotes eligible rows into Reservation.
//
// See doc/tl-integration-design-2026-05-19.md
// ============================================================================

model ExternalReservation {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id])
  sourceSystem            String // 'TL_INTERNATIONAL'
  externalRef             String // ZE# e.g. ZE1521152BA
  subBrand                String? // 'ZEZGO'
  channel                 String? // 'EXPEDIA02'
  supplierRef             String?
  status                  String? // raw TL status
  customerFirstName       String?
  customerLastName        String?
  customerEmail           String?
  customerPhone           String?
  customerCountry         String?
  flightNumber            String?
  vehicleAcriss           String? // 'CCAR'
  vehicleDescription      String?
  pickupAt                DateTime?
  pickupLocation          String?
  dropoffAt               DateTime?
  dropoffLocation         String?
  totalAmount             Decimal?                @db.Decimal(12, 2)
  currency                String?                 @default("USD")
  // Prepaid flag (2026-07-09, NU integration). Nullable + additive so it stays
  // meaningless for sources that don't carry a prepaid signal (TL/Economy leave
  // it null). NU derives it from the grid Code column: PP/OP → true (prepaid,
  // do NOT collect at counter), blank → false (pay-at-destination, counter
  // collects manually). Never affects the money posture — estimatedTotal only.
  isPrepaid               Boolean?
  rawJson                 Json
  firstSeenAt             DateTime                @default(now())
  lastSyncedAt            DateTime                @default(now())
  syncRunCount            Int                     @default(1)
  promotionStatus         ExternalPromotionStatus @default(PENDING)
  needsReviewReason       String? // 'customer_not_found' | 'acriss_unmapped' | 'location_unmapped' | 'currency_non_usd' | 'multiple_matches'
  promotedToReservationId String?                 @unique
  promotedToReservation   Reservation?            @relation("ReservationFromExternal", fields: [promotedToReservationId], references: [id])
  promotedAt              DateTime?
  promotedByUserId        String?
  rejectedReason          String?
  rejectedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([sourceSystem, externalRef], name: "source_ref_unique")
  @@index([tenantId, pickupAt])
  @@index([tenantId, promotionStatus])
  @@index([promotionStatus])
  @@index([promotedToReservationId])
}

model ExternalSyncRun {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  sourceSystem    String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  status          String // 'OK' | 'PARTIAL' | 'FAILED' | 'AUTH_EXPIRED'
  pickupsFound    Int       @default(0)
  newlyInserted   Int       @default(0)
  updatedExisting Int       @default(0)
  autoPromoted    Int       @default(0)
  needsReview     Int       @default(0)
  errorsCount     Int       @default(0)
  notes           String?

  @@index([tenantId, startedAt(sort: Desc)])
}

model IntegrationCredential {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  sourceSystem     String // 'TL_INTERNATIONAL'
  encryptedPayload String // base64(iv || authTag || ciphertext) — AES-256-GCM
  rotatedAt        DateTime  @default(now())
  rotatedByUserId  String?
  lastTestedAt     DateTime?
  lastTestStatus   String? // 'OK' | 'EXPIRED' | 'ERROR'
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, sourceSystem])
}

model AcrissCategoryMap {
  id              String   @id @default(cuid())
  tenantId        String? // null = global mapping
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  acrissCode      String // 'CCAR'
  vehicleCategory String // internal category string (matches VehicleType.classCode / category)
  createdAt       DateTime @default(now())

  @@unique([tenantId, acrissCode])
}

model LocationCodeMap {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  externalCode String // 'SJUA01'
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([tenantId, externalCode])
}

model FranchisePayoutPeriod {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  sourceSystem   String // 'TL_INTERNATIONAL'
  year           Int
  month          Int // 1-12
  expectedAmount Decimal   @default(0) @db.Decimal(12, 2)
  receivedAmount Decimal?  @db.Decimal(12, 2)
  receivedAt     DateTime?
  notes          String?
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, sourceSystem, year, month])
}

// ============================================================================
// Economy (RezLight) franchise integration (2026-07-05)
//
// Clones the TL International integration but for the Economy Rent A Car
// RezLight portal. Reuses ExternalReservation / ExternalSyncRun /
// IntegrationCredential / AcrissCategoryMap / LocationCodeMap as-is (their
// sourceSystem is a free string → 'ECONOMY'). The ONLY new table is
// EconomyLocationConfig: the generic per-(tenant, external area) enable
// switch that says "which reservations to look at" — kept generic (not
// hardcoded MIA/LAX) so ANY future booking-source connection can reuse the
// same shape. `externalArea` is the first 3 chars of rgLocPickup (MIAO01→MIA).
// One Economy credential per tenant (IntegrationCredential unique
// (tenantId, sourceSystem)) covers every enabled area.
//
// See doc/economy-integration-plan-2026-07-05.md
// ============================================================================
model EconomyLocationConfig {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  locationId    String // Ride location (Miami / FLL / MCO / LAX)
  externalArea  String // 'MIA' | 'LAX' — first 3 chars of rgLocPickup
  enabled       Boolean @default(true)
  // Per-area import window override (2026-07-09, Fase 5). NULL → fall back to the
  // env defaults ECONOMY_DATE_WINDOW_LOOKBACK_DAYS / ECONOMY_DATE_WINDOW_LOOKAHEAD_DAYS.
  // The worker fetches the UNION window (max lookback + max lookahead across the
  // tenant's ENABLED configs) in one list call, then applies each area's own
  // [lookback, lookahead] as a precision filter per row.
  lookbackDays  Int?
  lookaheadDays Int?

  // ---- Rate push (2026-07-28, outbound) ----------------------------------
  // The franchise portal's own location code for this area (RezAlliance
  // lstLocations: 'LAXO01' | 'MIAO01'). Required before this area can push.
  externalLocationCode String?
  // Per-area push switch. OFF by default: an area never pushes until it is
  // explicitly turned on, even when the global transport flag is live.
  ratePushEnabled      Boolean  @default(false)
  // Optional ACRISS alias overrides, {"RFM_CODE":"PORTAL_CODE"}. Codes match
  // 1:1 for most classes (CCAR/ECAR/FFAR/ICAR/IFAR at LAX), so this only
  // carries the exceptions; a class with no rate on either side is skipped.
  rateClassMapJson     String?
  // CLOSE-OUT SENTINEL (Hector 2026-07-28): the franchise blocks days by
  // pricing them absurdly high (LAX uses 250.00). Any EXISTING portal value
  // >= this threshold is a deliberate close-out and is NEVER overwritten —
  // pushing a real rate over it would silently re-open blocked inventory.
  // NULL disables the check, which also means the push refuses to run (a
  // location must declare its sentinel before it may write).
  rateCloseoutMin      Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([tenantId, externalArea])
  @@index([tenantId, enabled])
}

// ============================================================================
// Outbound rate push audit (2026-07-28). Every value RFM writes into a
// franchise portal, one row per (location, class, DATE) — the portals price
// per calendar day, not per base rate. Money-adjacent: this table is the
// forensic record of what we changed on someone else's system, what it was
// before, what triggered it, and whether a read-back confirmed it landed.
// ============================================================================
// ============================================================================
// Business documents per LOCATION (2026-07-28). Operating permits, vehicle
// registrations, insurance certificates, licences - the paperwork a branch
// must keep current to trade legally.
//
// The file itself lives in Supabase Storage; only its path is stored here.
// Expiry STATUS is derived from expiresAt at read time, never stored, so a
// document cannot silently look valid because a status column went stale.
// ============================================================================
model LocationDocument {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  docType String // PERMIT | REGISTRATION | INSURANCE | LICENSE | TAX | LEASE | OTHER
  label   String // what the operator calls it, e.g. "City of Los Angeles business permit"
  notes   String?

  // Storage reference (private bucket; reads are signed on demand).
  storagePath String
  fileName    String?
  mimeType    String?
  sizeBytes   Int?

  issuedAt  DateTime? @db.Date
  // NULL = the document never expires (some registrations are perpetual), and
  // such a row is simply never chased by the expiry sweep.
  expiresAt DateTime? @db.Date

  // ACTIVE | ARCHIVED. Superseded uploads are archived, never deleted, so the
  // history of what was on file at a given time survives an audit.
  status String @default("ACTIVE")

  uploadedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, locationId, status])
  @@index([tenantId, expiresAt])
}

model RatePushLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  provider             String // 'ECONOMY' (NU/MEX/ADVANTAGE reuse this table)
  locationId           String // Ride location
  externalLocationCode String // portal code, e.g. LAXO01
  classCode            String // ACRISS as the PORTAL knows it
  rateDate             DateTime @db.Date // the grid column this value belongs to
  plan                 String   @default("DY") // DY | WY | MY | HY | ED
  // 2026-07-28 (LAX #2): the portal prices PER RATE PLAN (LOR tier — 1TO2,
  // 3DYS … STND) and ALL must update, so the audit key carries the rate code.
  // Default STND is historically correct: every pre-fix write targeted STND
  // only (that was the bug).
  rateCode             String   @default("STND")

  priorValue       Decimal? @db.Decimal(10, 2) // what the portal showed before
  pushedValue      Decimal  @db.Decimal(10, 2) // what RFM wrote
  sourceRateItemId String? // RateItem the value came from (traceability)

  trigger    String // 'MI_AUTOAPPLY' | 'MANUAL' | 'DRIFT_SWEEP'
  mode       String // 'DRY_RUN' | 'LIVE'
  status     String // 'PLANNED' | 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED' | 'SENT' | 'VERIFIED' | 'MISMATCH' | 'FAILED' | 'SKIPPED'
  skipReason String? // guardrail that suppressed it (held/no-map/out-of-band)

  // ---- Approval (F4, 2026-07-28) ----------------------------------------
  // A move beyond the delta band is a real repricing decision, not noise, so
  // instead of dying in the log it waits here for a human. An APPROVED row
  // authorises exactly ONE push of that (class, date, value) on the next
  // sweep — the band is bypassed for that cell only, never globally.
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?

  verifiedValue Decimal?  @db.Decimal(10, 2) // read-back from the portal
  verifiedAt    DateTime?
  error         String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([tenantId, provider, createdAt])
  @@index([tenantId, locationId, classCode, rateDate])
  @@index([tenantId, status])
}

// ============================================================================
// NU Car Rentals (affiliates portal) franchise integration (2026-07-09)
//
// Clones the Economy integration but for the NU Car Rentals ASP.NET WebForms +
// Telerik affiliates portal. Reuses ExternalReservation / ExternalSyncRun /
// IntegrationCredential / AcrissCategoryMap as-is (their sourceSystem is a free
// string → 'NU'). The ONLY new table is NuLocationConfig: the per-tenant enable
// switch that maps the NU credential to a Ride location.
//
// NU → FLL is 1:1 (one credential = one location, center "100"/FLL). Unlike
// Economy (per-area prefix filter), there is NO area filter — the target Ride
// locationId is resolved from the single enabled NuLocationConfig row. The
// nullable `externalCenter` (e.g. "100") is carried so multi-center NU accounts
// can be supported later by mapping rows to a specific center.
//
// One NU credential per tenant (IntegrationCredential unique
// (tenantId, sourceSystem)) covers the account.
//
// See doc/nu-integration-plan-2026-07-09.md
// ============================================================================
model NuLocationConfig {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  locationId     String // Ride location (FLL)
  // NU portal center code (e.g. "100" = FT. LAUDERDALE). Nullable — NU accounts
  // CAN be multi-center later; for the 1:1 FLL case it is optional metadata.
  externalCenter String?
  enabled        Boolean  @default(true)
  // Per-config import window override (mirrors Economy). NULL → fall back to the
  // env defaults NU_DATE_WINDOW_LOOKBACK_DAYS / NU_DATE_WINDOW_LOOKAHEAD_DAYS.
  lookbackDays   Int?
  lookaheadDays  Int?
  createdAt      DateTime @default(now())

  // 1:1 FLL: one enabled config row per tenant is expected. The unique is on
  // (tenantId, locationId) — the sane key for the 1:1 shape (one Ride location
  // mapped once per tenant). externalCenter stays free for future multi-center.
  @@unique([tenantId, locationId])
  @@index([tenantId, enabled])
}

// ============================================================================
// Flexways (MobilityPS) franchise integration (2026-07-13)
//
// Third autonomous booking-source (after TL → Economy → NU). Reuses
// ExternalReservation / ExternalSyncRun / IntegrationCredential / AcrissCategoryMap
// as-is (their sourceSystem is a free string → 'FLEXWAYS'). The ONLY new table is
// FlexwaysLocationConfig.
//
// Unlike NU (1:1 FLL), Flexways is MULTI-SEDE: inventory in the MobilityPS portal
// is keyed by `idSede` (branch — e.g. idSede=383). A tenant maps N portal sedes to
// N Ride locations, so this is a per-sede table (Economy's multi-row shape). The
// worker fetches each enabled sede's grid on its own date window and pins its rows
// to that sede's Ride location.
//
// One Flexways credential per tenant (IntegrationCredential unique
// (tenantId, sourceSystem)) covers the whole account.
//
// See doc/flexways-integration-plan-2026-07-13.md
// ============================================================================
model FlexwaysLocationConfig {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  // Portal branch id (e.g. "383"), from the MobilityPS URLs (idSede=...). The
  // identity of a Flexways config row within a tenant.
  idSede        String
  locationId    String // Ride location this sede maps to
  enabled       Boolean  @default(true)
  // Per-sede import window override (mirrors Economy/NU). NULL → fall back to the
  // env defaults FLEXWAYS_DATE_WINDOW_LOOKBACK_DAYS / FLEXWAYS_DATE_WINDOW_LOOKAHEAD_DAYS.
  lookbackDays  Int?
  lookaheadDays Int?
  createdAt     DateTime @default(now())

  // One config row per (tenant, portal sede).
  @@unique([tenantId, idSede])
  @@index([tenantId, enabled])
}

// ============================================================================
// Advantage (TSD RezCentral) franchise integration (2026-07-16)
//
// FIFTH autonomous booking-source (TL → Economy → NU → Flexways → Advantage).
// Reuses ExternalReservation / ExternalSyncRun / IntegrationCredential /
// AcrissCategoryMap as-is (their sourceSystem is a free string → 'ADVANTAGE').
// The ONLY new table is AdvantageLocationConfig.
//
// Advantage lives inside TSD RezCentral (rezcentral.tsdasp.net/WebRezClient), an
// ASP.NET WebForms back-office. Its report screen keys inventory by TWO fields:
// `lstTSDNumber` (the account — 61302 = Advantage Orlando) and `lstBranch` (MCO).
// The report grid echoes the pair back in ONE cell, `Loc` = "61302.MCO". So a
// config row is per (tsdNumber, branch) → Ride location; a tenant may map N such
// pairs (Flexways' multi-row shape, keyed by two columns instead of one).
//
// NO hardcoded tenant/location: Corpusa is the first operator in practice, but
// every mapping is data (recon 2026-07-14 / Hector's decision).
//
// One Advantage credential per tenant (IntegrationCredential unique
// (tenantId, sourceSystem)) covers the whole RezCentral account.
//
// See doc/advantage-integration-plan-2026-07-13.md
// ============================================================================
model AdvantageLocationConfig {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  // TSD account number as it appears in `lstTSDNumber` and in the grid's `Loc`
  // cell prefix (e.g. "61302"). Stored as text — it is an identifier, not a
  // number to do math on, and the portal renders it zero-padded.
  tsdNumber     String
  // Branch code as it appears in `lstBranch` / the grid's `Loc` suffix ("MCO").
  branch        String
  locationId    String // Ride location this (tsdNumber, branch) maps to
  enabled       Boolean  @default(true)
  // Per-config import window override (mirrors Economy/NU/Flexways). NULL → fall
  // back to ADVANTAGE_DATE_WINDOW_LOOKBACK_DAYS / _LOOKAHEAD_DAYS.
  lookbackDays  Int?
  lookaheadDays Int?
  createdAt     DateTime @default(now())

  // One config row per (tenant, TSD account, branch).
  @@unique([tenantId, tsdNumber, branch])
  @@index([tenantId, enabled])
}

// MEX Rent a Car (2026-07-26): sibling of AdvantageLocationConfig — MEX's
// portal is the SAME TSD RezCentral software, so the config shape is
// identical. Own model so a tenant can run Advantage AND MEX side by side.
model MexLocationConfig {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tsdNumber     String
  branch        String
  locationId    String
  enabled       Boolean  @default(true)
  lookbackDays  Int?
  lookaheadDays Int?
  createdAt     DateTime @default(now())

  @@unique([tenantId, tsdNumber, branch])
  @@index([tenantId, enabled])
}

// =====================================================================
// Incident / Damage Report module (ported from feature/incident-report
// 2026-06-02, beta.62). Migration: 20260601_add_incident_report.
// =====================================================================
enum IncidentReportType {
  DAMAGE
  SMOKING
  CLEANING
  POLICY_VIOLATION
  TOLL
  LATE_RETURN
  OTHER
}

enum IncidentReportStatus {
  DRAFT
  ISSUED
  DISPUTED
  RESOLVED
  CLOSED
  VOID
}

enum IncidentEvidenceStatus {
  CONFIRMED
  VIOLATION
}

enum IncidentReportSeverity {
  MINOR
  MODERATE
  SEVERE
}

model ReservationIncident {
  id            String      @id @default(cuid())
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  // Optional link to the rental agreement (when one exists for the reservation).
  rentalAgreementId String?

  reportNumber String                  @unique // INC-YYYYMMDD-PLATE
  type         IncidentReportType
  status       IncidentReportStatus    @default(DRAFT)
  severity     IncidentReportSeverity?
  title        String // banner headline

  discoveryAt        DateTime
  narrative          String? // §3 evidence narrative
  preRentalCondition String? // §2 (defaults from CHECKOUT inspection)
  odorNoted          String?
  conditionAtReturn  String?

  // §5 cited clauses (snapshot from the tenant clause library at issue time)
  // and §7 auto-composed rebuttal.
  citedClausesJson String? // [{ section, label, text, amountRange }]
  rebuttalText     String?

  // §6 charge + deposit linkage
  chargeIdsJson  String? // RentalAgreementCharge ids included in the summary
  depositApplied Decimal? @db.Decimal(10, 2)

  // §9 certification (locks on ISSUED)
  certifiedByName  String?
  certifiedByTitle String?
  signatureDataUrl String?   @db.Text
  certifiedAt      DateTime?
  issuedAt         DateTime?

  // Revision chain — a "revise after issue" clones into a new row.
  revisionOfId String?
  revisionOf   ReservationIncident?  @relation("IncidentRevisions", fields: [revisionOfId], references: [id])
  revisions    ReservationIncident[] @relation("IncidentRevisions")

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence     IncidentEvidence[]
  repairOrders RepairOrder[]

  @@index([tenantId, status])
  @@index([reservationId])
}

model IncidentEvidence {
  id         String              @id @default(cuid())
  incidentId String
  incident   ReservationIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  tenantId   String?

  ordinal        Int // Fig. # / row #
  location       String // "Cup Holders — Center Console"
  description    String
  evidenceStatus IncidentEvidenceStatus @default(VIOLATION)

  // Photo: a new upload (Supabase Storage path) OR a reference to an existing
  // inspection photo. sourcePhase records provenance for before/after.
  storagePath   String?
  contentType   String?
  sourcePhase   String? // CHECKOUT | CHECKIN | NEW
  takenAt       DateTime @default(now()) // chain-of-custody timestamp
  takenByUserId String?

  createdAt DateTime @default(now())

  @@index([incidentId, ordinal])
}

model AgreementClause {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  section     String // "6"
  label       String // "Smoking Fee"
  text        String              @db.Text
  amountRange String? // "$500 + tax"
  category    IncidentReportType? // default association to a report type
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

// ===========================================================================
// Dejavoo Spin checkout redesign (2026-05-28)
//
// The CheckoutSession drives a 6-step orchestrated wizard across three
// surfaces — agent screen, customer display, agent's mobile (during
// inspection). Each surface subscribes to the session's currentStep and
// renders its own per-step UI. State transitions are explicit POSTs.
// ===========================================================================

enum CheckoutStep {
  CONFIRMING // Step 1 — agent verifies customer, vehicle, decline-insurance
  TC_PENDING // Step 2 — customer is signing T&C on their phone
  TC_SIGNED // intermediate before payment
  PAYMENT_PENDING // Step 3 — terminal is waiting for tap/insert/swipe
  PAID // sale + preauth + tokenize complete
  INSPECTION_HANDOFF // Step 4 — agent scans QR to continue on mobile
  INSPECTION_IN_PROGRESS // Step 5 — capturing photos / metrics on mobile
  CUSTOMER_SIGN_PENDING // Step 6 — phone handed to customer to sign inspection
  FINALIZING // building PDF, emailing
  CLOSED // happy path terminal state
  CANCELLED // explicit abort
}

model CheckoutSession {
  id            String           @id @default(cuid())
  reservationId String           @unique
  reservation   Reservation      @relation(fields: [reservationId], references: [id])
  agreementId   String?
  agreement     RentalAgreement? @relation(fields: [agreementId], references: [id])
  tenantId      String?
  currentStep   CheckoutStep     @default(CONFIRMING)

  // M2 P2 (2026-08-17) — lightweight optimistic versioning. Bumped on every
  // transition / side-effect stamp / customer signature. Clients MAY send
  // `expectedVersion` on those POSTs to get a 409 STALE_VERSION (with the
  // fresh row) instead of acting on a state another surface already moved.
  // Opt-in on purpose: web wizard, kiosk and precheckin never send it, so
  // their behavior is byte-for-byte identical to before this column existed.
  stateVersion Int @default(0)

  // JSON array of { from, to, actorUserId, at, metadata } — full transition
  // log. Used by the stuck-checkouts dashboard tile.
  events String @db.Text

  // Per-step completion stamps. Used both by the customer display poller
  // (to know which screen to render) and by the nightly auto-flag job.
  tcCompletedAt         DateTime?
  paymentCompletedAt    DateTime?
  inspectionCompletedAt DateTime?
  customerSignedAt      DateTime?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  // Set by the nightly cleanup job when a session has been stuck in a
  // non-terminal step for > 4 hours, or when an agent explicitly
  // abandons via the wizard's Save & pause button.
  abandonedAt     DateTime?
  abandonedReason String?

  // Phase 3.5 — stamped the first (and only) time the auto-email fires
  // after the session reaches CLOSED. Guards against double-fires on
  // accidental re-transitions and lets the UI show "Sent {when}" /
  // "Resend signed copy" instead of just "Email Agreement".
  autoEmailedAt DateTime?

  startedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([currentStep])
  @@index([tenantId, currentStep])
  @@index([abandonedAt])
}

// M2 P1 (2026-08-17) — which of the four coexisting checkout surfaces is
// touching a session. RIDEOPS = the staff yard app, COUNTER = the desktop web
// wizard, KIOSK = the lobby tablet, CUSTOMER = the customer's own phone
// (terms-signing / customer-inspection pages). Deliberately NOT mirrored in
// rideops/lib/core/api/enums.dart yet — the Dart mirror lands with M2-H6.
enum CheckoutSurface {
  RIDEOPS
  COUNTER
  KIOSK
  CUSTOMER
}

// M2 P1 (2026-08-17) — soft presence/claim on a checkout session. PURELY
// INFORMATIVE: nothing anywhere may gate on these rows (Hector-approved plan,
// ops-app-plan/M2-PLAN.md §1.2 — "informativa, nunca bloquea"). Each surface
// heartbeats POST /api/checkout-sessions/:id/presence; readers get only the
// rows fresh within the 45 s logical TTL (filtered at read time — no cron, no
// deletes needed for correctness). `sessionId` is a LOOSE reference like
// KioskSession.checkoutSessionId — no FK, so presence writes can never break
// or block the money path, and stale rows are harmless noise.
model CheckoutPresence {
  id        String          @id @default(cuid())
  sessionId String
  surface   CheckoutSurface

  // Staff surfaces send the authenticated user; the kiosk (device, no user)
  // and the customer's phone (token, no user) leave it null. NOTE: Postgres
  // treats NULLs as distinct in the compound unique below, so the migration
  // adds a partial unique index on (sessionId, surface) WHERE actorUserId IS
  // NULL to keep the null-actor rows singleton too.
  actorUserId  String?
  displayLabel String?
  lastSeenAt   DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([sessionId, surface, actorUserId])
  @@index([sessionId, lastSeenAt])
}

enum HandoffTokenKind {
  TERMS_SIGNING // Step 2 — opens /sign/:token on customer's phone
  MOBILE_INSPECTION // Step 4 — opens /checkout/mobile/:token on agent's phone
  CUSTOMER_INSPECTION // 2026-06-11 — opens /inspect/:token on the CUSTOMER's phone (24h TTL)
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer-led inspection + damage approval (2026-06-11).
// Plan: doc/customer-inspection-plan-2026-06-11.md. When the tenant setting is
// on, checkout step 4 can delegate the walkthrough to the customer: they get
// an email link, annotate damages as dots on per-view vehicle diagrams, and
// every report lands in the agent's approval queue (soft/hard). Hard-approved
// damages live on the vehicle until marked FIXED (repair photo required).
// ─────────────────────────────────────────────────────────────────────────────

enum VehicleView {
  FRONT
  REAR
  LEFT
  RIGHT
  INTERIOR
}

enum CustomerInspectionStatus {
  SENT // email sent; customer hasn't submitted
  SUBMITTED // customer finished (0+ damage reports) — needs agent review
  REVIEWED // agent finished reviewing every report
}

enum DamageReportStatus {
  REPORTED // customer submitted, pending agent action
  SOFT_APPROVED // acknowledged only — never hits the vehicle record
  HARD_APPROVED // on the vehicle's damage history until repaired
  FIXED // repaired (photo on file); off the diagram, kept in history
}

model CustomerInspection {
  id        String  @id @default(cuid())
  tenantId  String?
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Denormalized like VehicleMileageEntry so the queue reads cleanly even if
  // the reservation is archived. IDs kept for joins.
  reservationId     String?
  rentalAgreementId String?
  reservationNumber String?

  phase   InspectionPhase
  status  CustomerInspectionStatus @default(SENT)
  emailTo String?

  sentAt           DateTime  @default(now())
  sentByUserId     String?
  openedAt         DateTime?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?

  damageReports VehicleDamageReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([vehicleId])
  @@index([reservationId])
}

model VehicleDamageReport {
  id        String  @id @default(cuid())
  tenantId  String?
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  customerInspectionId String?
  customerInspection   CustomerInspection? @relation(fields: [customerInspectionId], references: [id], onDelete: SetNull)

  // Maintenance Module: the RepairOrder this damage was rolled into (FIXED on RO complete).
  repairOrderId String?
  repairOrder   RepairOrder? @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)

  reservationId     String?
  reservationNumber String?

  // Report Damage flow (Feature 3, 2026-07-10) — a reservation-launched damage
  // that stitches this permanent vehicle record to a contract charge + an
  // incident-report DRAFT. All additive/nullable: plain vehicle-profile manual
  // damages and customer-inspection reports leave every column NULL.
  reservationChargeId String? // the RentalAgreementCharge (source DAMAGE_CHARGE) put on the contract
  incidentId          String? // the ReservationIncident DRAFT auto-created for this damage
  estimatePhotoJson   Json? // uploaded repair estimate (same {storage,refs}|{photos} shape as photoJson)
  damageCostCents     Int? // full repair cost (CUSTOMER / CUSTOMER_INSURANCE)
  ourDeductibleCents  Int? // our deductible (OUR_INSURANCE) — the amount billed to the renter
  responsibleParty    String? // CUSTOMER | CUSTOMER_INSURANCE | OUR_INSURANCE

  phase InspectionPhase
  view  VehicleView
  // Dot position as percentages of the diagram canvas (view-relative).
  xPct  Decimal         @db.Decimal(5, 2)
  yPct  Decimal         @db.Decimal(5, 2)

  description String?
  // { storage: true, bucket, refs } | { storage: false, photos } — same shape
  // as InventoryItem.photosJson so the read path is shared.
  photoJson   Json?

  status DamageReportStatus @default(REPORTED)
  source String             @default("CUSTOMER")

  // Customer damage acknowledgement (2026-07-25, LAX meeting item #3).
  // OPTIONAL in-person signature captured in the Report Damage wizard when
  // the customer is present and accepts responsibility. StatementText is a
  // SNAPSHOT of the exact wording signed (canonical or the branch's
  // termsSectionsJson override) — later wording edits never rewrite what
  // someone already signed. The incident-report PDF reads these at assemble
  // time via incidentId (this row is the durable anchor; the incident step
  // is best-effort). All nullable: unsigned reports leave every column NULL.
  customerAckSignatureDataUrl String?   @db.Text
  customerAckSignerName       String?
  customerAckSignedAt         DateTime?
  customerAckIp               String?
  customerAckStatementText    String?   @db.Text

  reviewedByUserId String?
  reviewedAt       DateTime?
  fixedByUserId    String?
  fixedAt          DateTime?
  fixedPhotoJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, status])
  @@index([customerInspectionId])
  @@index([tenantId, status])
  // Print-time acknowledgement lookup (incident PDF §9) queries by incidentId.
  @@index([incidentId])
}

model HandoffToken {
  id              String           @id @default(cuid())
  reservationId   String
  reservation     Reservation      @relation(fields: [reservationId], references: [id])
  kind            HandoffTokenKind
  token           String           @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime         @default(now())

  @@index([token, expiresAt])
  @@index([reservationId, kind])
}

// Per-section initial captured during the customer's T&C signing flow.
// Each T&C section (rental period, insurance, liability, etc.) gets its
// own initial pad. The final consolidated signature lives on
// RentalAgreement.tcSignatureDataUrl. The PDF generator embeds each
// initial inline next to its section heading.
model AgreementSectionInitial {
  id             String          @id @default(cuid())
  agreementId    String
  agreement      RentalAgreement @relation(fields: [agreementId], references: [id])
  sectionKey     String // 'rental_period', 'insurance', 'liability', 'declined_insurance', etc.
  sectionLabel   String
  initialDataUrl String          @db.Text
  signedAt       DateTime
  customerIp     String?

  @@unique([agreementId, sectionKey])
  @@index([agreementId])
}

// Damage / concern annotation placed on a specific inspection photo.
// Customer points to a scratch, agent taps the photo at that location,
// types a note. (x, y) are normalized 0-1 relative to the photo's
// rendered size so the pin shows correctly on any device.
model VehicleInspectionAnnotation {
  id           String                    @id @default(cuid())
  inspectionId String
  inspection   RentalAgreementInspection @relation(fields: [inspectionId], references: [id])
  photoUrl     String
  x            Float
  y            Float
  note         String                    @db.Text
  createdAt    DateTime                  @default(now())

  @@index([inspectionId])
}

// =====================================================================
// Loaner Program reimagining (2026-05-31). Dedicated agreement entity
// for the dealership service-loaner flow, mirroring RentalAgreement so
// the in-bay wizard produces a signed, photo-backed legal packet.
// Reservation (workflowMode = DEALERSHIP_LOANER) stays the lifecycle
// anchor; LoanerAgreement holds the signature, capture baseline,
// customer/license/insurance snapshot, photos, and damage map.
// Plan: doc/loaner-reimagining-plan-2026-05-31.md
// =====================================================================

enum LoanerAgreementStatus {
  DRAFT
  ACTIVE // signed, keys out
  RETURNED // checked back in, pending close
  CLOSED // billing settled / closed out
  VOID
}

enum LoanerPhotoKind {
  WALKAROUND_OUT
  WALKAROUND_IN
  DAMAGE
  FUEL_OUT
  FUEL_IN
  ODOMETER_OUT
  ODOMETER_IN
  LICENSE
  INSURANCE
}

enum LoanerDamageSeverity {
  MINOR
  MODERATE
  SEVERE
}

model LoanerAgreement {
  id              String                @id @default(cuid())
  tenantId        String?
  tenant          Tenant?               @relation(fields: [tenantId], references: [id])
  agreementNumber String                @unique
  status          LoanerAgreementStatus @default(DRAFT)

  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  pickupAt DateTime
  returnAt DateTime

  // Customer + license snapshot. DL PDF417 barcode decode (AAMVA) pre-fills
  // these in-bay; staff confirms rather than transcribes. licenseImagePath
  // is a Supabase Storage path (back-of-license scan).
  customerFirstName String
  customerLastName  String
  customerEmail     String?
  customerPhone     String?
  dateOfBirth       DateTime?
  licenseNumber     String?
  licenseState      String?
  licenseExpiry     DateTime?
  licenseImagePath  String?

  // Insurance capture (cloud OCR pre-fill, Phase 2). insuranceImagePath is a
  // Supabase Storage path (front/back of insurance card).
  insuranceCarrier      String?
  insurancePolicyNumber String?
  insuranceEffective    DateTime?
  insuranceExpiry       DateTime?
  insuranceImagePath    String?

  // Fuel + odometer baseline (out) and return (in). fuel as a 0.00-1.00
  // fraction to match RentalAgreement.fuelOut/fuelIn semantics.
  fuelOut     Decimal? @db.Decimal(4, 2)
  fuelIn      Decimal? @db.Decimal(4, 2)
  odometerOut Int?
  odometerIn  Int?

  // E-signature (canvas data URL). Mirrors the rental T&C signature pattern.
  signatureDataUrl String?   @db.Text
  signerName       String?
  signedAt         DateTime?
  signerIp         String?
  termsVersion     String?

  // Public/remote signing token. Reuses the addendum-signature public-token
  // flow: generated at agreement creation, embedded in the texted/emailed
  // signing link, consumed (set null) after a successful signature.
  signatureToken          String?   @unique
  signatureTokenExpiresAt DateTime?

  // Customer self-service portal. Unlike signatureToken (single-use), this
  // token is long-lived (valid while the loaner is out) so the borrower can
  // re-open their status page, request an extension, or schedule a return.
  portalToken            String?   @unique
  portalTokenExpiresAt   DateTime?
  // Customer-initiated requests captured via the portal (staff acts on them).
  requestedReturnAt      DateTime?
  returnScheduledAt      DateTime?
  portalRequestNote      String?
  portalRequestAt        DateTime?
  portalRequestKind      String?
  portalRequestHandledAt DateTime?

  notes          String?
  finalizedAt    DateTime?
  closedAt       DateTime?
  closedByUserId String?
  locked         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       LoanerPhoto[]
  damagePoints LoanerDamagePoint[]

  @@index([tenantId, status])
  @@index([vehicleId, createdAt])
}

model LoanerPhoto {
  id                String          @id @default(cuid())
  loanerAgreementId String
  loanerAgreement   LoanerAgreement @relation(fields: [loanerAgreementId], references: [id], onDelete: Cascade)
  tenantId          String?

  kind          LoanerPhotoKind
  angleLabel    String? // "Front", "Driver side", etc. for walkaround sets
  storagePath   String // Supabase Storage object path
  contentType   String?
  sizeBytes     Int?
  annotation    String?
  takenAt       DateTime        @default(now())
  takenByUserId String?

  createdAt DateTime @default(now())

  damagePoints LoanerDamagePoint[]

  @@index([loanerAgreementId, kind])
}

model LoanerDamagePoint {
  id                String          @id @default(cuid())
  loanerAgreementId String
  loanerAgreement   LoanerAgreement @relation(fields: [loanerAgreementId], references: [id], onDelete: Cascade)
  tenantId          String?

  // Normalized coordinates on the car diagram (0.0-1.0).
  x        Float
  y        Float
  side     String? // FRONT / REAR / LEFT / RIGHT / TOP
  severity LoanerDamageSeverity @default(MINOR)
  note     String?

  // true = documented at check-out (pre-existing), false = new at return.
  preExisting Boolean @default(true)

  photoId String?
  photo   LoanerPhoto? @relation(fields: [photoId], references: [id])

  createdAt       DateTime @default(now())
  createdByUserId String?

  @@index([loanerAgreementId])
}

// =====================================================================
// Long-Term (Monthly) Reservations — P1 (2026-06-03).
// A LongTermPlan attaches to a Reservation when the agent EXPLICITLY
// selects the Monthly rate type at creation (rate read from
// RateItem.monthly and LOCKED into cycleRate — renewals never float
// with the daily calendar, and daily reservations NEVER auto-convert
// at 28+ days). Each billing period is a BillingCycle row backed by a
// MONTHLY_CYCLE charge on the agreement, so the existing ledger,
// receipts, and PDFs work unchanged.
// Plan: doc/long-term-reservations-plan-2026-06-03.md
// =====================================================================

enum BillingCycleStatus {
  DUE
  PAID
  FAILED
  WAIVED
}

model LongTermPlan {
  id                    String      @id @default(cuid())
  tenantId              String?
  tenant                Tenant?     @relation(fields: [tenantId], references: [id])
  reservationId         String      @unique
  reservation           Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  rateId                String?
  cycleLengthDays       Int         @default(30)
  cycleRate             Decimal     @db.Decimal(10, 2)
  includedMilesPerCycle Int?        @default(3000)
  overagePerMile        Decimal?    @default(0) @db.Decimal(10, 2)
  milesRollOver         Boolean     @default(false)
  autoRenew             Boolean     @default(true)
  swapsPerCycle         Int         @default(1)
  nextCycleStartsAt     DateTime
  status                String      @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  endedAt               DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  billingCycles BillingCycle[]

  @@index([tenantId, status])
  @@index([status, nextCycleStartsAt])
}

model BillingCycle {
  id             String             @id @default(cuid())
  longTermPlanId String
  longTermPlan   LongTermPlan       @relation(fields: [longTermPlanId], references: [id], onDelete: Cascade)
  cycleNumber    Int
  periodStart    DateTime
  periodEnd      DateTime
  amount         Decimal            @db.Decimal(10, 2)
  milesStart     Int?
  milesEnd       Int?
  overageMiles   Int                @default(0)
  status         BillingCycleStatus @default(DUE)
  chargeId       String?
  paymentId      String?
  attempts       Int                @default(0)
  lastError      String?
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([longTermPlanId, cycleNumber])
  @@index([status, periodEnd])
}

// =====================================================================
// Ride Kiosk — Fase B1 (2026-07-05). Spec: doc/kiosk-e2e-spec-2026-07-04.md
// KioskDevice = a paired lobby tablet (rotatable device token, hash-only at
// rest; plaintext shown once at pair/rotate). KioskSession = one customer
// interaction — funnel TELEMETRY only, business state always lives on the
// checkout-session. UpsellRule = per-channel offer config (consumed by B2).
// =====================================================================

enum KioskDeviceStatus {
  ACTIVE
  REVOKED
}

enum KioskSessionKind {
  PICKUP
  WALKUP
}

enum KioskSessionOutcome {
  IN_PROGRESS
  COMPLETED
  ESCALATED
  ABANDONED
}

model KioskDevice {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  name       String

  // SHA-256 hex of the device token (crypto.randomBytes(32) base64url).
  // Constant-time compare in requireKioskDevice; never store plaintext.
  tokenHash    String @unique
  tokenVersion Int    @default(1) // bumped on rotate (service-account tokenVersion semantics)

  // 6-digit pairing code — hashed, single-use, 10-min TTL, brute-force lockout.
  pairingCodeHash      String?
  pairingCodeExpiresAt DateTime?
  pairingAttempts      Int       @default(0)

  // Reservation-lookup brute-force lockout — PER DEVICE, not per session
  // (kiosks mint a fresh session after every idle-wipe, so a session-level
  // counter would allow unlimited enumeration). 5 misses → locked 15 min;
  // a successful lookup or an admin pairing-code reissue resets it.
  lookupMisses      Int       @default(0)
  lookupLockedUntil DateTime?

  status    KioskDeviceStatus @default(ACTIVE)
  revokedAt DateTime?
  rotatedAt DateTime?

  walkupEnabled Boolean   @default(true)
  lastSeenAt    DateTime?
  appVersion    String?
  createdAt     DateTime  @default(now())

  sessions KioskSession[]

  @@index([tenantId, locationId])
}

model KioskSession {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  deviceId String
  device   KioskDevice @relation(fields: [deviceId], references: [id])

  kind KioskSessionKind

  reservationId     String?
  reservation       Reservation? @relation(fields: [reservationId], references: [id])
  checkoutSessionId String?

  // Funnel step (WELCOME/LOOKUP/ID/UPSELL/PAYMENT/SIGN/DONE) — telemetry
  // ONLY. Resume derives truth from the checkout-session, never from step.
  step            String              @default("WELCOME")
  outcome         KioskSessionOutcome @default(IN_PROGRESS)
  escalatedReason String?

  // Funnel events: [{at, step, event, data}] — offers shown/accepted/
  // declined, scan attempts, lookup misses. Capped server-side (~500).
  eventsJson Json

  // Server-recorded ID verification stamp (B3a review M2). /sign gates on
  // THIS column — eventsJson is client-fed telemetry and must never be
  // consulted for authorization. Cleared when a different reservation is
  // attached to the session.
  idVerifiedAt   DateTime?
  // How the ID was verified: 'SCAN' (guest AAMVA scan) | 'STAFF_OVERRIDE'
  // (B3c staff assist — manual entry after PIN unlock).
  idVerifyMethod String?

  // B3c Staff Assist: short-lived grant bound to THIS session. assistUserId
  // persists as the audit trail of who assisted; assistGrantedAt is the live
  // grant window (10 min TTL, consumed on staff verify, cleared on complete).
  assistUserId    String?
  assistGrantedAt DateTime?

  // B3e name-mismatch: server-recorded marker that the LAST verify failed on
  // NAME_MISMATCH alone (rules passed) — gates the self-service name-update
  // code send. The 6-digit possession code is hashed at rest, 10-min TTL,
  // single-use.
  nameMismatchAt          DateTime?
  nameUpdateCodeHash      String?
  nameUpdateCodeExpiresAt DateTime?

  // B5 Phase 1 — ONE payment intent per kiosk session. paymentIntentRef is the
  // transactionReferenceId minted once and REUSED by every payment-link retry
  // (two live intents = two genuine charges the reference dedupe is
  // structurally blind to). Survives the session wipe so a late payment can be
  // resolved back to its reservation (design §6A).
  //
  // @unique is a MONEY-PATH guarantee, not a nicety (review M1): the inbound
  // late-payment lookup resolves a gateway reference to a reservation. Without
  // DB-enforced uniqueness a mint collision would not fail loudly — it would
  // bind a real payment to the WRONG reservation. Postgres permits many NULLs
  // under a unique index, so unpaid sessions are unaffected.
  paymentIntentRef       String?   @unique
  paymentIntentState     String? // PENDING | SUPERSEDED | PAID | TERMINAL
  paymentIntentCreatedAt DateTime?
  // Refs replaced by a supersede. RETAINED on purpose (review M4): there is no
  // documented way to cancel an unpaid iPOS payment link, so a superseded link
  // may STILL be payable by a guest holding the old QR. Keeping the old refs
  // resolvable is what turns that late payment into a detected, queued item
  // instead of an orphan nobody can trace back to a reservation.
  paymentIntentPriorRefs String[]

  // Bumped by the events endpoint — clean staleness signal for the B5
  // orphaned-money / abandoned-session sweep.
  lastActivityAt DateTime  @default(now())
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  @@index([tenantId, deviceId, startedAt])
  @@index([tenantId, outcome, lastActivityAt])
  @@index([reservationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// B5 Phase 1 — PaymentOpsFlag: the CONCRETE staff queue (QA M4/M18). Every
// money path that cannot finish on its own lands here instead of failing
// silently: a stranded deposit hold the nightly sweep can no longer pretend to
// have released, an orphan payment that arrived after the kiosk session was
// wiped, a rollback/card-on-file persist that failed.
//
// The three states are deliberately distinct — "we never called the gateway"
// and "we called it and it failed" are different operational problems:
//   NOT_ATTEMPTED  — needs a human/gateway action, nothing tried yet
//   GATEWAY_FAILED — a gateway call was made and failed (lastError set)
//   RESOLVED       — actioned (manually or by a future sweep)
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentOpsKind {
  STRANDED_DEPOSIT_HOLD // hold still live on the card, needs a real void
  ORPHAN_PAYMENT // payment with no live kiosk session (late-payment, §6A)
  ROLLBACK_FAILED // a compensating void/refund itself failed
  CARD_ON_FILE_FAILED // money moved but the token never persisted
  NAME_MISMATCH_REVIEW // card name vs license — money already captured
}

enum PaymentOpsStatus {
  NOT_ATTEMPTED
  GATEWAY_FAILED
  RESOLVED
}

model PaymentOpsFlag {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  kind   PaymentOpsKind
  status PaymentOpsStatus @default(NOT_ATTEMPTED)

  // Context — every field optional so any money path can raise a flag.
  reservationId     String?
  rentalAgreementId String?
  kioskSessionId    String?
  // The payment reference (IPOS:<ref> / AUTHNET:<id>) or the gateway handle
  // (RRN / depositHoldId) the action must target.
  reference         String?
  gatewayRef        String?
  amount            Decimal? @db.Decimal(10, 2)

  note      String?
  lastError String?
  attempts  Int     @default(0)

  raisedAt         DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, raisedAt])
  @@index([tenantId, kind, status])
  @@index([reservationId])
  @@index([reference])
}

// Per-channel/broker upsell rules (v1 approximation: prepaid is per-channel;
// per-reservation flag hook comes later). Referenced by AdditionalService
// IDs, never codes (code is nullable/non-unique).
model UpsellRule {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Normalized from Reservation.bookingChannel; '*' = tenant default.
  channel String

  prepaidServiceIds String[] // broker already charged these — NEVER offer
  offerServiceIds   String[] // offer order, validated against the tenant catalog on save

  strategy String // 'PACKAGES_3' | 'UPGRADE_FIRST'
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, channel])
}

// ============================================================================
// Quotes module (2026-07-17) — native price quotes, Hector-approved plan:
// doc/quotes-module-plan-2026-07-17.md
//
// A Quote is a SAVED, SPEAKABLE price estimate (Q-1042) computed by the SAME
// engine the public site uses (bookingEngineService.searchRental → includes
// revenue pricing). It never moves money, never holds inventory. Converting to
// a reservation is an explicit call (quotes.service.convert) that re-checks
// availability and honors the quoted price within the TTL.
//
// SELF-CONTAINED ON PURPOSE: tenantId/customerId/location/vehicleType ids are
// plain strings (no @relation) so this model adds ZERO lines to Tenant/Customer
// — several concurrent workstreams edit those blocks and a quotes ship must
// never drag their halves along (the beta.315 lesson). Reads that need names
// fetch them separately.
//
// REPORTING GUARDRAIL (beta.296 lesson): Quote rows are INTENT, not revenue.
// They must never feed collected-payments, sales/taxes/commission reports, or
// projectedRevenue.
// ============================================================================

enum QuoteStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

model Quote {
  id          String @id @default(cuid())
  // Voice-friendly sequential-ish number ("Q-1042"), unique PER TENANT
  // (quote-number.js: 1000 + count, retry on race).
  quoteNumber String
  tenantId    String

  // Who asked (customer optional — callers may not be customers yet)
  customerId   String?
  contactName  String?
  contactPhone String?
  contactEmail String?

  // What was quoted
  pickupLocationId String
  returnLocationId String?
  vehicleTypeId    String
  pickupAt         DateTime
  returnAt         DateTime

  // Price SNAPSHOT copied from the engine at creation — never recomputed on
  // read. The agent must see the price the caller was told; expiresAt is what
  // protects the business from stale rates.
  days                  Int
  dailyRate             Decimal @db.Decimal(10, 2)
  subtotal              Decimal @db.Decimal(10, 2)
  fees                  Decimal @db.Decimal(10, 2)
  taxes                 Decimal @db.Decimal(10, 2)
  total                 Decimal @db.Decimal(10, 2)
  currency              String  @default("USD")
  pricingSource         String?
  revenuePricingApplied Boolean @default(false)
  engineSnapshotJson    String?

  status                 QuoteStatus @default(ACTIVE)
  expiresAt              DateTime
  convertedReservationId String?

  // Staff-edited add-ons (2026-08-06): additional services + insurance chosen
  // AFTER the quote was spoken. JSON { baseline: {subtotal,fees,taxes,total},
  // items: [{kind,code,name,quantity,rate,total,taxable}], updatedAt,
  // updatedByUserId }. The baseline is the ORIGINAL engine snapshot totals so
  // re-edits always recompute from the price the caller was told, never from a
  // previous edit. Null = never edited — byte-identical to the VozIA shape.
  addOnsJson String? @db.Text

  // Provenance
  source          String  @default("STAFF") // STAFF | VOZIA | PORTAL
  createdByUserId String?
  author          String? // "USR-2 Hector (via VozIA)"
  ticketId        String? // VozIA ticket/action reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}
