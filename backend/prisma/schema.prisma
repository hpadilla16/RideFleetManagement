// ── Maintenance Module (2026-06-19, plan doc/maintenance-module-plan-2026-06-18.md) ──
// RepairOrder is the central fleet-care record: reparaciones (estilo TSD), damages rolled
// up from inspections, incidents, and scheduled/interval maintenance — divided by location.
// Replaces MaintenanceJob (rows migrated later). Numbered PER UNIT (roNumber per vehicle).
// Money rule: costs are an INTERNAL record only; no auto-charge to agreements/claims.
model RepairOrder {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  // Per-unit sequence (RO-0001 for that vehicle), assigned at create time.
  roNumber  Int

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  status RepairOrderStatus @default(OPEN)
  source RepairOrderSource @default(MANUAL)

  odometerAtOpen  Int?
  openedAt        DateTime  @default(now())
  completedAt     DateTime?
  enteredByUserId String?

  vendor   String? // shop / mechanic
  poNumber String?
  notes    String?

  // Optional incident that spawned this RO.
  incidentId String?
  incident   ReservationIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  lines        RepairOrderLine[]
  damageReports VehicleDamageReport[] // damages grouped into this RO; FIXED on complete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, roNumber])
  @@index([tenantId, status])
  @@index([locationId, status])
  @@index([vehicleId])
}

model RepairOrderLine {
  id            String              @id @default(cuid())
