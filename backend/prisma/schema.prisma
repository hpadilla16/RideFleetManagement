  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citationId      String
  citation        Citation            @relation(fields: [citationId], references: [id], onDelete: Cascade)
  reservationId   String
  reservation     Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  status          CitationMatchStatus
  confidence      Decimal?            @db.Decimal(5, 2)
  matchedByUserId String?
  matchedByUser   User?               @relation("CitationAssignmentMatchedByUser", fields: [matchedByUserId], references: [id])
  matchReason     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId, reservationId, status])
  @@index([citationId, status])
