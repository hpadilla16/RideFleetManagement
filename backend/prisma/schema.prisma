  insurancePlanRate     Decimal?  @db.Decimal(10, 2)

  odometerOut    Int?
  odometerIn     Int?
  fuelOut        Decimal? @db.Decimal(4, 2)
  fuelIn         Decimal? @db.Decimal(4, 2)
  cleanlinessOut Int?
  cleanlinessIn  Int?

  subtotal                  Decimal   @default(0) @db.Decimal(10, 2)
  taxes                     Decimal   @default(0) @db.Decimal(10, 2)
  fees                      Decimal   @default(0) @db.Decimal(10, 2)
  total                     Decimal   @default(0) @db.Decimal(10, 2)
  deposit                   Decimal   @default(0) @db.Decimal(10, 2)
  securityDepositAmount     Decimal   @default(0) @db.Decimal(10, 2)
  securityDepositCaptured   Boolean   @default(false)
  securityDepositCapturedAt DateTime?
  securityDepositReleasedAt DateTime?
  securityDepositReference  String?
  paidAmount                Decimal   @default(0) @db.Decimal(10, 2)
  balance                   Decimal   @default(0) @db.Decimal(10, 2)

  paymentMethod    AgreementPaymentMethod?
  paymentReference String?

  // Dejavoo Spin checkout redesign (2026-05-28). Card-on-file fields:
  // the Spin sale step captures these so subsequent CNP charges (tolls,
  // overage, damage) can run via /sale with the stored token.
  cardOnFileToken      String?
  cardOnFileBrand      String?
  // 2026-06-04 — debit-aware deposits. Best-effort 'DEBIT' | 'CREDIT'
  // derived from the SPIn/Transact response at capture time; null when
  // the gateway didn't disclose it. Drives the per-location debit
  // security-deposit uplift in runDepositHold.
  cardOnFileType       String?
  cardOnFileLast4      String?
  cardOnFileCapturedAt DateTime?

  // Security-deposit pre-auth fields. preAuth runs alongside the main
  // sale in step 3 of the new wizard. Auto-voided by the nightly job
  // after 24h on abandoned checkout sessions.
  depositHoldId        String?
  depositHoldAmount    Decimal?  @db.Decimal(10, 2)
  depositHoldExpiresAt DateTime?
  depositHoldVoidedAt  DateTime?

  // Terms & Conditions multi-section signing. tcSignatureDataUrl is the
  // final consolidated signature; per-section initials live in
  // AgreementSectionInitial. Mirrors the existing signatureDataUrl on
  // the Reservation row (which signs the wizard's pre-check-in) but is
  // the checkout-time T&C acceptance.
  tcSignatureDataUrl String?   @db.Text
  tcSignedAt         DateTime?
  tcSignerName       String?
  tcCustomerIp       String?

  // Declined-insurance flow. When true, the customer didn't take counter
  // insurance and signed an acknowledgement section in T&C. The PDF
  // emits the declined-insurance addendum page.
  declinedInsurance                 Boolean   @default(false)
  declinedInsuranceSignatureDataUrl String?   @db.Text
  declinedInsuranceSignedAt         DateTime?

  notes            String?
  finalizedAt      DateTime?
  closedAt         DateTime?
  // When the customer ACTUALLY returned the car — distinct from closedAt
  // (when staff closed the record). Late-fee math runs off this; an admin can
  // backdate it at check-in when staff recorded the return late (2026-08-10).
  returnedAt       DateTime?
  salesOwnerUserId String?
  salesOwnerUser   User?     @relation("AgreementSalesOwner", fields: [salesOwnerUserId], references: [id])
  closedByUserId   String?
  closedByUser     User?     @relation("AgreementClosedBy", fields: [closedByUserId], references: [id])
  locked           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  drivers          AgreementDriver[]
  charges          RentalAgreementCharge[]
  payments         RentalAgreementPayment[]
  inspections      RentalAgreementInspection[]
  vehicleSwaps     RentalAgreementVehicleSwap[]
  commissions      AgreementCommission[]
  addendums        RentalAgreementAddendum[]
  sectionInitials  AgreementSectionInitial[]
  checkoutSessions CheckoutSession[]

  @@index([status, pickupAt])
  @@index([tenantId, status])
  // Supports buildVehicleOperationalSignalsMap's DISTINCT ON (vehicleId)
  // ORDER BY vehicleId, createdAt DESC. Without this index, the planner
  // snapshot query timed out at 15s on production.
  @@index([vehicleId, createdAt])
}

// Rental agreement addendum (BUG-001 Option C). Post-signature date
// changes create a new addendum row instead of mutating the signed parent.
model RentalAgreementAddendum {
  id                String          @id @default(cuid())
  rentalAgreementId String
  rentalAgreement   RentalAgreement @relation(fields: [rentalAgreementId], references: [id], onDelete: Cascade)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pickupAt DateTime
  returnAt DateTime

  reason         String
  reasonCategory String? @default("admin_correction")

  initiatedBy     String?
  initiatedByRole String?

  status String @default("PENDING_SIGNATURE")

  signatureSignedBy String?
  signatureDataUrl  String?
  signatureSignedAt DateTime?
  signatureIp       String?

  // Token-based public signing flow (BUG-001 customer self-service follow-up).
  // Generated at addendum creation, embedded in the customer notification
  // email, consumed (set to null) after a successful signature submission.
  signatureToken          String?   @unique
  signatureTokenExpiresAt DateTime?

  originalCharges String?
  newCharges      String?
  chargeDelta     String?

  // Soft FK to the EXTENSION_RATE ReservationCharge that triggered this
  // addendum (NULL for manually-created date-correction addendums). Not
  // a hard FK — the addendum outlives its extension charge as a
  // historical record after deleteExtension voids it.
  extensionChargeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalAgreementId])
  @@index([tenantId, status])
  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@index([extensionChargeId])
}

