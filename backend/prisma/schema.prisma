  reservation     Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  status          CitationMatchStatus
  confidence      Decimal?            @db.Decimal(5, 2)
  matchedByUserId String?
  matchedByUser   User?               @relation("CitationAssignmentMatchedByUser", fields: [matchedByUserId], references: [id])
  matchReason     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId, reservationId, status])
  @@index([citationId, status])
}

// OCR mail intake (2026-06-15) — a scanned/emailed citation notice before it
// becomes a Citation. The worker (Fase B) extracts fields → ingestBatch.
// Scalar-only by design (FKs live in the migration, not the Prisma client) to
// keep the change minimal. Plan: doc/citations-ocr-mail-intake-plan-2026-06-15.md
model CitationDocument {
  id               String   @id @default(cuid())
  tenantId         String
  bucketPath       String // "<bucket>:<path>" in Supabase Storage
  contentType      String?
  sourceChannel    String   @default("UPLOAD") // UPLOAD | EMAIL | MAILBOX
  status           String   @default("PENDING") // PENDING | EXTRACTED | INGESTED | REVIEW | FAILED
  ocrJson          String?
  confidence       Decimal? @db.Decimal(5, 2)
  citationId       String? // set once a Citation is created from this doc
  error            String?
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, status, createdAt])
}

model Conversation {
  id                  String      @id @default(cuid())
  tenantId            String?
  tenant              Tenant?     @relation(fields: [tenantId], references: [id])
  tripId              String?
  trip                Trip?       @relation(fields: [tripId], references: [id])
  hostProfileId       String
  hostProfile         HostProfile @relation("ConversationHost", fields: [hostProfileId], references: [id])
  customerId          String
  customer            Customer    @relation(fields: [customerId], references: [id])
  subject             String?
  lastMessageAt       DateTime?
  lastMessageText     String?
  closedAt            DateTime?
  // Token-based chat room access (no login required)
  hostToken           String?     @unique
  guestToken          String?     @unique
  hostTokenExpiresAt  DateTime?
  guestTokenExpiresAt DateTime?
  // Pickup coordination
  pickupAddress       String?
  pickupLat           Decimal?    @db.Decimal(10, 7)
  pickupLng           Decimal?    @db.Decimal(10, 7)
  pickupInstructions  String?
  pickupPhotoUrl      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  messages            Message[]

  @@index([hostProfileId, lastMessageAt])
  @@index([customerId, lastMessageAt])
  @@index([tripId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String // 'GUEST' | 'HOST' | 'SYSTEM'
  senderName     String?
  body           String
  messageType    String       @default("TEXT") // TEXT | SYSTEM | PICKUP_DETAILS
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model KnowledgeArticle {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  title        String
  slug         String
  body         String   @db.Text
  category     String   @default("GENERAL")
  tags         String[]
  status       String   @default("PUBLISHED") // PUBLISHED | DRAFT | ARCHIVED
  sortOrder    Int      @default(0)
  viewCount    Int      @default(0)
  helpfulCount Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, category, status])
  @@index([tenantId, status, sortOrder])
}

model Franchise {
  id                     String        @id @default(cuid())
  tenantId               String
  tenant                 Tenant        @relation(fields: [tenantId], references: [id])
  code                   String
  name                   String
  logoUrl                String?
  address                String?
  phone                  String?
  email                  String?
  termsText              String?       @db.Text
  returnInstructionsText String?       @db.Text
  agreementHtmlTemplate  String?       @db.Text
  isDefault              Boolean       @default(false)
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  reservations           Reservation[] @relation("ReservationFranchise")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// Per-tenant, per-day rollup of the count() metrics that
// reservationsService.summary() returns. Updated by an out-of-band
// refresh path (manual today, scheduler-ready) so the dashboard
// endpoint can serve from a single-row read instead of running 5
// COUNT() queries per request.
//
// `day` is a calendar date in the tenant's local timezone (not UTC),
// stored as a DateTime at midnight for that day. The unique constraint
// on (tenantId, day) lets the refresh path use upsert.
//
// tenantId is NOT NULL on purpose. Postgres unique indexes don't treat
// NULL as equal — a (NULL, day) upsert would insert a duplicate row
// every time, causing unbounded table growth and unreliable findUnique
// reads. SUPER_ADMIN cross-tenant summary requests intentionally fall
// through to live aggregation (already cached for 30s at the route
// layer) and never write to this table.
model ReservationDailyCounter {
  id            String   @id @default(cuid())
  tenantId      String
  day           DateTime
  pickupsToday  Int      @default(0)
  returnsToday  Int      @default(0)
  checkedOut    Int      @default(0)
  feeAdvisories Int      @default(0)
  noShows       Int      @default(0)
  refreshedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, day])
  @@index([tenantId, refreshedAt])
}

// Action Board kiosk tokens.
//
// Each token authorizes one read-only kiosk display (a TV mounted in the
// store) to fetch the day's pickups + returns for ONE location. Tokens are
// long-lived by design — the TV stays plugged in, and the URL embedded in
// its bookmark is the entire auth.
//
// Tenant + Location are stored as plain string IDs (no Prisma relations) to
// keep this model self-contained and avoid back-reference churn on the two
// most-touched tables in the schema. Tenant-isolation is enforced at the
// service layer via the embedded tenantId — every call resolves the token
// then re-checks tenantId before returning data.
//
// Revoked tokens stay in the table (revokedAt set, not deleted) so the
// admin UI can show audit history and a re-issue flow doesn't lose label
// continuity.
model StoreBoardToken {
  id         String    @id @default(cuid())
  tenantId   String
  locationId String
  // Human-readable label set when the admin mints the token, e.g.
  // "Front Counter Display" or "Service Bay Monitor". Shown in the admin
  // CRUD list so they know which physical TV a token belongs to.
  label      String
  // 32-char URL-safe random string. Generated server-side. Never hashed —
  // matches the existing addendum signature-token pattern; the URL itself
  // is the credential and rotation is by mint+revoke, not by hashing.
  token      String    @unique
  // Optional pointer to the User who minted this token, for audit. Stored
  // as plain string ID (no FK) so user deletion doesn't cascade-delete the
  // token row.
  createdBy  String?
  createdAt  DateTime  @default(now())
  // Bumped on every successful kiosk fetch so admins can see "last seen 3
  // min ago" and detect a TV that lost connection.
  lastSeenAt DateTime?
  // Soft-delete. Set when admin revokes; row stays for audit. Service
  // refuses to serve data for tokens with revokedAt non-null.
  revokedAt  DateTime?

  @@index([tenantId])
  @@index([locationId])
}

// =============================================================================
// Market scraper — Rate Highway-style market intelligence pipeline.
//
// MarketScrapeProfile: per-tenant configuration that defines a scrape job —
//   target location + lookahead window + LOR + frequency + schedule + pricing
//   strategy applied to the cheapest-price results. One Rate can be the target
//   of multiple profiles (e.g. a Daily profile for the 1-14 day window and a
//   Weekly profile for the 15-30 day window, like Rate Highway uses).
//
// MarketScrapeRun: one execution of a profile. Stores aggregate metrics
//   (request counts, observations produced) and run status. The Observations
//   it produced live in MarketObservation.
//
// MarketObservation: the unit fact. One row per (run, pickupDate, sipp,
//   vendor) — i.e. for a given scrape execution and search day, this records
//   one competitor listing we saw for one car class from one vendor. Cheapest-
//   per-(profile, pickupDate, sipp) is derived on read (or by an upstream
//   aggregator before applying a strategy).
//
// Comparison vs current RateDailyPrice + the auto-apply ("correction") step
// run on top of these tables; they don't need their own persistent state
// for MVP — the import endpoint (/api/rates/:id/daily-prices/import) is the
// audit trail for what got applied.
// =============================================================================

enum MarketScrapeFrequency {
  // Run every day at scheduleHour:scheduleMinute (local to runTimezone).
  DAILY
  // Run every Monday at scheduleHour:scheduleMinute. Lower-volume use case
  // for tenants who don't want daily noise.
  WEEKLY
  // Run every `frequencyDays` days (e.g. 3 or 4). Used for the far-term
  // (days 29-60) outlook profile where daily refreshes are wasteful — prices
  // out there move slowly. Cadence is tenant-configurable per profile.
  EVERY_N_DAYS
}

enum MarketScrapeRunStatus {
  PENDING
  RUNNING
  SUCCESS
  // Some requests succeeded, some failed. Partial data still usable but
  // gaps exist for the failed (date, sipp) combinations.
  PARTIAL
  FAILED
}

enum MarketObservationStatus {
  // Found a price for this (sipp, pickupDate, vendor).
  FOUND
  // Source returned this SIPP slot but marked it sold out / closed.
  CLOSED
  // Raw category from the source couldn't be mapped to an ACRISS code. Stored
  // with rawCategory populated so we can extend the SIPP map.
  UNMAPPED
  // Scrape errored for this (date, sipp) — e.g. timeout, anti-bot block.
  ERROR
}

enum MarketPricingStrategy {
  // SuggestedPrice = cheapestCompetitor - strategyAmount.
  CHEAPEST_MINUS_AMOUNT
  // SuggestedPrice = cheapestCompetitor (no discount).
  MATCH_CHEAPEST
  // SuggestedPrice = cheapestCompetitor * (1 + strategyPct/100). For "price-up"
  // when our brand commands a premium.
  CHEAPEST_PLUS_PCT
  // SuggestedPrice = MAX(cheapestCompetitor, strategyFloor). Hard floor.
  STATIC_FLOOR
}

model MarketScrapeProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Human-readable label, must be unique per tenant. Example: "SJU 1-14 Daily"
  // or "SJU 15-30 Weekly" mirroring Rate Highway's naming convention.
  name String

  // Airport code or Location.code in the tenant's location catalog. The
  // scraper looks up the matching Location row when generating the search URL.
  locationCode String

  // Lookahead window relative to "today". A profile with windowStartDay=1,
  // windowEndDay=14 scrapes pickup dates tomorrow .. today+14. Splitting
  // near-term (1-14) vs longer-out (15-30) lets tenants apply different
  // strategies (close-in is less price-sensitive than far-out).
  windowStartDay Int
  windowEndDay   Int

  // Length of rental. 3 days is the typical leisure default; Rate Highway
  // uses 1 (Daily profile) + 7 (Weekly profile).
  lorDays Int @default(3)

  // When + how often the scheduler kicks this profile off.
  frequency      MarketScrapeFrequency @default(DAILY)
  // Cadence in days when frequency=EVERY_N_DAYS. Ignored for DAILY/WEEKLY.
  // Defaults to 1; the standard "far-term outlook" profile (days 29-60) uses 4.
  frequencyDays  Int                   @default(1)
  scheduleHour   Int                   @default(4)
  scheduleMinute Int                   @default(1)
  runTimezone    String                @default("America/Puerto_Rico")

  // JSON array of source codes the scraper should query, e.g. ["EXPEDIA"].
  // Future: ["EXPEDIA", "KAYAK", "PRICELINE"] for multi-source coverage.
  sources Json

  active Boolean @default(true)

  // Pricing strategy applied to (cheapest competitor per (date, sipp)) to
  // produce the SuggestedAmount we'd push to RateDailyPrice. Reusing the
  // same vocabulary as the standalone scraper CLI.
  strategy       MarketPricingStrategy @default(CHEAPEST_MINUS_AMOUNT)
  strategyAmount Decimal?              @db.Decimal(10, 2)
  strategyPct    Decimal?              @db.Decimal(5, 2)
  strategyFloor  Decimal?              @db.Decimal(10, 2)

  // The Rate whose RateDailyPrice rows we update with the suggestions. Null
  // until the tenant wires it up — profiles without a target run for
  // research only (XLSX output, no auto-apply).
  targetRateId String?
  targetRate   Rate?   @relation("MarketScrapeProfileTargetRate", fields: [targetRateId], references: [id])

  // When true, the Correction stage POSTs the suggestions to
  // /api/rates/:id/daily-prices/import after each successful run.
  // When false, the scrape produces an XLSX for human review only.
  autoApply Boolean @default(false)

  // Last-run tracking for the Activity Queue UI.
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastRunStatus MarketScrapeRunStatus?
  lastRunError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs         MarketScrapeRun[]
  observations MarketObservation[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@index([targetRateId])
}

// Tax-aware pricing config per (tenant, location). Lets the engine back-solve the
// BASE rate to upload from a target ALL-IN price, undoing Expedia's taxes + fees +
// brokerage. connectionType chooses the formula (see pricing-grossup.js):
//   TITANIUM: all_in = base × (1 + taxes) × (1 + brokerage)
//   AMADEUS : all_in = base × (1 + brokerage) + base × taxes
// Opt-in: a location WITHOUT a config keeps the legacy behavior (no gross-up).
model MarketPricingConfig {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationCode   String                              // "SJU", "MCO", ...
  connectionType String   @default("TITANIUM")       // TITANIUM | AMADEUS
  taxes          Json     @default("[]")             // [{ name: "PR tax", pct: 11.5 }, ...]
  brokeragePct   Decimal  @default(0) @db.Decimal(6, 3)
  floorBase      Decimal? @db.Decimal(10, 2)         // per-location floor (BASE rate); null = none
  // Utilization-based dynamic tiers (Fase 2): [{ maxPct, adjustAmount?, adjustPct? }] applied
  // ON TOP of the base margin, using projected utilization from the Availability Forecast.
  utilizationRules Json   @default("[]")
  currency       String   @default("USD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, locationCode])
  @@index([tenantId])
}

model MarketScrapeRun {
  id        String                @id @default(cuid())
  profileId String
  profile   MarketScrapeProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  status    MarketScrapeRunStatus @default(PENDING)

  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationSec Int?

  // Per-request counters so the Activity Queue can show "14 of 15 OK".
  requestsOk  Int @default(0)
  requestsErr Int @default(0)

  // Total observations produced (across all requests). Equivalent to the
  // count of MarketObservation rows for this run.
  observationsCount Int @default(0)

  // The number of (date, sipp) cells the Correction step actually wrote to
  // RateDailyPrice. 0 means the profile was research-only or auto-apply
  // produced no diff.
  pricesApplied Int @default(0)

  errorMessage String?

  observations MarketObservation[]

  @@index([profileId, startedAt])
}

model MarketObservation {
  id    String          @id @default(cuid())
  runId String
  run   MarketScrapeRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Denormalized profileId so we can query observations across runs of the
  // same profile (e.g. "show me the 30-day price history for SIPP=IFAR
  // pickup=2026-05-20 at SJU"). Always equal to run.profileId.
  profileId String
  profile   MarketScrapeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  observedAt DateTime @default(now())
  pickupDate DateTime @db.Date
  returnDate DateTime @db.Date
  lorDays    Int

  sipp        String
  // What the source actually returned before we ran it through the SIPP map.
  // Useful for debugging UNMAPPED rows ("our scraper saw 'Premium Convertible'
  // but didn't know how to map it").
  rawCategory String?
  vendor      String?

  source String @default("EXPEDIA")

  dailyPrice          Decimal? @db.Decimal(10, 2)
  totalPrice          Decimal? @db.Decimal(10, 2)
  // Total / LOR — the "real" per-day cost including fees & taxes. The daily
  // price Expedia shows prominently is pre-tax teaser; the effectiveDailyPrice
  // is what the customer actually pays per day.
  effectiveDailyPrice Decimal? @db.Decimal(10, 2)
  currency            String   @default("USD")

  status MarketObservationStatus @default(FOUND)

  @@index([profileId, pickupDate, sipp])
  @@index([runId])
  @@index([pickupDate, sipp])
}

// =============================================================================
// PRICING INTELLIGENCE — per-Rate rules + suggestion queue
// =============================================================================
//
// PricingRule lives on a Rate. The pricing-suggestion-engine worker runs after
// every successful MarketScrapeRun, evaluates each active rule against the
// freshest observations for the rule's Rate (matched by Rate→Location and
// Rate's SIPP class), and produces a PricingSuggestion.
//
// If rule.mode = AUTO and |delta| <= rule.autoMaxDeltaPct → suggestion is
// written AUTO_APPLIED and Rate.daily is updated in the same transaction.
// Otherwise → suggestion is PENDING and surfaced in the Suggestions Inbox
// for human approval (48h expiration default).
//
// Spec: doc/market-intelligence-plan-2026-06-05.md
//
// =============================================================================

enum PricingRuleMode {
  // Worker writes the new price directly to Rate.daily when within guardrails.
  AUTO
  // Worker writes a PENDING PricingSuggestion; user approves manually.
  SUGGEST
}

enum PricingRuleStrategy {
  // Position N-th cheapest in the observed market. targetN required.
  NTH_CHEAPEST
  // Track a single named competitor. targetVendor required.
  CHASE_VENDOR
  // Compute nothing; rule is informational. Useful when tenant wants the
  // market dashboard without auto-pricing.
  MANUAL
}

enum PricingSuggestionStatus {
  PENDING // Awaiting human review (SUGGEST mode or AUTO over delta cap).
  APPLIED // User clicked Approve; Rate.daily updated.
  AUTO_APPLIED // Worker wrote directly without human review.
  REJECTED // User clicked Reject; reason captured.
  EXPIRED // 48h elapsed without action; rule re-evaluates next cycle.
}

model PricingRule {
  id String @id @default(cuid())

  // Each Rate owns 0..1 PricingRule. Unique so we can upsert by rateId.
  rateId String @unique
  rate   Rate   @relation(fields: [rateId], references: [id], onDelete: Cascade)

  // Denormalized for cheap tenant-scoped queries.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // SIPP class this rule defends (e.g. "IFAR" = mid-size SUV). Required for
  // multi-SIPP tenants where one MarketScrapeProfile observes many SIPPs in
  // one session — the engine reads rule.sipp directly so it knows which
  // SIPP's observations to compute against. Nullable so legacy rows (pre
  // multi-SIPP) fall back to resolveSippForRate's profile-based heuristic.
  sipp String?

  mode     PricingRuleMode     @default(SUGGEST)
  strategy PricingRuleStrategy @default(NTH_CHEAPEST)

  // For NTH_CHEAPEST: 1 = cheapest, 2 = 2nd cheapest, ... up to 10.
  targetN Int?

  // For CHASE_VENDOR: vendor name to match against MarketObservation.vendor.
  // Match is case-insensitive contains (so "Hertz" matches "Hertz Local Edition").
  targetVendor String?

  // Padding applied to the computed target price. Negative = undercut.
  // Example: targetN=2 + paddingPct=-2 → "2% cheaper than the 2nd cheapest".
  paddingPct Decimal @default(0) @db.Decimal(5, 2)

  // Safety guardrails — clamped after strategy + padding.
  floorPrice   Decimal @db.Decimal(10, 2)
  ceilingPrice Decimal @db.Decimal(10, 2)

  // For AUTO mode only: if |computed delta| exceeds this %, fall through to
  // PENDING instead of auto-applying. Protects against bad scraper data.
  // Null = no cap (always auto-apply). Recommended: 15.
  autoMaxDeltaPct Decimal? @db.Decimal(5, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // userId
  updatedBy String?

  suggestions PricingSuggestion[]

  @@index([tenantId, active])
}

model PricingSuggestion {
  id String @id @default(cuid())

  ruleId String
  rule   PricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Denormalized for inbox queries without join.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  rateId   String
  rate     Rate   @relation(fields: [rateId], references: [id], onDelete: Cascade)

  // What the rate.daily was when the engine ran.
  currentPrice   Decimal @db.Decimal(10, 2)
  // What the engine would set it to.
  suggestedPrice Decimal @db.Decimal(10, 2)
  // Cached deltas so the inbox doesn't recompute.
  deltaAmount    Decimal @db.Decimal(10, 2)
  deltaPct       Decimal @db.Decimal(6, 2)

  // Structured explanation: { strategy, targetVendor, targetN, marketMin,
  // marketMedian, yourRank, observationIds: [...], guardrailsHit: ['floor'|'ceiling'|'autoMaxDelta'] }
  reason Json

  status PricingSuggestionStatus @default(PENDING)

  appliedAt      DateTime?
  appliedBy      String?
  rejectedReason String?

  // PENDING entries auto-expire after 48h so old suggestions don't pile up.
  // The expire check runs as part of the daily engine pass.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([ruleId])
  @@index([rateId, status])
  @@index([expiresAt])
}

// Path D per-tenant volume metrics for promotion criteria automation.
// Written by daily 02:00-ET snapshot job. Read by the promotion-flagger
// service that surfaces candidates in SUPER_ADMIN review queue once a tenant
// crosses 2+ thresholds for 7 consecutive days.
//
// See doc/multitenancy-hybrid-architecture.md sections 7 + 8.
model LoadObservation {
  id                     String   @id @default(cuid())
  tenantId               String
  observedAt             DateTime @default(now())
  windowStart            DateTime
  windowEnd              DateTime
  reservationsCreated    Int      @default(0)
  concurrentStaffPeak    Int      @default(0)
  cacheInvalidations     Int      @default(0)
  inspectionMediaUploads Int      @default(0)
  voiceAgentMinutes      Int      @default(0)
  tierAtObservation      String   @default("STANDARD")

  @@index([tenantId, observedAt(sort: Desc)])
}

// Pillar 2 — per-tenant/per-location fee rates for the checkin fee engine.
// Resolution order in fee-engine.service.js:
//   1. location-specific (locationId != null)
//   2. tenant-default (locationId = null)
//   3. hardcoded fallback in code (HARDCODED_RATES const)
//
// Phase A SQL creates two partial unique indexes that Prisma cannot model:
//   - one-tenant-default per (tenantId, feeType) where locationId IS NULL
//   - one-location-override per (tenantId, locationId, feeType) where locationId IS NOT NULL
// These live in the DB only — do not let `prisma db push` drift the schema
// or it will try to drop them.
//
// feeType: EXCESS_MILEAGE | FUEL_REFILL | CLEANING_LIGHT | CLEANING_MEDIUM | CLEANING_HEAVY | SMOKING
// unit:    PER_MILE | PER_GALLON | FLAT
model FeeRate {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String?
  feeType    String
  unit       String
  amount     Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, locationId])
}

// V2 — Audit history for per-tenant Fee Rate changes.
// Captures every CREATE / UPDATE / TOGGLE / DELETE against the FeeRate table
// (writes happen via fee-rate-audit.service.recordChange inside the same
// Prisma transaction as the underlying mutation; insert failures degrade to
// a logger.warn — audit is best-effort, NOT a barrier to the user flow).
//
// No FK to FeeRate so DELETEs don't cascade away the audit trail. feeRateId
// is a string ref for convenience, nullable to handle deleted rows.
model FeeRateAuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  feeRateId   String?
  feeType     String
  locationId  String?
  actorUserId String?
  actorEmail  String?
  actorRole   String?
  changeType  String // CREATE | UPDATE | DELETE | TOGGLE
  before      Json?
  after       Json?
  changedAt   DateTime @default(now())

  @@index([tenantId, changedAt])
  @@index([feeRateId])
  @@index([changedAt])
}

// PR-5 — Endpoint-level performance telemetry (PERF pillar).
// Distinct from `LoadObservation` (business volume): this table captures raw
// per-request samples (HTTP method, normalized route, status, duration, db
// time, cache hit) at a configurable sample rate (default 1%).
//
// Writes come from `backend/src/middleware/endpoint-load-sampler.js` and are
// fire-and-forget so a Prisma error never breaks the request.
//
// Daily rollup into `EndpointLoadObservationDaily` is done by
// `backend/src/jobs/endpoint-load-rollup.js` (wired to cron in PR-6).
model EndpointLoadObservation {
  id         String   @id @default(cuid())
  tenantId   String? // nullable for public/anonymous endpoints
  method     String // GET, POST, etc.
  route      String // normalized route pattern, e.g. "/api/reservations/:id"
  statusCode Int
  durationMs Int // total duration in ms
  dbTimeMs   Int? // db time if measurable
  cacheHit   Boolean? // null if endpoint doesn't use cache
  observedAt DateTime @default(now())

  @@index([tenantId, observedAt])
  @@index([route, observedAt])
  @@index([observedAt])
}

// PR-5 — Daily aggregation of EndpointLoadObservation.
// One row per (tenantId, route, day). `cacheHitRate` is null when the endpoint
// does not use the cache (i.e. all samples had cacheHit=null).
model EndpointLoadObservationDaily {
  id            String   @id @default(cuid())
  tenantId      String?
  route         String
  day           DateTime // truncated to midnight UTC
  requestCount  Int
  p50DurationMs Int
  p95DurationMs Int
  p99DurationMs Int
  errorCount    Int
  cacheHitRate  Float? // 0.0-1.0, null if not cached

  @@unique([tenantId, route, day])
  @@index([day])
}

// ============================================================================
// TL International franchise integration (round 5 — 2026-05-20)
//
// Pulls reservation pickups from the TL International back-office (Zezgo
// franchise channel hub) every 15 minutes, stages them into
// ExternalReservation, and hybrid-promotes eligible rows into Reservation.
