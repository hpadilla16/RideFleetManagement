model Location {
  shuttleRequests   ShuttleRequest[]
  id                String           @id @default(cuid())
  tenantId          String?
  tenant            Tenant?          @relation(fields: [tenantId], references: [id])
  code              String
  name              String
  address           String?
  city              String?
  state             String?
  country           String?
  taxRate           Decimal          @default(0) @db.Decimal(5, 2)
  isActive          Boolean          @default(true)
  locationConfig    String?
  // Per-branch Terms & Conditions override (2026-07-24). Mirrors
  // Tenant.termsHtml one level down; the resolver in lib/terms/index.js reads
  // location → tenant → canonical, so NULL here (the default, and every
  // existing row) changes nothing. Set it when a branch operates under terms
  // that differ from the rest of the tenant — Corpusa's LAX runs on Rightcars'
  // California agreement while Orlando/Miami/FLL do not.
  //
  // Does NOT carry its own TC_VERSION. The tenant-level override already
  // stamps the global version (lib/terms/version.js), and diverging here would
  // make `autochargeBlocked` mean something different per branch. Same
  // precedent, deliberately.
  //
  // PREFER `termsRiderHtml` BELOW for a branch that merely operates under
  // different local policies. This field REPLACES the whole agreement, so a
  // copy of the canonical text pasted here goes stale — silently — the next
  // time TC_VERSION is bumped.
  termsHtml         String?
  // Per-branch RIDER, appended to whatever the resolver produced (2026-07-24).
  // This is the right field for the ordinary case: the branch keeps inheriting
  // the canonical 24-section agreement — authorized use, the card-on-file
  // pre-authorization that is the legal basis for post-rental toll/citation/
  // damage charges, liability releases, indemnification, governing law — and
  // only ADDS what genuinely varies by location: mileage allowance, deposit
  // tiers, fuel policy, cross-border limits, the local fee schedule.
  //
  // Corpusa's LAX is the first user. Its source document (Rightcars' "Country
  // Level Rental Policies") is a POLICY SHEET, not a rental agreement — it has
  // none of the sections above — so loading it into `termsHtml` as a
  // replacement would have stripped the company's ability to bill anything
  // after the rental closed.
  termsRiderHtml    String?
  // Per-branch overrides for the acknowledgement sections the customer initials
  // (checkout-session/terms-content.js TC_SECTIONS). JSON map keyed by the
  // CANONICAL sectionKey: { "deposit_post_charges": { "body": "...", "label": "..." } }.
  //
  // Overrides text ONLY — never the key set. `sectionKey` is persisted to
  // AgreementSectionInitial, so adding or renaming keys per branch would orphan
  // initials that customers have already signed. An unknown key here is ignored.
  //
  // Exists because those sections were hardcoded: LAX's body says a $2,000
  // deposit and 150 mi/day while the initialled page bound into the SAME PDF
  // said $500, on the renter's own initials.
  termsSectionsJson String?
  // Geofence for the overdue-vehicle location check (2026-08-13). An overdue
  // rental whose GPS position falls inside ANY of the tenant's geofenced
  // locations is treated as "returned but not checked in" (staff problem, not
  // customer problem); outside all of them raises an OverdueVehicleAlert on
  // the dashboard. NULL coordinates = no geofence for this branch, and the
  // check simply skips it — it never guesses from the street address.
  latitude          Decimal?         @db.Decimal(9, 6)
  longitude         Decimal?         @db.Decimal(9, 6)
  geofenceRadiusKm  Decimal?         @db.Decimal(6, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  vehiclesHome                   Vehicle[]               @relation("VehicleHomeLocation")
  reservationsPickup             Reservation[]           @relation("ReservationPickupLocation")
  reservationsReturn             Reservation[]           @relation("ReservationReturnLocation")
  agreementsPickup               RentalAgreement[]       @relation("AgreementPickupLocation")
  agreementsReturn               RentalAgreement[]       @relation("AgreementReturnLocation")
  additionalServices             AdditionalService[]
  locationFees                   LocationFee[]
  rates                          Rate[]
  carSharingListings             HostVehicleListing[]
  hostVehicleSubmissionPreferred HostVehicleSubmission[]
  hostPickupSpotsAnchor          HostPickupSpot[]        @relation("HostPickupSpotAnchorLocation")
  carSharingSearchPlacesAnchor   CarSharingSearchPlace[] @relation("CarSharingSearchPlaceAnchorLocation")
  carSharingPickupTrips          Trip[]                  @relation("TripPickupLocation")
  carSharingReturnTrips          Trip[]                  @relation("TripReturnLocation")
  repairOrders                   RepairOrder[]
  feeRates                       FeeRate[]
  locationCodeMaps               LocationCodeMap[]
  kioskDevices                   KioskDevice[]
  documents                      LocationDocument[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model VehicleType {
  id                String        @id @default(cuid())
  tenantId          String?
  tenant            Tenant?       @relation(fields: [tenantId], references: [id])
  code              String
  name              String
  description       String?
  imageUrl          String?
  // Public Vehicle Profile (2026-06-25) — read-only specs exposed on the public booking API
  // (bootstrap + vehicle-classes). All optional/additive; generic for every tenant.
  passengers        Int? // # seats / passengers
  bags              Int? // # luggage
  doors             Int?
  transmission      Transmission? // AUTOMATIC | MANUAL
  features          String[]      @default([]) // controlled catalog codes (see vehicle-feature-catalog.js)
  // "What's included" policy (configurable per type — NOT hardcoded):
  unlimitedMileage  Boolean       @default(false)
  freeMilesPerDay   Int? // used only when unlimitedMileage = false
  insuranceIncluded Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  vehicles               Vehicle[]
  reservations           Reservation[]           @relation("ReservationVehicleType")
  serviceReservations    Reservation[]           @relation("ReservationServiceVehicleType")
  rateItems              RateItem[]
  rateDailyPrices        RateDailyPrice[]
  hostVehicleSubmissions HostVehicleSubmission[]
  vehicleClassStopSales  VehicleClassStopSale[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Vehicle {
  id                      String                 @id @default(cuid())
  tenantId                String?
  tenant                  Tenant?                @relation(fields: [tenantId], references: [id])
  internalNumber          String
  vin                     String?                @unique
  plate                   String?
  tollTagNumber           String?
  tollStickerNumber       String?
  make                    String?
  model                   String?
  year                    Int?
  color                   String?
  mileage                 Int                    @default(0)
  // Fuel tank capacity in gallons (2026-06-10, fixes backlog #51). Drives the
  // FUEL_REFILL fee: gallons = (fuelOut - fuelIn, quantized to 1/8) × capacity.
  // Nullable — resolveTankCapacity() falls back to 15 gal (+ warn) when unset.
  fuelTankCapacityGallons Decimal?               @db.Decimal(4, 1)
  // Vehicle Profile pack (2026-06-10, plan doc/vehicle-profile-pack-plan):
  // registration tracking + acquisition/value/rotation. All informational —
  // none of these feed billing. currentValue is COMPUTED (declining balance),
  // never stored. Rotation rule (TIME|MILEAGE) lives in AppSetting per tenant.
  registrationExpiresAt   DateTime?
  registrationDocumentUrl String?
  acquisitionCost         Decimal?               @db.Decimal(12, 2)
  acquisitionDate         DateTime?
  depreciationAnnualPct   Decimal?               @db.Decimal(5, 2)
  targetFleetMonths       Int?
  targetFleetMiles        Int?
  status                  VehicleStatus          @default(AVAILABLE)
  fleetMode               VehicleFleetMode       @default(RENTAL_ONLY)
  // Program partition — see VehicleProgramCategory enum docs.
  // Existing vehicles default to BOTH (no behavior change at write time);
  // tenants with a loaner program (e.g. Triangle) tag their loaner units
  // as LOANER_ONLY so the public rental search hides them. Filter rule:
  //   public rental search       → programCategory IN (RENTAL_ONLY, BOTH)
  //   dealership-loaner intake  → programCategory IN (LOANER_ONLY, BOTH)
  programCategory         VehicleProgramCategory @default(BOTH)

  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  homeLocationId String?
  homeLocation   Location? @relation("VehicleHomeLocation", fields: [homeLocationId], references: [id])

  // "Last odometer wins" provenance (2026-05-28). When the dejavoo
  // checkout redesign writes odometerOut or check-in writes odometerIn,
  // we also flip Vehicle.mileage AND stamp this column with the source
  // (e.g. "CHECKOUT_RES-742838" / "CHECKIN_RES-742838") so we can audit
  // which workflow last touched the odometer.
  lastOdometerSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations          Reservation[]
  maintenanceJobs       MaintenanceJob[]
  rentalAgreements      RentalAgreement[]
  hostListing           HostVehicleListing?
  hostVehicleSubmission HostVehicleSubmission?
  tollTransactions      TollTransaction[]
  tollAssignments       TollAssignment[]
  citations             Citation[]
  citationAssignments   CitationAssignment[]
  availabilityBlocks    VehicleAvailabilityBlock[]
  telematicsDevices     VehicleTelematicsDevice[]
  telematicsEvents      VehicleTelematicsEvent[]
  loanerAgreements      LoanerAgreement[]
  mileageEntries        VehicleMileageEntry[]
  fuelReadings          VehicleFuelReading[]
  inventoryItems        InventoryItem[]
  reconciliationFlags   FleetReconciliationFlag[]
  customerInspections   CustomerInspection[]
  damageReports         VehicleDamageReport[]
  repairOrders          RepairOrder[]
  serviceSchedules      ServiceSchedule[]

  @@unique([tenantId, plate])
  @@unique([tenantId, internalNumber])
  @@index([tenantId, status])
  @@index([tenantId, programCategory])
  // Location scoping (2026-07-24). Serves the DIRECT filters —
  // `WHERE tenantId = ? AND homeLocationId IN (...)` — in vehicles.service.js
  // (list + availability), planner's loadPlannerVehicles, and the maintenance
  // fleet counts. Verified against the emitted SQL + EXPLAIN.
  //
  // It does NOT serve the relation-hop filters (citations/tolls/schedules/
  // damage reports). Those compile to a LEFT JOIN on Vehicle.id — the primary
  // key — with homeLocationId applied to the joined row and NO Vehicle.tenantId
  // predicate, so a composite led by tenantId cannot be used. Don't add this
  // index expecting to speed those up; they ride the PK.
  @@index([tenantId, homeLocationId])
}

// Per-vehicle odometer history (2026-06-09). Every check-out, check-in, manual
// correction, and telematics ping that touches the odometer appends one row
// here. "Last entry wins": the most recent row (by recordedAt) is the value
// mirrored onto Vehicle.mileage + Vehicle.lastOdometerSource, so the vehicle
// profile can show the full timeline AND which workflow set the current number.
// Append-only by design — corrections are NEW rows (source = MANUAL), never edits.
model VehicleMileageEntry {
  id        String  @id @default(cuid())
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  mileage Int
  source  MileageEntrySource

  // Provenance — denormalized reservation number so the timeline reads cleanly
  // even after a reservation/agreement is archived. IDs kept for joins.
  reservationId     String?
  rentalAgreementId String?
  reservationNumber String?

  note        String?
  actorUserId String?

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([tenantId, vehicleId])
}

enum MileageEntrySource {
  CHECKOUT
  CHECKIN
  MANUAL
  TELEMATICS
  IMPORT
}

// Vehicle fuel + odometer history (2026-06-29). Sibling to VehicleMileageEntry:
// an append-only fuel-level timeline for each vehicle. Every workflow that
// learns a fuel reading — check-out (fuelOut), check-in (fuelIn), an admin
// correction, a manual refuel log, or an import — appends a row here via
// recordFuelReadingSafe(). fuelFraction is 0..1 (fraction of tank). Paired
// with VehicleMileageEntry by reservationId on the vehicle profile so the
// fuel/odometer history reads as one out→in row per rental.
model VehicleFuelReading {
  id        String  @id @default(cuid())
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  fuelFraction Decimal           @db.Decimal(4, 2)
  source       FuelReadingSource

  // Provenance — denormalized reservation number so the timeline reads cleanly
  // even after a reservation/agreement is archived. IDs kept for joins.
  reservationId     String?
  rentalAgreementId String?
  reservationNumber String?

  note        String?
  actorUserId String?

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([tenantId, vehicleId])
}

enum FuelReadingSource {
  CHECKOUT
  CHECKIN
  MANUAL
  CORRECTION
  REFUEL
  IMPORT
}

// Inventory Helper (2026-06-09). A guided fleet-inventory wizard: one resumable
// session per tenant snapshots the whole fleet into items, agents confirm each
// vehicle (scan + photos + checklist for at-lot, status note for maintenance),
// status mismatches are flagged, and completion produces a saved PDF report.
// See doc/inventory-helper-plan-2026-06-09.md.
model InventorySession {
  id                String                 @id @default(cuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  status            InventorySessionStatus @default(IN_PROGRESS)
  startedByUserId   String?
  startedAt         DateTime               @default(now())
  lastActivityAt    DateTime               @default(now())
  completedByUserId String?
  completedAt       DateTime?
  abandonedAt       DateTime?
  abandonedReason   String?
  // Denormalized counts (total / confirmed / exception / mismatch) so the
  // launch + progress UI can render without re-aggregating every item.
  totalsJson        Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  items  InventoryItem[]
  report InventoryReport?

  @@index([tenantId, status])
}

// One row per vehicle in a session. State is persisted as agents confirm, so
// leaving (e.g. to fix a mismatch via check-in) and returning resumes exactly.
model InventoryItem {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenantId  String?
  vehicleId String
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Snapshot at session start — what the system believed when inventory began.
  expectedStatus  VehicleStatus
  expectedMileage Int?

  state         InventoryItemState      @default(PENDING)
  locatedStatus InventoryLocatedStatus?
  confirmMethod InventoryConfirmMethod?
  confirmReason String?

  // At-lot verification checklist.
  tiresOk          Boolean?
  brakesOk         Boolean?
  lightsOk         Boolean?
  fluidsOk         Boolean?
  cleanOk          Boolean?
  mileageConfirmed Boolean?
  reportedMileage  Int?

  photosJson      Json?
  note            String?
  maintenanceNote String?

  mismatchType           InventoryMismatchType?
  mismatchResolved       Boolean                @default(false)
  mismatchResolutionNote String?

  reservationId     String?
  confirmedByUserId String?
  confirmedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, vehicleId])
  @@index([sessionId, state])
  @@index([tenantId, vehicleId])
}

// Saved PDF report (persisted artifact, unlike the on-the-fly reports module).
// Listed under Reports → Inventory reports, downloaded via a signed URL.
model InventoryReport {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  sessionId         String           @unique
  session           InventorySession @relation(fields: [sessionId], references: [id])
  title             String
  generatedByUserId String?
  generatedAt       DateTime         @default(now())
  storageBucket     String?
  storagePath       String?
  summaryJson       Json?
  createdAt         DateTime         @default(now())

  @@index([tenantId, generatedAt])
}

// Persisted record of a status mismatch that was DEFERRED ("resolved with
// note") during inventory so the agent could finish. Surfaces on the dashboard
// (Status mismatches tile) until truly fixed — auto-resolved on check-in or by
// the hourly vehicle-status drift sweep. One OPEN flag per vehicle+type
// (enforced in the service, since Prisma can't express a partial unique index).
model FleetReconciliationFlag {
  id                         String                        @id @default(cuid())
  tenantId                   String
  tenant                     Tenant                        @relation(fields: [tenantId], references: [id])
  vehicleId                  String
  vehicle                    Vehicle                       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reservationId              String?
  type                       InventoryMismatchType
  status                     ReconciliationFlagStatus      @default(OPEN)
  note                       String?
  raisedByInventorySessionId String?
  raisedByUserId             String?
  raisedAt                   DateTime                      @default(now())
  lastSeenAt                 DateTime                      @default(now())
  resolvedAt                 DateTime?
  resolvedByUserId           String?
  resolvedReason             ReconciliationResolvedReason?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  @@index([tenantId, status])
  @@index([vehicleId, status])
}

enum InventorySessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  CANCELLED
}

enum InventoryItemState {
  PENDING
  CONFIRMED
  EXCEPTION
}

enum InventoryLocatedStatus {
  AT_LOT
  IN_MAINTENANCE
  OUT_OF_SERVICE
  ON_RENT
  NOT_FOUND
}

enum InventoryConfirmMethod {
  QR
  PLATE
  VIN
  MANUAL
}

enum InventoryMismatchType {
  ON_RENT_OVERDUE
  SHOULD_BE_ON_RENT
}

enum ReconciliationFlagStatus {
  OPEN
  RESOLVED
}

enum ReconciliationResolvedReason {
  CHECKED_IN
  SWEEP
  MANUAL
}

model VehicleAvailabilityBlock {
  id            String           @id @default(cuid())
  tenantId      String?
  tenant        Tenant?          @relation(fields: [tenantId], references: [id])
  vehicleId     String
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  blockType     VehicleBlockType @default(MIGRATION_HOLD)
  blockedFrom   DateTime         @default(now())
  availableFrom DateTime
  reason        String?
  notes         String?
  sourceType    String?
  releasedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId, vehicleId, blockedFrom, availableFrom])
  @@index([vehicleId, releasedAt, availableFrom])
}

// Website-only stop-sale: hide a vehicle class from the public booking
// website for a date range without affecting backoffice/manual reservations.
// The existing VehicleAvailabilityBlock model (per-VIN, blocks ALL channels)
// is unchanged - this is a separate concept on purpose.
model VehicleClassStopSale {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  reason        String?
  notes         String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, vehicleTypeId, isActive, startDate, endDate])
  @@index([tenantId, isActive])
}

model VehicleTelematicsDevice {
  id               String    @id @default(cuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id])
  vehicleId        String
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider         String
  externalDeviceId String
  label            String?
  serialNumber     String?
  isActive         Boolean   @default(true)
  installedAt      DateTime?
  lastSeenAt       DateTime?
  metadataJson     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  events VehicleTelematicsEvent[]

  @@unique([provider, externalDeviceId])
  @@index([tenantId, vehicleId, isActive])
}

model VehicleTelematicsEvent {
  id          String                   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?                  @relation(fields: [tenantId], references: [id])
  vehicleId   String
  vehicle     Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      VehicleTelematicsDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  eventType   String                   @default("PING")
  eventAt     DateTime
  latitude    Decimal?                 @db.Decimal(9, 6)
  longitude   Decimal?                 @db.Decimal(9, 6)
  speedMph    Decimal?                 @db.Decimal(8, 2)
  heading     Int?
  odometer    Int?
  fuelPct     Decimal?                 @db.Decimal(5, 2)
  batteryPct  Decimal?                 @db.Decimal(5, 2)
  engineOn    Boolean?
  payloadJson String?
  createdAt   DateTime                 @default(now())

  @@index([tenantId, vehicleId, eventAt])
  @@index([deviceId, eventAt])
  // Perf 2026-06-05 — vehicle-intelligence latest-event lookup runs
  //   SELECT DISTINCT ON ("vehicleId") * ... WHERE "vehicleId" = ANY(...)
  //   ORDER BY "vehicleId", "eventAt" DESC
  // with NO tenant filter when called by super-admin scope, so the
  // (tenantId, vehicleId, eventAt) index can't serve it. This one can.
  @@index([vehicleId, eventAt(sort: Desc)])
}

// An overdue rental whose GPS position is OUTSIDE every geofenced location of
// its tenant (2026-08-13, Hector). Inside a geofence = the car is back on a
// lot and staff forgot the check-in — no alert, that is the backdated-checkin
// workflow's problem. Written by the voltswitch overdue sweep; one OPEN row
// per reservation (the sweep updates position in place). Resolved
// automatically when the car re-enters a geofence or the rental closes;
// DISMISSED when staff acknowledges from the dashboard.
//
// Plain String ids on purpose (no @relation): the alert is an observation,
// not part of the reservation graph, and loose ids keep the migration purely
// additive.
model OverdueVehicleAlert {
  id                String    @id @default(cuid())
  tenantId          String
  reservationId     String
  vehicleId         String?
  status            String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  latitude          Decimal?  @db.Decimal(9, 6)
  longitude         Decimal?  @db.Decimal(9, 6)
  address           String?
  distanceKm        Decimal?  @db.Decimal(8, 2)
  nearestLocationId String?
  positionAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  resolvedAt        DateTime?

  @@index([tenantId, status])
  @@index([reservationId, status])
}

// Ride University — one row per person per module (2026-08-14).
//
// The MODULES themselves are not here. They live in
// frontend/src/lib/training/curriculum.js, which the tour, the articles and
// the video scripts all render from; putting them in the database too would
// give the curriculum two homes and one of them would go stale. Only the
// PROGRESS is state, so only the progress is stored.
//
// pointsAwarded is snapshotted at completion on purpose. Re-weighting a module
// later must not silently rewrite what someone already earned — the
// denominator is computed live from the curriculum instead, which also keeps
// the manager view honest when a role's total changes.
//
// Shaped after IdempotencyKey: the same per-user keyed row this codebase
// already uses.
model TrainingProgress {
  id        String @id @default(cuid())
  tenantId  String
  userId    String
  moduleKey String

  // NOT_STARTED is simply the absence of a row.
  //   ARMED     — an opportunistic module waiting for the person to do the
  //               real work; completion is proved from domain records.
  //   COMPLETED — proved, and points awarded.
  status String @default("ARMED")

  armedAt       DateTime  @default(now())
  completedAt   DateTime?
  pointsAwarded Int       @default(0)
  // What proved it — e.g. the reservation they created. Kept so a disputed
  // completion can be traced back to the record, not just a timestamp.
  provenBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([tenantId, status])
  @@index([tenantId, userId])
}

model Customer {
  id                       String    @id @default(cuid())
  tenantId                 String?
  tenant                   Tenant?   @relation(fields: [tenantId], references: [id])
  firstName                String
  lastName                 String
  email                    String?
  phone                    String
  // VozIA gap #4 (2026-07-15) — digits-only mirror of `phone`, derived on every
  // write by the customerPhoneNormalize Prisma extension (lib/prisma.js). Lets the
  // customer search match a spoken "7875551234" against a stored "(787) 555-1234".
  phoneNormalized          String?
  licenseNumber            String?
  licenseState             String?
  dateOfBirth              DateTime?
  insurancePolicyNumber    String?
  // 2026-07-28 (LAX #5) — insurance policy expiration ("Exp Date" on the
  // pre-check-in forms). Named after LoanerAgreement.insuranceExpiry.
  insuranceExpiry          DateTime?
  insuranceDocumentUrl     String?
  address1                 String?
  address2                 String?
  city                     String?
  state                    String?
  zip                      String?
  country                  String?
  idPhotoUrl               String?
  licenseBackUrl           String?
  locale                   String?
  authnetCustomerProfileId String?
  authnetPaymentProfileId  String?
  // Pillar 2 (added 2026-05-17) — denormalized card metadata for invoice notice
  // Populated by saveAuthNetCardProfileFromReference + authNetResolveStoredCustomerProfile
  // when CIM profile is saved. Backfill script: scripts/backfill-card-metadata.mjs
  cardLast4                String?
  cardBrand                String?
  cardExpiresMonth         Int?
  cardExpiresYear          Int?
  cardUpdatedAt            DateTime?
  creditBalance            Decimal   @default(0) @db.Decimal(10, 2)
  portalResetToken         String?
  portalResetExpiresAt     DateTime?
  guestAccessToken         String?
  guestAccessExpiresAt     DateTime?
  deletionToken            String?   @unique
  deletionTokenExpiresAt   DateTime?
  doNotRent                Boolean   @default(false)
  doNotRentReason          String?
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  reservations  Reservation[]
  guestTrips    Trip[]         @relation("TripGuestCustomer")
  hostReviews   HostReview[]
  conversations Conversation[]

  @@index([tenantId])
  @@index([tenantId, lastName])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
}

model Reservation {
  shuttleRequests                 ShuttleRequest[]
  id                              String                  @id @default(cuid())
  tenantId                        String?
  tenant                          Tenant?                 @relation(fields: [tenantId], references: [id])
  reservationNumber               String                  @unique
  sourceRef                       String?                 @unique
  status                          ReservationStatus       @default(NEW)
  workflowMode                    ReservationWorkflowMode @default(RENTAL)
  loanerBillingMode               LoanerBillingMode?
  repairOrderNumber               String?
  claimNumber                     String?
  serviceAdvisorName              String?
  serviceAdvisorEmail             String?
  serviceAdvisorPhone             String?
  serviceStartAt                  DateTime?
  estimatedServiceCompletionAt    DateTime?
  serviceVehicleYear              Int?
  serviceVehicleMake              String?
  serviceVehicleModel             String?
  serviceVehiclePlate             String?
  serviceVehicleVin               String?
  loanerLiabilityAccepted         Boolean                 @default(false)
  loanerLiabilityAcceptedAt       DateTime?
  loanerProgramNotes              String?
  loanerBorrowerPacketJson        String?
  loanerBorrowerPacketCompletedAt DateTime?
  loanerBorrowerPacketCompletedBy String?
  loanerBillingContactName        String?
  loanerBillingContactEmail       String?
  loanerBillingContactPhone       String?
  loanerBillingAuthorizationRef   String?
  loanerBillingNotes              String?
  loanerReturnExceptionFlag       Boolean                 @default(false)
  loanerReturnExceptionNotes      String?
  loanerBillingStatus             LoanerBillingStatus     @default(DRAFT)
  loanerBillingSubmittedAt        DateTime?
  loanerBillingSettledAt          DateTime?
  serviceAdvisorNotes             String?
  serviceAdvisorUpdatedAt         DateTime?
  loanerServiceCompletedAt        DateTime?
  loanerServiceCompletedBy        String?
  loanerCloseoutNotes             String?
  // Public loaner self-service (2026-06-25): set when a customer picked a loaner + signed on the
  // website (POST /api/public/loaner/reserve). Flags the appointment as PENDING advisor approval.
  loanerSelfServiceSubmittedAt    DateTime?
  loanerPurchaseOrderNumber       String?
  loanerDealerInvoiceNumber       String?
  loanerAccountingNotes           String?
  loanerAccountingClosedAt        DateTime?
  loanerAccountingClosedBy        String?
  loanerLastExtendedAt            DateTime?
  loanerLastVehicleSwapAt         DateTime?

  bookingChannel String @default("STAFF")

  // 2026-07-25 (LAX #4, QA B1): WHO originated this reservation (staff create
  // route stamps req.user). Soft reference (no FK churn on User). Read at
  // agreement creation to seed salesOwnerUserId when the originator is a
  // VIRTUAL_AGENT — the attribution the commission sync pays the VA's 1% on.
  createdByUserId String?

  // Structured prepaid signal for imports whose source knows its commercial
  // model. Stamped at promotion from ExternalReservation.isPrepaid.
  //   TL International — true. The aggregator that originated the booking
  //     (Expedia, CarTrawler, Carnect, BookingGroup, Stressfree) collects
  //     before pickup.
  //   NU Car Rentals — MIXED per row: PP/OP = prepaid, blank Code = pay-at-destination.
  //   Advantage — false. Pay-on-arrival.
  //   Economy — NULL. Measured 2026-08-09: 0 of 2,366 rows prepaid, and 1,851
  //     explicitly pay-at-counter. An earlier version of this comment called
  //     Economy all-prepaid. It is not, and stamping it true on that belief
  //     would have stopped collection on those 1,851.
  //   Flexways, staff-created — NULL; the source never declares.
  //
  // NULL means "this source never told us". That is not prepaid, and it is not
  // proof of prepayment either. Read it as unknown, never as permission to charge.
  //
  // MONEY — this field is NO LONGER informational, though this comment said so
  // for as long as nothing read it. The public payment link changed that:
  // assertPayable() in public-booking/authnet-accept-hosted.js refuses a
  // reservation with isPrepaid === true. Measured 2026-08-08, while the flag was
  // NULL on all 854 TL rows: 54 future-pickup TL reservations were chargeable
  // through the public link for $13,187.01 — every one already paid to the
  // aggregator.
  isPrepaid Boolean?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  vehicleTypeId String?
  vehicleType   VehicleType? @relation("ReservationVehicleType", fields: [vehicleTypeId], references: [id])

  // Service vehicle's class (2026-06-25) = the customer's loaner ENTITLEMENT anchor. Null on
  // legacy / non-loaner rows -> entitlement falls back to the assigned loaner's own class (delta $0).
  serviceVehicleTypeId String?
  serviceVehicleType   VehicleType? @relation("ReservationServiceVehicleType", fields: [serviceVehicleTypeId], references: [id])

  pickupAt DateTime
  returnAt DateTime

  // Captured the FIRST time a reservation is extended (the very first
  // booked returnAt). Stays immutable across subsequent extensions so
  // the UI can render "Originally returned X · Now returns Y". Cleared
  // back to NULL when the only/last extension is deleted.
  originalReturnAt DateTime?

  // Overdue-tracking opt-out (2026-05-27). When true, this reservation
  // is silently excluded from the Overdue Returns dashboard KPI, the
  // /reservations?filter=overdue list, and the OVERDUE bucket of the
  // Rental Status report. The row itself is otherwise unchanged — it
  // still appears in normal status / pickup / return queries. Used to
  // grandfather in pre-2026-05-27 stale rows so the overdue count can
  // "start fresh" while the cleanup is done at human pace. Defaults to
  // false for all new reservations.
  overdueIgnored Boolean @default(false)

  // Pillar 2 (added 2026-05-17) — auto-charge state machine.
  // Set when checkin completes with balance > 0 and status transitions
  // to CHECKED_IN_UNPAID. Worker polls + charges + transitions to CHECKED_IN.
  // autochargeBlocked = TRUE for reservations signed before terms update
  // (no legal authorization to auto-charge).
  autochargeBlocked   Boolean   @default(false)
  autochargeAt        DateTime?
  autochargeAttempts  Int       @default(0)
  autochargeLastError String?

  // 2026-07-28 (LAX #8) — delayed post-check-in email. When the pickup
  // location sets checkinEmailDelayHours > 0, checkin-close stamps DueAt
  // instead of emailing inline; the checkin-email scheduler sweeps due rows
  // and sends receipt-or-invoice based on the balance AT SEND TIME. SentAt is
  // the exactly-once marker (the autocharge worker also stamps it when its
  // own success receipt makes the delayed email redundant).
  checkinEmailDueAt  DateTime?
  checkinEmailSentAt DateTime?

  pickupLocationId String
  pickupLocation   Location @relation("ReservationPickupLocation", fields: [pickupLocationId], references: [id])

  returnLocationId String
  returnLocation   Location @relation("ReservationReturnLocation", fields: [returnLocationId], references: [id])

  franchiseId String?
  franchise   Franchise? @relation("ReservationFranchise", fields: [franchiseId], references: [id])

  dailyRate      Decimal?      @db.Decimal(10, 2)
  estimatedTotal Decimal?      @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING)

  sendConfirmationEmail        Boolean   @default(true)
  // Durable marker that a customer confirmation email was sent for this
  // reservation (reservations.create consumes the sendConfirmationEmail flag).
  // NULL = not yet sent. Guarantees exactly-once send + observability.
  confirmationEmailSentAt      DateTime?
  // VozIA Cap 6 / W1 (2026-07-19) — caller-editable non-money fields, written via
  // the service-account PATCH whitelist (vozia-reservation-patch.js). flightNumber
  // finally readable at reservation level (before it only existed on
  // ExternalReservation); pickupInstructions is PER-RESERVATION (distinct from the
  // location-level pickupInstructions in locationConfig).
  flightNumber                 String?
  pickupInstructions           String?
  notes                        String?
  // 2026-07-28 (LAX #12) — stamped by the service ONLY when the notes text
  // actually changes (the automatic [UNDERAGE ALERT] re-splice on every PATCH
  // is ignored). Drives the "new note" banner on the detail page, the list
  // pill, and the wizards' step-1 note boxes. WHO edited comes from AuditLog.
  notesUpdatedAt               DateTime?
  customerInfoToken            String?
  customerInfoTokenExpiresAt   DateTime?
  customerInfoCompletedAt      DateTime?
  precheckinAutoInviteSentAt   DateTime?
  precheckinAutoReminderSentAt DateTime?
  customerInfoReviewedAt       DateTime?
  customerInfoReviewedByUserId String?
  customerInfoReviewedByUser   User?     @relation("ReservationCustomerInfoReviewedBy", fields: [customerInfoReviewedByUserId], references: [id])
  customerInfoReviewNote       String?
  readyForPickupAt             DateTime?
  readyForPickupByUserId       String?
  readyForPickupByUser         User?     @relation("ReservationReadyForPickupBy", fields: [readyForPickupByUserId], references: [id])
  readyForPickupOverrideNote   String?
  signatureToken               String?
  signatureTokenExpiresAt      DateTime?
  paymentRequestToken          String?
  paymentRequestTokenExpiresAt DateTime?
  signatureSignedAt            DateTime?
  signatureSignedBy            String?
  signatureDataUrl             String?

  // 16g — canonical T&C version accepted by the customer at signature
  // submission time. Lexicographic comparison against TC_VERSION from
  // src/lib/terms/version.js determines whether a reservation may be
  // auto-charged after the new card-on-file authorization landed.
  // NULL on reservations created before the field was added; those rows
  // are the 281 unblocked en masse by scripts/unblock-pre-terms-reservations.mjs.
  termsVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices            Invoice[]
  auditLogs           AuditLog[]
  rentalAgreement     RentalAgreement?
  pricingSnapshot     ReservationPricingSnapshot?
  charges             ReservationCharge[]
  payments            ReservationPayment[]
  additionalDrivers   ReservationAdditionalDriver[]
  carSharingTrip      Trip?
  incidents           TripIncident[]
  damageIncidents     ReservationIncident[]
  hostReviews         HostReview[]
  tollTransactions    TollTransaction[]
  tollAssignments     TollAssignment[]
  citations           Citation[]
  citationAssignments CitationAssignment[]

  // Dejavoo Spin checkout redesign (2026-05-28)
  checkoutSessions CheckoutSession[]
  handoffTokens    HandoffToken[]

  // Ride Kiosk Fase B1 (2026-07-05)
  kioskSessions KioskSession[]

  // TL International franchise integration (round 5)
  externalReservation ExternalReservation? @relation("ReservationFromExternal")
  loanerAgreement     LoanerAgreement?
  longTermPlan        LongTermPlan?

  @@index([status, pickupAt])
  @@index([workflowMode, status, pickupAt])
  @@index([pickupLocationId, pickupAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, pickupAt])
  @@index([repairOrderNumber])
  @@index([customerId])
  @@index([returnAt])
  @@index([tenantId, status, returnAt])
  @@index([vehicleId])
  // Speeds up `/summary`'s nextNoShow findFirst:
  // `WHERE tenantId, status='NO_SHOW' ORDER BY updatedAt DESC LIMIT 1`.
  // Without this, Postgres filters via [tenantId, status, pickupAt] and
  // then has to sort by updatedAt — getting slower as table grows.
  @@index([tenantId, status, updatedAt(sort: Desc)])
  // 2026-07-28 (LAX #8) — the checkin-email sweep filters
  // `checkinEmailDueAt <= now AND checkinEmailSentAt IS NULL`.
  @@index([checkinEmailDueAt])
  // Perf 2026-06-05 — date-window overlap queries (availability-forecast,
  // planner snapshot, booking engine) all filter
  //   `tenantId = ? AND pickupAt < end AND returnAt > start`
  // with NO status predicate (planner) or a multi-status IN (forecast).
  // None of the existing indexes lead with (tenantId, returnAt), so Postgres
  // fell back to scanning [tenantId, createdAt] / seq scans. returnAt > start
  // is the selective condition for forward-looking windows (it excludes all
  // historical, already-returned rows); pickupAt rides along for an
  // index-level filter.
  @@index([tenantId, returnAt, pickupAt])
}

