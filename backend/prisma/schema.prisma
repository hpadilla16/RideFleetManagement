model Citation {
  id                String                 @id @default(cuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceAccountId   String?
  sourceAccount     CitationSourceAccount? @relation(fields: [sourceAccountId], references: [id])
  importRunId       String?
  importRun         CitationImportRun?     @relation(fields: [importRunId], references: [id])
  source            CitationSource
  citationNo        String
  agency            String
  violationType     String?
  plateRaw          String?
  plateNormalized   String?
  plateState        String?
  // Optional (2026-06-14): some sources (e.g. CPC list view) expose the citation
  // without a date — those bind to the VEHICLE by plate (NEEDS_REVIEW) and the
  // date is enriched later (detail fetch). Reservation matching needs issuedAt;
  // when null it simply stays vehicle-only.
  issuedAt          DateTime?
  amount            Decimal                @db.Decimal(10, 2)
  fee               Decimal                @default(0) @db.Decimal(10, 2)
  dueAt             DateTime?
  location          String?
  externalUrl       String?
  documentPath      String?
  vehicleId         String?
  vehicle           Vehicle?               @relation(fields: [vehicleId], references: [id])
  reservationId     String?
  reservation       Reservation?           @relation(fields: [reservationId], references: [id])
  status            CitationStatus         @default(IMPORTED)
  billingStatus     CitationBillingStatus  @default(PENDING)
  matchConfidence   Decimal?               @db.Decimal(5, 2)
  needsReview       Boolean                @default(false)
  sourcePayloadJson String?
  reviewNotes       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  assignments CitationAssignment[]

  @@unique([tenantId, source, citationNo])
  @@index([tenantId, plateNormalized, plateState, issuedAt])
  @@index([tenantId, status, issuedAt])
  @@index([tenantId, vehicleId, issuedAt])
}

