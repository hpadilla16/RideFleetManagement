generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  ON_RENT
  IN_MAINTENANCE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  NEW
  CONFIRMED
  CHECKED_OUT
  CHECKED_IN
  CHECKED_IN_UNPAID
  CANCELLED
  NO_SHOW
  PENDING_FRANCHISE_IMPORT
}

enum ExternalPromotionStatus {
  PENDING
  AUTO_PROMOTED
  MANUAL_REVIEW
  PROMOTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  VOID
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPS
  AGENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  ADMIN_OVERRIDE
}

enum RentalAgreementStatus {
  DRAFT
  READY_FOR_CHECKOUT
  FINALIZED
  CLOSED
  CANCELLED
}

enum ChargeType {
  UNIT
  DAILY
  TAX
  PERCENT
  DEPOSIT
}

enum AgreementPaymentMethod {
  CASH
  CARD
  ZELLE
  ATH_MOVIL
  BANK_TRANSFER
  // AUTH_HOLD: security-deposit authorization hold recorded at POS.
  // Treated like a settled payment for paidAmount/balance math so the
  // outstanding balance excludes the deposit (rental fees only). Funds
  // are NOT actually captured — only the auth code is on file.
  AUTH_HOLD
  OTHER
}

enum ReservationPaymentOrigin {
  OTC
  PORTAL
  IMPORTED
  MIGRATED_NOTE
}

enum InspectionPhase {
  CHECKOUT
  CHECKIN
}

enum FeeMode {
  FIXED
  PER_DAY
  PERCENTAGE
}

enum CommissionValueType {
  PERCENT
  FIXED_PER_UNIT
  FIXED_PER_AGREEMENT
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum RateType {
  MULTIPLE_CLASSES
  SINGLE_CLASS
}

enum VehicleOwnershipType {
  FLEET_OWNED
  HOST_OWNED
}

enum VehicleBlockType {
  MIGRATION_HOLD
  MAINTENANCE_HOLD
  WASH_HOLD
  OUT_OF_SERVICE_HOLD
}

enum VehicleFleetMode {
  RENTAL_ONLY
  CAR_SHARING_ONLY
  BOTH
}

// VehicleProgramCategory partitions inventory between programs that are
// orthogonal to fleetMode. fleetMode answers "is this car offered as
// rental or peer-to-peer car sharing"; programCategory answers "is this
// car for the regular rental fleet, the dealership loaner program, or
// available to both". Triangle's loaner program (200 vehicles) needs
// LOANER_ONLY tagging so their loaner units don't surface in the public
// booking search; their service rentals stay RENTAL_ONLY. Existing
// vehicles default to BOTH for backward compatibility.
enum VehicleProgramCategory {
  RENTAL_ONLY
  LOANER_ONLY
  BOTH
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ListingFulfillmentMode {
  PICKUP_ONLY
  DELIVERY_ONLY
  PICKUP_OR_DELIVERY
}

enum CarSharingSearchPlaceType {
  AIRPORT
  HOTEL
  NEIGHBORHOOD
  STATION
  TENANT_BRANCH
  HOST_PICKUP_SPOT
  DELIVERY_ZONE
}

enum CarSharingPlaceVisibilityMode {
  APPROXIMATE_ONLY
  REVEAL_AFTER_BOOKING
  PUBLIC_EXACT
}

enum HostServiceAreaType {
  PICKUP
  DELIVERY
  BOTH
}

enum TripFulfillmentChoice {
  PICKUP
  DELIVERY
}

enum TripHandoffMode {
  IN_PERSON
  LOCKBOX
  REMOTE_UNLOCK
  SELF_SERVICE
}

enum TripStatus {
  INQUIRY
  RESERVED
  CONFIRMED
  READY_FOR_PICKUP
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum TripPayoutStatus {
  PENDING
  ON_HOLD
  APPROVED
  PAID
  VOID
}

enum TripIncidentType {
  DAMAGE
  TOLL
  CLEANING
  LATE_RETURN
  OTHER
}

enum TripIncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum TripIncidentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TripIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TripIncidentResolutionCode {
  CUSTOMER_CHARGED
  WAIVED
  INVALID_REPORT
  DUPLICATE
  GOODWILL
  OTHER
}

enum TripIncidentLiabilityDecision {
  PENDING
  CUSTOMER
  TENANT
  HOST
  SHARED
  WAIVED
}

enum TripIncidentChargeDecision {
  PENDING
  CHARGE_CUSTOMER
  CHARGE_HOST
  CHARGE_TENANT
  WAIVE
}

enum TripIncidentRecoveryStage {
  INTAKE
  EVIDENCE
  LIABILITY_REVIEW
  READY_TO_CHARGE
  CHARGED
  WAIVED
  CLOSED
}

enum HostReviewStatus {
  REQUESTED
  SUBMITTED
}

enum ReservationWorkflowMode {
  RENTAL
  CAR_SHARING
  DEALERSHIP_LOANER
}

enum LoanerBillingMode {
  COURTESY
  CUSTOMER_PAY
  WARRANTY
  INSURANCE
  INTERNAL
}

enum LoanerBillingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  INVOICED
  SETTLED
  DENIED
}

enum TollProvider {
  AUTOEXPRESO
  SUNPASS
}

enum TollTransactionStatus {
  IMPORTED
  MATCHED
  NEEDS_REVIEW
  BILLED
  DISPUTED
  VOID
}

enum TollMatchStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
  AUTO_CONFIRMED
}

enum TollBillingStatus {
  PENDING
  POSTED_TO_RESERVATION
  POSTED_TO_AGREEMENT
  WAIVED
  DISPUTED
}

enum HostVehicleSubmissionStatus {
  PENDING_REVIEW
  PENDING_INFO
  APPROVED
  REJECTED
}

enum PlannerActionType {
  ASSIGN_VEHICLE
  UNASSIGN_VEHICLE
  MOVE_RESERVATION_TIME
  CREATE_WASH_BLOCK
  CREATE_MAINTENANCE_BLOCK
  CREATE_OUT_OF_SERVICE_BLOCK
}

enum PlannerRecommendationType {
  VEHICLE_ASSIGNMENT
  REBALANCE
  OVERBOOKING_ALERT
  FLEET_SHORTAGE
  MAINTENANCE_SLOT
  WASH_SLOT
}

enum PlannerRuleMode {
  STRICT
  FLEXIBLE
}

model Tenant {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  status                  String   @default("ACTIVE")
  plan                    String   @default("BETA")
  // Path D multi-tenancy fields (added 2026-05-17, see doc/multitenancy-hybrid-architecture.md)
  tier                    String   @default("STANDARD") // STANDARD | PREMIUM | ENTERPRISE
  schemaName              String   @default("public") // 'public' | 'tenant_<slug>'
  carSharingEnabled       Boolean  @default(false)
  dealershipLoanerEnabled Boolean  @default(false)
  tollsEnabled            Boolean  @default(false)
  platformFeeEnabled      Boolean  @default(true)
  platformFeePct          Decimal  @default(10) @db.Decimal(6, 3)
  platformFeeMin          Decimal  @default(7) @db.Decimal(10, 2)
  platformFeeMax          Decimal  @default(35) @db.Decimal(10, 2)
  // Per-tenant override for the canonical Terms & Conditions HTML.
  // When non-empty, supersedes lib/terms/tc-<TC_VERSION>.html in the
  // rental-agreement renderer (see getEffectiveTermsHtmlForTenant).
  // When null/empty, the system continues to render the canonical T&C.
  termsHtml               String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users                       User[]
  locations                   Location[]
  vehicleTypes                VehicleType[]
  vehicles                    Vehicle[]
  vehicleAvailabilityBlocks   VehicleAvailabilityBlock[]
  customers                   Customer[]
  reservations                Reservation[]
  auditLogs                   AuditLog[]
  agreements                  RentalAgreement[]
  rates                       Rate[]
  fees                        Fee[]
  services                    AdditionalService[]
  commissionPlans             CommissionPlan[]
  commissionRules             CommissionRule[]
  agreementCommissions        AgreementCommission[]
  hostProfiles                HostProfile[]
  hostPickupSpots             HostPickupSpot[]
  carSharingSearchPlaces      CarSharingSearchPlace[]
  hostServiceAreas            HostServiceArea[]
  carSharingListings          HostVehicleListing[]
  carSharingTrips             Trip[]
  tripFulfillmentPlans        TripFulfillmentPlan[]
  tripPayouts                 TripPayout[]
  hostVehicleSubmissions      HostVehicleSubmission[]
  tollProviderAccounts        TollProviderAccount[]
  tollTransactions            TollTransaction[]
  tollAssignments             TollAssignment[]
  tollImportRuns              TollImportRun[]
  telematicsDevices           VehicleTelematicsDevice[]
  telematicsEvents            VehicleTelematicsEvent[]
  plannerRuleSet              PlannerRuleSet?
  plannerScenarios            PlannerScenario[]
  plannerRecommendationAudits PlannerRecommendationAudit[]
  conversations               Conversation[]
  knowledgeArticles           KnowledgeArticle[]
  franchises                  Franchise[]
  agreementAddendums          RentalAgreementAddendum[]
  vehicleClassStopSales       VehicleClassStopSale[]
  marketScrapeProfiles        MarketScrapeProfile[]
  feeRates                    FeeRate[]

  // TL International franchise integration (round 5)
  integrationConfig        Json?
  tlExternalReservations   ExternalReservation[]
  tlExternalSyncRuns       ExternalSyncRun[]
  tlIntegrationCredentials IntegrationCredential[]
  tlAcrissCategoryMaps     AcrissCategoryMap[]
  tlLocationCodeMaps       LocationCodeMap[]
  franchisePayoutPeriods   FranchisePayoutPeriod[]

  // Project convention 2026-05-21 — tenant-level audit log (feature flags + future events)
  tenantAuditLogs TenantAuditLog[]

  // Interactive T&C + Dejavoo unified (2026-05-21)
  termsTemplates      TermsTemplate[]
  dejavooTerminals    DejavooTerminal[]
  dejavooTransactions DejavooTransaction[]
}

model Location {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  code           String
  name           String
  address        String?
  city           String?
  state          String?
  country        String?
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  locationConfig String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehiclesHome                   Vehicle[]               @relation("VehicleHomeLocation")
  reservationsPickup             Reservation[]           @relation("ReservationPickupLocation")
  reservationsReturn             Reservation[]           @relation("ReservationReturnLocation")
  agreementsPickup               RentalAgreement[]       @relation("AgreementPickupLocation")
  agreementsReturn               RentalAgreement[]       @relation("AgreementReturnLocation")
  additionalServices             AdditionalService[]
  locationFees                   LocationFee[]
  rates                          Rate[]
  carSharingListings             HostVehicleListing[]
  hostVehicleSubmissionPreferred HostVehicleSubmission[]
  hostPickupSpotsAnchor          HostPickupSpot[]        @relation("HostPickupSpotAnchorLocation")
  carSharingSearchPlacesAnchor   CarSharingSearchPlace[] @relation("CarSharingSearchPlaceAnchorLocation")
  carSharingPickupTrips          Trip[]                  @relation("TripPickupLocation")
  carSharingReturnTrips          Trip[]                  @relation("TripReturnLocation")
  feeRates                       FeeRate[]
  locationCodeMaps               LocationCodeMap[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model VehicleType {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles               Vehicle[]
  reservations           Reservation[]
  rateItems              RateItem[]
  rateDailyPrices        RateDailyPrice[]
  hostVehicleSubmissions HostVehicleSubmission[]
  vehicleClassStopSales  VehicleClassStopSale[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Vehicle {
  id                String                 @id @default(cuid())
  tenantId          String?
  tenant            Tenant?                @relation(fields: [tenantId], references: [id])
  internalNumber    String
  vin               String?                @unique
  plate             String?
  tollTagNumber     String?
  tollStickerNumber String?
  make              String?
  model             String?
  year              Int?
  color             String?
  mileage           Int                    @default(0)
  status            VehicleStatus          @default(AVAILABLE)
  fleetMode         VehicleFleetMode       @default(RENTAL_ONLY)
  // Program partition — see VehicleProgramCategory enum docs.
  // Existing vehicles default to BOTH (no behavior change at write time);
  // tenants with a loaner program (e.g. Triangle) tag their loaner units
  // as LOANER_ONLY so the public rental search hides them. Filter rule:
  //   public rental search       → programCategory IN (RENTAL_ONLY, BOTH)
  //   dealership-loaner intake  → programCategory IN (LOANER_ONLY, BOTH)
  programCategory   VehicleProgramCategory @default(BOTH)

  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  homeLocationId String?
  homeLocation   Location? @relation("VehicleHomeLocation", fields: [homeLocationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations          Reservation[]
  maintenanceJobs       MaintenanceJob[]
  rentalAgreements      RentalAgreement[]
  hostListing           HostVehicleListing?
  hostVehicleSubmission HostVehicleSubmission?
  tollTransactions      TollTransaction[]
  tollAssignments       TollAssignment[]
  availabilityBlocks    VehicleAvailabilityBlock[]
  telematicsDevices     VehicleTelematicsDevice[]
  telematicsEvents      VehicleTelematicsEvent[]

  @@unique([tenantId, plate])
  @@unique([tenantId, internalNumber])
  @@index([tenantId, status])
  @@index([tenantId, programCategory])
}

model VehicleAvailabilityBlock {
  id            String           @id @default(cuid())
  tenantId      String?
  tenant        Tenant?          @relation(fields: [tenantId], references: [id])
  vehicleId     String
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  blockType     VehicleBlockType @default(MIGRATION_HOLD)
  blockedFrom   DateTime         @default(now())
  availableFrom DateTime
  reason        String?
  notes         String?
  sourceType    String?
  releasedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId, vehicleId, blockedFrom, availableFrom])
  @@index([vehicleId, releasedAt, availableFrom])
}

// Website-only stop-sale: hide a vehicle class from the public booking
// website for a date range without affecting backoffice/manual reservations.
// The existing VehicleAvailabilityBlock model (per-VIN, blocks ALL channels)
// is unchanged - this is a separate concept on purpose.
model VehicleClassStopSale {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  reason        String?
  notes         String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, vehicleTypeId, isActive, startDate, endDate])
  @@index([tenantId, isActive])
}

model VehicleTelematicsDevice {
  id               String    @id @default(cuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id])
  vehicleId        String
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider         String
  externalDeviceId String
  label            String?
  serialNumber     String?
  isActive         Boolean   @default(true)
  installedAt      DateTime?
  lastSeenAt       DateTime?
  metadataJson     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  events VehicleTelematicsEvent[]

  @@unique([provider, externalDeviceId])
  @@index([tenantId, vehicleId, isActive])
}

model VehicleTelematicsEvent {
  id          String                   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?                  @relation(fields: [tenantId], references: [id])
  vehicleId   String
  vehicle     Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      VehicleTelematicsDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  eventType   String                   @default("PING")
  eventAt     DateTime
  latitude    Decimal?                 @db.Decimal(9, 6)
  longitude   Decimal?                 @db.Decimal(9, 6)
  speedMph    Decimal?                 @db.Decimal(8, 2)
  heading     Int?
  odometer    Int?
  fuelPct     Decimal?                 @db.Decimal(5, 2)
  batteryPct  Decimal?                 @db.Decimal(5, 2)
  engineOn    Boolean?
  payloadJson String?
  createdAt   DateTime                 @default(now())

  @@index([tenantId, vehicleId, eventAt])
  @@index([deviceId, eventAt])
}

model Customer {
  id                       String    @id @default(cuid())
  tenantId                 String?
  tenant                   Tenant?   @relation(fields: [tenantId], references: [id])
  firstName                String
  lastName                 String
  email                    String?
  phone                    String
  licenseNumber            String?
  licenseState             String?
  dateOfBirth              DateTime?
  insurancePolicyNumber    String?
  insuranceDocumentUrl     String?
  address1                 String?
  address2                 String?
  city                     String?
  state                    String?
  zip                      String?
  country                  String?
  idPhotoUrl               String?
  authnetCustomerProfileId String?
  authnetPaymentProfileId  String?
  // Pillar 2 (added 2026-05-17) — denormalized card metadata for invoice notice
  // Populated by saveAuthNetCardProfileFromReference + authNetResolveStoredCustomerProfile
  // when CIM profile is saved. Backfill script: scripts/backfill-card-metadata.mjs
  cardLast4                String?
  cardBrand                String?
  cardExpiresMonth         Int?
  cardExpiresYear          Int?
  cardUpdatedAt            DateTime?
  // Dejavoo SPIn card-on-file (2026-05-21 — round 20)
  // Populated by the counter checkin/return orchestrators when the
  // terminal returns an IPosToken after AUTH/SALE. Used for card-not-present
  // charges (post-rental tolls, late fees, damage assessments).
  dejavooIposToken         String?
  dejavooCardLast4         String?
  dejavooCardBrand         String?
  dejavooCardEntryType     String? // CHIP | SWIPE | CONTACTLESS | KEYED
  dejavooCardCapturedAt    DateTime?
  creditBalance            Decimal   @default(0) @db.Decimal(10, 2)
  portalResetToken         String?
  portalResetExpiresAt     DateTime?
  guestAccessToken         String?
  guestAccessExpiresAt     DateTime?
  deletionToken            String?   @unique
  deletionTokenExpiresAt   DateTime?
  doNotRent                Boolean   @default(false)
  doNotRentReason          String?
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  reservations  Reservation[]
  guestTrips    Trip[]         @relation("TripGuestCustomer")
  hostReviews   HostReview[]
  conversations Conversation[]

  @@index([tenantId])
  @@index([tenantId, lastName])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
}

model Reservation {
  id                              String                  @id @default(cuid())
  tenantId                        String?
  tenant                          Tenant?                 @relation(fields: [tenantId], references: [id])
  reservationNumber               String                  @unique
  sourceRef                       String?                 @unique
  status                          ReservationStatus       @default(NEW)
  workflowMode                    ReservationWorkflowMode @default(RENTAL)
  loanerBillingMode               LoanerBillingMode?
  repairOrderNumber               String?
  claimNumber                     String?
  serviceAdvisorName              String?
  serviceAdvisorEmail             String?
  serviceAdvisorPhone             String?
  serviceStartAt                  DateTime?
  estimatedServiceCompletionAt    DateTime?
  serviceVehicleYear              Int?
  serviceVehicleMake              String?
  serviceVehicleModel             String?
  serviceVehiclePlate             String?
  serviceVehicleVin               String?
  loanerLiabilityAccepted         Boolean                 @default(false)
  loanerLiabilityAcceptedAt       DateTime?
  loanerProgramNotes              String?
  loanerBorrowerPacketJson        String?
  loanerBorrowerPacketCompletedAt DateTime?
  loanerBorrowerPacketCompletedBy String?
  loanerBillingContactName        String?
  loanerBillingContactEmail       String?
  loanerBillingContactPhone       String?
  loanerBillingAuthorizationRef   String?
  loanerBillingNotes              String?
  loanerReturnExceptionFlag       Boolean                 @default(false)
  loanerReturnExceptionNotes      String?
  loanerBillingStatus             LoanerBillingStatus     @default(DRAFT)
  loanerBillingSubmittedAt        DateTime?
  loanerBillingSettledAt          DateTime?
  serviceAdvisorNotes             String?
  serviceAdvisorUpdatedAt         DateTime?
  loanerServiceCompletedAt        DateTime?
  loanerServiceCompletedBy        String?
  loanerCloseoutNotes             String?
  loanerPurchaseOrderNumber       String?
  loanerDealerInvoiceNumber       String?
  loanerAccountingNotes           String?
  loanerAccountingClosedAt        DateTime?
  loanerAccountingClosedBy        String?
  loanerLastExtendedAt            DateTime?
  loanerLastVehicleSwapAt         DateTime?

  bookingChannel String @default("STAFF")

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  vehicleTypeId String?
  vehicleType   VehicleType? @relation(fields: [vehicleTypeId], references: [id])

  pickupAt DateTime
  returnAt DateTime

  // Captured the FIRST time a reservation is extended (the very first
  // booked returnAt). Stays immutable across subsequent extensions so
  // the UI can render "Originally returned X · Now returns Y". Cleared
  // back to NULL when the only/last extension is deleted.
  originalReturnAt DateTime?

  // Pillar 2 (added 2026-05-17) — auto-charge state machine.
  // Set when checkin completes with balance > 0 and status transitions
  // to CHECKED_IN_UNPAID. Worker polls + charges + transitions to CHECKED_IN.
  // autochargeBlocked = TRUE for reservations signed before terms update
  // (no legal authorization to auto-charge).
  autochargeBlocked   Boolean   @default(false)
  autochargeAt        DateTime?
  autochargeAttempts  Int       @default(0)
  autochargeLastError String?

  pickupLocationId String
  pickupLocation   Location @relation("ReservationPickupLocation", fields: [pickupLocationId], references: [id])

  returnLocationId String
  returnLocation   Location @relation("ReservationReturnLocation", fields: [returnLocationId], references: [id])

  franchiseId String?
  franchise   Franchise? @relation("ReservationFranchise", fields: [franchiseId], references: [id])

  dailyRate      Decimal?      @db.Decimal(10, 2)
  estimatedTotal Decimal?      @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING)

  sendConfirmationEmail        Boolean   @default(true)
  notes                        String?
  customerInfoToken            String?
  customerInfoTokenExpiresAt   DateTime?
  customerInfoCompletedAt      DateTime?
  customerInfoReviewedAt       DateTime?
  customerInfoReviewedByUserId String?
  customerInfoReviewedByUser   User?     @relation("ReservationCustomerInfoReviewedBy", fields: [customerInfoReviewedByUserId], references: [id])
  customerInfoReviewNote       String?
  readyForPickupAt             DateTime?
  readyForPickupByUserId       String?
  readyForPickupByUser         User?     @relation("ReservationReadyForPickupBy", fields: [readyForPickupByUserId], references: [id])
  readyForPickupOverrideNote   String?
  signatureToken               String?
  signatureTokenExpiresAt      DateTime?
  paymentRequestToken          String?
  paymentRequestTokenExpiresAt DateTime?
  signatureSignedAt            DateTime?
  signatureSignedBy            String?
  signatureDataUrl             String?

  // 16g — canonical T&C version accepted by the customer at signature
  // submission time. Lexicographic comparison against TC_VERSION from
  // src/lib/terms/version.js determines whether a reservation may be
  // auto-charged after the new card-on-file authorization landed.
  // NULL on reservations created before the field was added; those rows
  // are the 281 unblocked en masse by scripts/unblock-pre-terms-reservations.mjs.
  termsVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices          Invoice[]
  auditLogs         AuditLog[]
  rentalAgreement   RentalAgreement?
  pricingSnapshot   ReservationPricingSnapshot?
  charges           ReservationCharge[]
  payments          ReservationPayment[]
  additionalDrivers ReservationAdditionalDriver[]
  carSharingTrip    Trip?
  incidents         TripIncident[]
  hostReviews       HostReview[]
  tollTransactions  TollTransaction[]
  tollAssignments   TollAssignment[]

  // TL International franchise integration (round 5)
  externalReservation ExternalReservation? @relation("ReservationFromExternal")

  // Interactive T&C + Dejavoo unified (2026-05-21)
  signing             ReservationSigning?
  dejavooTransactions DejavooTransaction[]
  signingCompletedAt  DateTime?

  // Round 22 — rental fee collected at PICKUP (SALE on terminal, before AUTH deposit)
  // null = rental fee not yet collected at counter (either prepaid online or
  // not yet through pickup). Set by counter-orchestrator after successful SALE.
  rentalFeeCollectedAt    DateTime?
  rentalFeeCollectedCents Int?

  @@index([status, pickupAt])
  @@index([workflowMode, status, pickupAt])
  @@index([pickupLocationId, pickupAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, pickupAt])
  @@index([repairOrderNumber])
  @@index([customerId])
  @@index([returnAt])
  @@index([tenantId, status, returnAt])
  @@index([vehicleId])
  // Speeds up `/summary`'s nextNoShow findFirst:
  // `WHERE tenantId, status='NO_SHOW' ORDER BY updatedAt DESC LIMIT 1`.
  // Without this, Postgres filters via [tenantId, status, pickupAt] and
  // then has to sort by updatedAt — getting slower as table grows.
  @@index([tenantId, status, updatedAt(sort: Desc)])
}

