  type          RepairOrderLineType @default(PART)
  description   String
  qty           Decimal             @default(1) @db.Decimal(10, 2)
  unitCost      Decimal             @default(0) @db.Decimal(10, 2)
  amount        Decimal             @default(0) @db.Decimal(10, 2) // qty × unitCost (or flat)
  createdAt     DateTime            @default(now())

  @@index([repairOrderId])
}

