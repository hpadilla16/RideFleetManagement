  @@index([tenantId, transactionAt])
  @@index([tenantId, status, transactionAt])
  @@index([tenantId, plateNormalized, transactionAt])
  @@index([tenantId, tagNormalized, transactionAt])
  @@index([tenantId, selloNormalized, transactionAt])
