  // 2026-07-25 — local vs non-local renter deposit rule (MONEY). When the
  // pickup location configures locationConfig.depositRules, the decision is
  // frozen here as JSON {locality, basis, localStates,
  // securityDepositAmount, milesPerDay, unlimitedMileage, evaluatedAt} so a
  // later licence edit never re-prices a decided reservation, and check-in
  // mileage billing reads the SAME decision the deposit was based on.
  // Absent = no rule ran (legacy reservations / location has no rules).
  // Written by reservation create paths; read by resolveIncludedMilesPerDay
  // and the runDepositHold safety net (which skips when this is present).
  securityDepositRuleJson String?

  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReservationCharge {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  code       String?
  name       String
  chargeType ChargeType @default(UNIT)
  quantity   Decimal    @default(1) @db.Decimal(10, 2)
  rate       Decimal    @default(0) @db.Decimal(10, 2)
  total      Decimal    @default(0) @db.Decimal(10, 2)
  taxable    Boolean    @default(false)
  selected   Boolean    @default(true)
  sortOrder  Int        @default(0)

  source      String?
  sourceRefId String?
  notes       String?

  // A human set this rate/quantity ON THIS RESERVATION, so the settings
  // catalog must not re-derive it (2026-08-10). Stored, not inferred: a
  // catalog price change would otherwise make every untouched row look
  // overridden and freeze it. See imported-fee-dedup.js for the sibling rule
  // on fees.
  priceOverridden Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId, selected, sortOrder])
}

// ⚠️ IDEMPOTENCY FLOOR LIVES IN SQL, NOT HERE (B5 Phase 1, review M3).
// A PARTIAL unique index — unique(reservationId, reference) WHERE reference is
// a gateway reference — is created in
//   prisma/migrations/20260724_kiosk_b5_phase1/migration.sql
// Prisma cannot express a filtered unique index, so it is INVISIBLE to this
// schema: `prisma migrate dev` / `db push` may try to DROP it and nothing here
// would notice. If it disappears, the P2002 collapse in
// reservation-pricing.service.js silently degrades to a no-op and a
// webhook+poll race can double-post a payment.
// Guard: payment-references.test.mjs asserts the index exists in any reachable
// database. Do NOT add @@unique([reservationId, reference]) — it would be
// unfiltered and break legitimate repeated MANUAL references.
model ReservationPayment {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  method    AgreementPaymentMethod
  amount    Decimal                @db.Decimal(10, 2)
  reference String?
  status    PaymentStatus          @default(PAID)
  paidAt    DateTime               @default(now())

  origin  ReservationPaymentOrigin @default(OTC)
  gateway String?
  notes   String?

  rentalAgreementPaymentId String?

  // Who took this payment (2026-08-14). The row recorded the money and the
  // method but never the person, so "who ran this charge?" could only be
  // inferred from an audit row that attributes a balance-settling payment to a
  // STATUS CHANGE rather than to the payment. Ride University's
  // PAYMENT_RECORDED check needs the plain fact — and so does anyone
  // reconciling a drawer. Nullable: historic rows genuinely do not know.
  recordedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId, paidAt])
  @@index([reference])
  @@index([status, paidAt])
  @@index([recordedByUserId, paidAt])
}

model ReservationAdditionalDriver {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  firstName            String
  lastName             String
  address              String?
  dateOfBirth          DateTime?
  licenseNumber        String?
  licenseImageUploaded Boolean   @default(false)
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId, createdAt])
}

// Distinguishes a rental price book from the loaner program's price book (2026-06-25). LOANER rates
// are read ONLY by the loaner module and MUST be excluded from rental quoting (ratesService
// .resolveForRental filters purpose != LOANER) so the two pricing systems never conflate.
enum RatePurpose {
  RENTAL
  LOANER
}

model Rate {
  id                  String      @id @default(cuid())
  tenantId            String?
  tenant              Tenant?     @relation(fields: [tenantId], references: [id])
  rateCode            String
  name                String?
  locationId          String?
  location            Location?   @relation(fields: [locationId], references: [id])
  locationIds         String?
  purpose             RatePurpose @default(RENTAL)
  rateType            RateType    @default(MULTIPLE_CLASSES)
  calculationBy       String      @default("24_HOUR_TIME")
  averageBy           String?     @default("DATE_RANGE")
  daily               Decimal     @default(0) @db.Decimal(10, 2)
  fuelChargePerGallon Decimal?    @db.Decimal(10, 2)
  minChargeDays       Int?
  minChargeHours      Int?
  grossFlatNumber     Decimal?    @db.Decimal(10, 2)
  extraMileCharge     Decimal?    @db.Decimal(10, 2)
  graceMinutes        Int?
  useHourlyRates      Boolean     @default(false)
  active              Boolean     @default(true)
  displayOnline       Boolean     @default(false)
  variesPricing       Boolean     @default(false)
  sameSpecialRates    Boolean     @default(false)
  rencarscom          Boolean     @default(false)
  monday              Boolean     @default(true)
  tuesday             Boolean     @default(true)
  wednesday           Boolean     @default(true)
  thursday            Boolean     @default(true)
  friday              Boolean     @default(true)
  saturday            Boolean     @default(true)
  sunday              Boolean     @default(true)
  effectiveDate       DateTime?
  endDate             DateTime?
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  rateItems            RateItem[]
  dailyPrices          RateDailyPrice[]
  marketScrapeProfiles MarketScrapeProfile[] @relation("MarketScrapeProfileTargetRate")
  pricingRule          PricingRule?
  pricingSuggestions   PricingSuggestion[]

  @@unique([tenantId, rateCode])
  @@index([locationId, isActive])
  @@index([tenantId, isActive])
}

model RateItem {
  id              String      @id @default(cuid())
  rateId          String
  rate            Rate        @relation(fields: [rateId], references: [id], onDelete: Cascade)
  vehicleTypeId   String
  vehicleType     VehicleType @relation(fields: [vehicleTypeId], references: [id])
  hourly          Decimal     @default(0) @db.Decimal(10, 2)
  daily           Decimal     @default(0) @db.Decimal(10, 2)
  extraDaily      Decimal     @default(0) @db.Decimal(10, 2)
  weekly          Decimal     @default(0) @db.Decimal(10, 2)
  monthly         Decimal     @default(0) @db.Decimal(10, 2)
  minHourly       Int         @default(0)
  minDaily        Int         @default(0)
  minWeekly       Int         @default(0)
  minMonthly      Int         @default(0)
  extraMileCharge Decimal     @default(0) @db.Decimal(10, 2)
  sortOrder       Int         @default(0)

  @@unique([rateId, vehicleTypeId])
}

model RateDailyPrice {
  id            String      @id @default(cuid())
  rateId        String
  rate          Rate        @relation(fields: [rateId], references: [id], onDelete: Cascade)
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
  date          DateTime
  daily         Decimal     @default(0) @db.Decimal(10, 2)
  // Authorship of the per-date override. 'MARKET_A' = written by the Market
  // Intelligence auto-apply engine (self-cleaning: the engine only clears its OWN
  // overrides). null / anything else = OPERATOR-authored (holiday/event surge set
  // by hand in the Rates UI) — NEVER touched by the engine; wins over the base per
  // resolveForRental's override-wins logic.
  source        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([rateId, vehicleTypeId, date])
  @@index([rateId, date])
  @@index([vehicleTypeId, date])
}

model Fee {
  id                    String   @id @default(cuid())
  tenantId              String?
  tenant                Tenant?  @relation(fields: [tenantId], references: [id])
  code                  String?
  name                  String
  description           String?
  mode                  FeeMode
  amount                Decimal  @default(0) @db.Decimal(10, 2)
  taxable               Boolean  @default(false)
  isActive              Boolean  @default(true)
  mandatory             Boolean  @default(false)
  isUnderageFee         Boolean  @default(false)
  isAdditionalDriverFee Boolean  @default(false)
  displayOnline         Boolean  @default(false) // NEW: controls visibility on public website
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  locationFees   LocationFee[]
  linkedServices AdditionalService[] @relation("AdditionalServiceLinkedFee")

  @@unique([tenantId, code])
  @@index([isActive, name])
  @@index([tenantId, isActive])
  @@index([tenantId, isActive, mandatory, displayOnline]) // NEW: optimized for website fees fetch
}

model LocationFee {
  locationId String
  feeId      String
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fee      Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@id([locationId, feeId])
}

model AdditionalService {
  id                     String               @id @default(cuid())
  tenantId               String?
  tenant                 Tenant?              @relation(fields: [tenantId], references: [id])
  code                   String?
  name                   String
  description            String?
  chargeType             ChargeType           @default(UNIT)
  unitLabel              String?              @default("Unit")
  calculationBy          String               @default("24_HOUR_TIME")
  rate                   Decimal              @default(0) @db.Decimal(10, 2)
  dailyRate              Decimal?             @db.Decimal(10, 2)
  weeklyRate             Decimal?             @db.Decimal(10, 2)
  monthlyRate            Decimal?             @db.Decimal(10, 2)
  commissionValueType    CommissionValueType?
  commissionPercentValue Decimal?             @db.Decimal(5, 2)
  commissionFixedAmount  Decimal?             @db.Decimal(10, 2)
  taxable                Boolean              @default(false)
  defaultQty             Decimal              @default(1) @db.Decimal(10, 2)
  sortOrder              Int                  @default(0)
  allVehicleTypes        Boolean              @default(true)
  vehicleTypeIds         String?
  displayOnline          Boolean              @default(false)
  defaultRencars         Boolean              @default(false)
  mandatory              Boolean              @default(false)
  coversTolls            Boolean              @default(false)
  // 2026-07-28 (LAX #10) — "Toll Activation": bill the ACTUAL tolls used at
  // cost, but suppress the location's toll policy/admin fee. Opposite corner
  // from coversTolls (prepaid → nothing billed); coversTolls wins if both.
  tollPassthrough        Boolean              @default(false)
  displayDescription     String?
  displayPriority        Int                  @default(0)
  isActive               Boolean              @default(true)

  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  linkedFeeId String?
  linkedFee   Fee?      @relation("AdditionalServiceLinkedFee", fields: [linkedFeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissionRules CommissionRule[]
  commissionLines AgreementCommissionLine[]

  @@index([locationId, isActive])
  @@index([linkedFeeId])
  @@index([tenantId, isActive])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlannerRuleSet {
  id                              String          @id @default(cuid())
  tenantId                        String          @unique
  tenant                          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  minTurnaroundMinutes            Int             @default(60)
  washBufferMinutes               Int             @default(30)
  prepBufferMinutes               Int             @default(15)
  maintenanceBufferMinutes        Int             @default(120)
  lockWindowMinutesBeforePickup   Int             @default(180)
  sameDayReservationBufferMinutes Int             @default(45)
  allowCrossLocationReassignment  Boolean         @default(false)
  strictVehicleTypeMatch          Boolean         @default(true)
  allowUpgrade                    Boolean         @default(true)
  allowDowngrade                  Boolean         @default(false)
  defaultWashRequired             Boolean         @default(true)
  assignmentMode                  PlannerRuleMode @default(STRICT)
  maintenanceMode                 PlannerRuleMode @default(FLEXIBLE)
  vehicleTypeOverridesJson        String?
  locationOverridesJson           String?
  scoringWeightsJson              String?
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt
}

// Per-tenant Turn-Ready scoring rules (2026-08-03, dashboard v2). Hector:
// the tenant configures how their own score is calculated. Stored as JSON so
// adding a factor is a code change, not a migration. NO ROW = the frozen
// defaults in src/lib/turn-ready-rules.js, which reproduce the formula that
// shipped before this model existed.
model TurnReadyRuleSet {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rulesJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Shuttle Requests (Valet arc, 2026-08-05) ────────────────────────────────
// Chloe (the VozIA voice agent) validates the reservation and creates one of
// these when an arrived customer calls for airport pickup. RFM floor agents
// dispatch. Idempotent per reservation: a repeat call bumps callCount and
// re-READYs the existing row instead of creating a second bus.
enum ShuttleRequestStatus {
  READY
  VIEWED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model ShuttleRequest {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location             @relation(fields: [locationId], references: [id])
  reservationId  String
  reservation    Reservation          @relation(fields: [reservationId], references: [id])
  customerName   String
  customerPhone  String?
  partySize      Int                  @default(1)
  pickupNote     String?
  status         ShuttleRequestStatus @default(READY)
  callCount      Int                  @default(1)
  viewedAt       DateTime?
  viewedByUserId String?
  // Delay-notice log (2026-08-07): JSON array of {at, byUserId, reason,
  // etaMinutes, to, status} — the record that stops three agents from
  // emailing the same waiting customer three times.
  delayNoticesJson String?
  closedAt       DateTime?
  closedByUserId String?
  closeReason    String?
  // Where the request came from (2026-08-15): VOICE (VozIA), VALET, or
  // PUBLIC_LINK (the customer's tracker page). Null = created before this
  // column existed. Reporting and abuse triage both want the distinction.
  source         String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // The global banner polls this every few seconds.
  @@index([tenantId, locationId, status])
  @@index([reservationId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Shuttle tracker (Hector, 2026-08-15): a customer-facing live map of the
// shuttle, reached only through per-reservation expiring links.
// ─────────────────────────────────────────────────────────────────────────────

// Per-location tracker configuration. The explicit vehicle list IS the
// "this is a shuttle" marker — deliberately NOT a flag on Vehicle, because
// fleetMode/programCategory are inventory-partition enums with filter rules
// baked into rental search and loaner intake; adding SHUTTLE there would
// ripple through every consumer. A list here also can't leave an orphaned
// flag behind when a unit rotates out of shuttle duty.
model ShuttleTrackerConfig {
  id         String @id @default(cuid())
  tenantId   String
  locationId String @unique

  // OFF | ON_DEMAND (customer can request) | NON_STOP (fixed loop, watch only)
  mode String @default("OFF")

  // JSON array of vehicle ids whose position the public page may show.
  // The ONLY vehicles the public endpoint will ever resolve.
  vehicleIdsJson Json?

  // NON_STOP: "runs every ~N minutes" — tenant-stated, shown verbatim.
  headwayMinutes Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// One expiring link per reservation (Hector's security call, 2026-08-15:
// NO standing links, NO shareable QR — every link is customer-only and dies
// with the rental). Sent by email + SMS with the confirmation. The token
// alone resolves the page; identity for "request shuttle" is inherent, so
// the customer never types anything at the curb.
model ShuttleTrackerLink {
  id            String @id @default(cuid())
  tenantId      String
  reservationId String

  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([tenantId, expiresAt])
}

model PlannerScenario {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startAt           DateTime
  endAt             DateTime
  locationId        String?
  vehicleTypeId     String?
  scenarioType      String
  status            String   @default("SIMULATED")
  summaryJson       String?
  rulesSnapshotJson String?
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  actions PlannerScenarioAction[]

  @@index([tenantId, startAt, endAt])
  @@index([tenantId, scenarioType, createdAt])
}

model PlannerScenarioAction {
  id                String            @id @default(cuid())
  scenarioId        String
  scenario          PlannerScenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  reservationId     String?
  vehicleId         String?
  actionType        PlannerActionType
  actionPayloadJson String
  reasonSummary     String?
  score             Decimal?          @db.Decimal(8, 2)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())

  @@index([scenarioId, sortOrder])
}

model PlannerRecommendationAudit {
  id                 String                    @id @default(cuid())
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recommendationType PlannerRecommendationType
  reservationId      String?
  vehicleId          String?
  scenarioId         String?
  title              String
  detail             String?
  recommendationJson String
  applied            Boolean                   @default(false)
  appliedByUserId    String?
  appliedAt          DateTime?
  createdAt          DateTime                  @default(now())

  @@index([tenantId, recommendationType, createdAt])
}

// Report Builder (2026-07-26): a saved custom report is DATA, not code - a
// definition JSON executed by custom-report.engine.js. The definition can
// never express a tenant or location (the engine injects those from the
// runner), and every field key resolves through the role-gated registry.
enum CustomReportVisibility {
  PRIVATE
  TENANT
}

model CustomReport {
  id            String                 @id @default(cuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerUserId   String
  name          String
  description   String?
  dataset       String
  definition    Json
  schemaVersion Int                    @default(1)
  visibility    CustomReportVisibility @default(PRIVATE)
  lastRunAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([tenantId, ownerUserId, name])
  @@index([tenantId, visibility])
}

model TollProviderAccount {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider          TollProvider
  // Sede this account's tolls belong to (TollBridge finding (a), 2026-07-26: a
  // CA toll must never evaluate against a FL car). Stamped onto every imported
  // transaction; null keeps the pre-existing tenant-wide behavior.
  locationId        String?
  isActive          Boolean      @default(true)
  username          String?
  passwordEncrypted String?
  accountNumber     String?
  settingsJson      String?
  lastSyncAt        DateTime?
  lastSyncStatus    String?
  lastSyncMessage   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  importRuns   TollImportRun[]
  transactions TollTransaction[]

  @@unique([tenantId, provider])
  @@index([tenantId, provider, isActive])
}

model TollImportRun {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerAccountId String
  providerAccount   TollProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  startedAt         DateTime            @default(now())
  completedAt       DateTime?
  sourceType        String
  status            String
  importedCount     Int                 @default(0)
  matchedCount      Int                 @default(0)
  reviewCount       Int                 @default(0)
  errorMessage      String?
  metadataJson      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  transactions TollTransaction[]

  @@index([tenantId, startedAt])
}

model TollTransaction {
  id                 String                @id @default(cuid())
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerAccountId  String?
  providerAccount    TollProviderAccount?  @relation(fields: [providerAccountId], references: [id])
  importRunId        String?
  importRun          TollImportRun?        @relation(fields: [importRunId], references: [id])
  externalId         String?
  transactionAt      DateTime
  transactionDate    DateTime?
  transactionTimeRaw String?
  amount             Decimal               @db.Decimal(10, 2)
  location           String?
  lane               String?
  direction          String?
  plateRaw           String?
  plateNormalized    String?
  tagRaw             String?
  tagNormalized      String?
  selloRaw           String?
  selloNormalized    String?
  vehicleId          String?
  vehicle            Vehicle?              @relation(fields: [vehicleId], references: [id])
  reservationId      String?
  reservation        Reservation?          @relation(fields: [reservationId], references: [id])
  status             TollTransactionStatus @default(IMPORTED)
  matchConfidence    Decimal?              @db.Decimal(5, 2)
  needsReview        Boolean               @default(false)
  billingStatus      TollBillingStatus     @default(PENDING)
  sourcePayloadJson  String?
  reviewNotes        String?
  // Sede stamp inherited from the provider account at import. Scopes match
  // candidates and selects the per-location re-match window (TollBridge
  // findings (a)+(b), 2026-07-26). Null = tenant-wide, pre-existing behavior.
  locationId         String?
  // Staff-alert workflow (Hector's request, TollBridge point 9). notifiedAt is
  // the one-email-per-toll idempotency claim; ackAt is the in-app
  // "seen/collected" mark. Existing rows are backfilled non-null by the
  // migration so the feature only fires for tolls arriving after it ships.
  staffNotifiedAt    DateTime?
  staffAckAt         DateTime?
  staffAckByUserId   String?
  // Set by RESET_MATCH (a human explicitly parked this toll for manual
  // review). The scheduled re-match sweep NEVER touches held rows — without
  // this, the sweep would re-derive the same suggestion the human just
  // rejected and silently re-bill it (QA blocker, 2026-07-26). A human
  // running bulk-auto-match clears the hold.
  manualHoldAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  assignments TollAssignment[]

  @@unique([tenantId, externalId])
  @@index([tenantId, transactionAt])
  @@index([tenantId, status, transactionAt])
  @@index([tenantId, plateNormalized, transactionAt])
  @@index([tenantId, tagNormalized, transactionAt])
  @@index([tenantId, selloNormalized, transactionAt])
  @@index([tenantId, staffAckAt])
}

model TollAssignment {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tollTransactionId String
  tollTransaction   TollTransaction @relation(fields: [tollTransactionId], references: [id], onDelete: Cascade)
  reservationId     String
  reservation       Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  vehicleId         String?
  vehicle           Vehicle?        @relation(fields: [vehicleId], references: [id])
  status            TollMatchStatus
  confidence        Decimal?        @db.Decimal(5, 2)
  matchedByUserId   String?
  matchedByUser     User?           @relation("TollAssignmentMatchedByUser", fields: [matchedByUserId], references: [id])
  matchReason       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenantId, reservationId, status])
  @@index([tollTransactionId, status])
}

// ─── Citations (mirror of Toll* models) — plan doc/citations-tolls-fase-a-spec-2026-06-12.md ───
model CitationSourceAccount {
  id                String         @id @default(cuid())
