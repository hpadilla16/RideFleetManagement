// Public loaner self-service "request a courtesy car" lead (2026-06-25). Filled by the public
// website form (POST /api/public/loaner/request); the advisor works it from the dashboard.
model LoanerRequest {
  id                String    @id @default(cuid())
  tenantId          String?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  name              String
  phone             String
  email             String?
  repairOrderNumber String?
  preferredDate     DateTime?
  notes             String?
  status            String    @default("RECEIVED") // RECEIVED | CONTACTED | CONVERTED | CLOSED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, status])
}

