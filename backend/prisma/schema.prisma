model VehicleTelematicsEvent {
  id          String                   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?                  @relation(fields: [tenantId], references: [id])
  vehicleId   String
  vehicle     Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      VehicleTelematicsDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
