model User {
  id                 String               @id @default(cuid())
  tenantId           String?
  tenant             Tenant?              @relation(fields: [tenantId], references: [id])
  createdByUserId    String?
  createdByUser      User?                @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  email              String               @unique
  passwordHash       String
  // First-login onboarding (2026-07-25): mustChangePassword is true whenever
  // someone OTHER than the user knows the password (temp password at create,
  // any admin reset). While true, requireAuth 403s everything except the
  // change-password allowlist (code PASSWORD_CHANGE_REQUIRED) and AuthGate
  // renders the forced-change screen. passwordChangedAt records the last
  // SELF-chosen password (null = never chose one).
  mustChangePassword Boolean              @default(false)
  passwordChangedAt  DateTime?
  lockPinHash        String?
  lockPinUpdatedAt   DateTime?
  screenLockExempt   Boolean              @default(false)
  fullName           String
  role               UserRole             @default(AGENT)
  isActive           Boolean              @default(true)
  // Location scoping (2026-06-23): JSON array of Location ids this user may see.
  // null/absent or empty = ALL locations (no restriction). ADMIN/SUPER_ADMIN
  // always bypass (see locationScopeFor). Enforced in Fase 2.
  locationIds        String?
  // Program scoping (2026-07-02): which program's data this employee sees.
  // BOTH = no restriction (default, zero behavior change). ADMIN/SUPER_ADMIN
  // always bypass (see userProgramScope). Composes with locationIds.
  programScope       EmployeeProgramScope @default(BOTH)
  // Person kind (2026-07-25, LAX meeting #4): VIRTUAL_AGENT sells remotely
  // (auth role stays AGENT — UserRole is load-bearing for permissions) and
  // earns a PERCENT-of-sold-items commission (services + insurance) on the
  // agreements they originate, computed alongside — never instead of — the
  // checkout employee's commission. STANDARD = zero behavior change.
  personKind         EmployeePersonKind   @default(STANDARD)
  // VozIA service integration (2026-07-03): machine identity + token
  // versioning. isServiceAccount gates the default-deny endpoint allowlist
  // (lib/service-account-allowlist.js) and the tv-claim check in requireAuth;
  // bumping tokenVersion revokes every outstanding service token at once.
  // Human JWTs never carry the tv/svc claims — zero behavior change for staff.
  isServiceAccount   Boolean              @default(false)
  tokenVersion       Int                  @default(0)
  commissionPlanId   String?
  commissionPlan     CommissionPlan?      @relation("UserCommissionPlan", fields: [commissionPlanId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  auditLogs                        AuditLog[]
  salesOwnedAgreements             RentalAgreement[]       @relation("AgreementSalesOwner")
  closedAgreements                 RentalAgreement[]       @relation("AgreementClosedBy")
  agreementCommissions             AgreementCommission[]   @relation("AgreementCommissionEmployee")
  matchedTollAssignments           TollAssignment[]        @relation("TollAssignmentMatchedByUser")
  matchedCitationAssignments       CitationAssignment[]    @relation("CitationAssignmentMatchedByUser")
  customerInfoReviewedReservations Reservation[]           @relation("ReservationCustomerInfoReviewedBy")
  readyForPickupReservations       Reservation[]           @relation("ReservationReadyForPickupBy")
  hostProfile                      HostProfile?
  createdUsers                     User[]                  @relation("UserCreatedBy")
  createdHostProfiles              HostProfile[]           @relation("HostProfileCreatedBy")
  approvedHostVehicleSubmissions   HostVehicleSubmission[]
  ownedTripIncidents               TripIncident[]          @relation("TripIncidentOwner")

  @@index([tenantId, role, isActive])
  @@index([commissionPlanId])
  @@index([createdByUserId])
}

