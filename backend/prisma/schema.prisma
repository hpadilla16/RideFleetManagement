// VehicleProgramCategory partitions inventory between programs that are
// orthogonal to fleetMode. fleetMode answers "is this car offered as
// rental or peer-to-peer car sharing"; programCategory answers "is this
// car for the regular rental fleet, the dealership loaner program, or
// available to both". Triangle's loaner program (200 vehicles) needs
// LOANER_ONLY tagging so their loaner units don't surface in the public
// booking search; their service rentals stay RENTAL_ONLY. Existing
// vehicles default to BOTH for backward compatibility.
enum VehicleProgramCategory {
  RENTAL_ONLY
  LOANER_ONLY
  BOTH
}

// EmployeeProgramScope (2026-07-02): per-employee program visibility. Mirrors
// VehicleProgramCategory but applies to User accounts — a LOANER_ONLY employee
// keeps every module they normally have but only sees loaner-side data
// (vehicles LOANER_ONLY/BOTH, reservations DEALERSHIP_LOANER); a RENTAL_ONLY
// employee sees only rental-side data AND loses the loaner module entirely.
// BOTH (default) = no filtering. ADMIN/SUPER_ADMIN always bypass, mirroring
// location scoping (see userProgramScope in lib/tenant-scope.js).
enum EmployeeProgramScope {
  RENTAL_ONLY
  LOANER_ONLY
  BOTH
}

