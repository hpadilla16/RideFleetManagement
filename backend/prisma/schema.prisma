model Tenant {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  status                    String   @default("ACTIVE")
  // Public booking website (2026-06-24): the site sends X-Tenant-Token on every
  // /api/public/booking request. We store ONLY the sha256 hash; the plaintext is
  // generated once via scripts/gen-website-token.mjs and never persisted.
  websiteTokenHash          String?  @unique
  companyLogoUrl            String?
  plan                      String   @default("BETA")
  // Path D multi-tenancy fields (added 2026-05-17, see doc/multitenancy-hybrid-architecture.md)
  tier                      String   @default("STANDARD") // STANDARD | PREMIUM | ENTERPRISE
  schemaName                String   @default("public") // 'public' | 'tenant_<slug>'
  carSharingEnabled         Boolean  @default(false)
  dealershipLoanerEnabled   Boolean  @default(false)
  tollsEnabled              Boolean  @default(false)
  citationsEnabled          Boolean  @default(false)
  // Per-tenant entitlement for the Market Intelligence module
  // (Expedia scraper + pricing rules + suggestions inbox). Opt-in,
  // gated by super-admin from the /tenants page. When false the module
  // is hidden from the nav and all /api/market* + /api/pricing-* routes
  // 403 — see lib/module-access.js normalizeTenantModuleConfig.
  marketIntelligenceEnabled Boolean  @default(false)
  // Up to 6 SIPP codes the tenant pins to the Market Intelligence dashboard
  // card (e.g. ["CCAR","CFAR",...]). null/empty → card falls back to the top 6
  // by market volume. Set from Settings → Market Intelligence. See
  // settings.service.js getDashboardSipps/updateDashboardSipps (beta.134).
  dashboardSipps            Json?
  // Competitors to drop from the Market Intelligence pool for this tenant: their
  // own brand(s) + any vendors they don't want compared against. JSON array of
  // vendor names; null/empty → no filtering. Set from Settings → Market
  // Intelligence → "Excluded competitors". Matched via market-vendor.js vendorKey
  // so spelling variants ("U-Save Car Rental" ≈ "U-Save") all collapse.
  marketExcludedVendors     Json?
  platformFeeEnabled        Boolean  @default(true)
  platformFeePct            Decimal  @default(10) @db.Decimal(6, 3)
  platformFeeMin            Decimal  @default(7) @db.Decimal(10, 2)
  platformFeeMax            Decimal  @default(35) @db.Decimal(10, 2)
  // Per-tenant override for the canonical Terms & Conditions HTML.
  // When non-empty, supersedes lib/terms/tc-<TC_VERSION>.html in the
  // rental-agreement renderer (see getEffectiveTermsHtmlForTenant).
  // When null/empty, the system continues to render the canonical T&C.
  termsHtml                 String?  @db.Text
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  users                       User[]
  locations                   Location[]
  vehicleTypes                VehicleType[]
  vehicles                    Vehicle[]
  vehicleAvailabilityBlocks   VehicleAvailabilityBlock[]
  vehicleMileageEntries       VehicleMileageEntry[]
  inventorySessions           InventorySession[]
  inventoryReports            InventoryReport[]
  fleetReconciliationFlags    FleetReconciliationFlag[]
  customers                   Customer[]
  reservations                Reservation[]
  loanerRequests              LoanerRequest[]
  auditLogs                   AuditLog[]
  reservationIncidents        ReservationIncident[]
  agreementClauses            AgreementClause[]
  agreements                  RentalAgreement[]
  rates                       Rate[]
  fees                        Fee[]
  services                    AdditionalService[]
  commissionPlans             CommissionPlan[]
  commissionRules             CommissionRule[]
  agreementCommissions        AgreementCommission[]
  hostProfiles                HostProfile[]
  hostPickupSpots             HostPickupSpot[]
  carSharingSearchPlaces      CarSharingSearchPlace[]
  hostServiceAreas            HostServiceArea[]
  carSharingListings          HostVehicleListing[]
  carSharingTrips             Trip[]
  tripFulfillmentPlans        TripFulfillmentPlan[]
  tripPayouts                 TripPayout[]
  hostVehicleSubmissions      HostVehicleSubmission[]
  tollProviderAccounts        TollProviderAccount[]
  tollTransactions            TollTransaction[]
  tollAssignments             TollAssignment[]
  tollImportRuns              TollImportRun[]
  citationSourceAccounts      CitationSourceAccount[]
  citations                   Citation[]
  citationAssignments         CitationAssignment[]
  citationImportRuns          CitationImportRun[]
  telematicsDevices           VehicleTelematicsDevice[]
  telematicsEvents            VehicleTelematicsEvent[]
  plannerRuleSet              PlannerRuleSet?
  plannerScenarios            PlannerScenario[]
  plannerRecommendationAudits PlannerRecommendationAudit[]
  conversations               Conversation[]
  knowledgeArticles           KnowledgeArticle[]
  franchises                  Franchise[]
  agreementAddendums          RentalAgreementAddendum[]
  vehicleClassStopSales       VehicleClassStopSale[]
  marketScrapeProfiles        MarketScrapeProfile[]
  marketPricingConfigs        MarketPricingConfig[]
  pricingRules                PricingRule[]
  repairOrders                RepairOrder[]
  serviceSchedules            ServiceSchedule[]
  pricingSuggestions          PricingSuggestion[]
  feeRates                    FeeRate[]

  // TL International franchise integration (round 5)
  integrationConfig        Json?
  tlExternalReservations   ExternalReservation[]
  tlExternalSyncRuns       ExternalSyncRun[]
  tlIntegrationCredentials IntegrationCredential[]
  tlAcrissCategoryMaps     AcrissCategoryMap[]
  tlLocationCodeMaps       LocationCodeMap[]
  franchisePayoutPeriods   FranchisePayoutPeriod[]
  loanerAgreements         LoanerAgreement[]
  longTermPlans            LongTermPlan[]
}

model Location {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  code           String
  name           String
  address        String?
  city           String?
  state          String?
  country        String?
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  locationConfig String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehiclesHome                   Vehicle[]               @relation("VehicleHomeLocation")
  reservationsPickup             Reservation[]           @relation("ReservationPickupLocation")
  reservationsReturn             Reservation[]           @relation("ReservationReturnLocation")
  agreementsPickup               RentalAgreement[]       @relation("AgreementPickupLocation")
  agreementsReturn               RentalAgreement[]       @relation("AgreementReturnLocation")
  additionalServices             AdditionalService[]
  locationFees                   LocationFee[]
  rates                          Rate[]
  carSharingListings             HostVehicleListing[]
  hostVehicleSubmissionPreferred HostVehicleSubmission[]
  hostPickupSpotsAnchor          HostPickupSpot[]        @relation("HostPickupSpotAnchorLocation")
  carSharingSearchPlacesAnchor   CarSharingSearchPlace[] @relation("CarSharingSearchPlaceAnchorLocation")
  carSharingPickupTrips          Trip[]                  @relation("TripPickupLocation")
  carSharingReturnTrips          Trip[]                  @relation("TripReturnLocation")
  repairOrders                   RepairOrder[]
  feeRates                       FeeRate[]
  locationCodeMaps               LocationCodeMap[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model VehicleType {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  imageUrl    String?
  // Public Vehicle Profile (2026-06-25) — read-only specs exposed on the public booking API
  // (bootstrap + vehicle-classes). All optional/additive; generic for every tenant.
  passengers        Int?          // # seats / passengers
  bags              Int?          // # luggage
  doors             Int?
  transmission      Transmission? // AUTOMATIC | MANUAL
  features          String[]      @default([]) // controlled catalog codes (see vehicle-feature-catalog.js)
  // "What's included" policy (configurable per type — NOT hardcoded):
  unlimitedMileage  Boolean       @default(false)
  freeMilesPerDay   Int?          // used only when unlimitedMileage = false
  insuranceIncluded Boolean       @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles               Vehicle[]
  reservations           Reservation[]          @relation("ReservationVehicleType")
  serviceReservations    Reservation[]          @relation("ReservationServiceVehicleType")
  rateItems              RateItem[]
  rateDailyPrices        RateDailyPrice[]
  hostVehicleSubmissions HostVehicleSubmission[]
  vehicleClassStopSales  VehicleClassStopSale[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Vehicle {
  id                      String                 @id @default(cuid())
  tenantId                String?
  tenant                  Tenant?                @relation(fields: [tenantId], references: [id])
  internalNumber          String
  vin                     String?                @unique
  plate                   String?
  tollTagNumber           String?
  tollStickerNumber       String?
  make                    String?
  model                   String?
  year                    Int?
  color                   String?
  mileage                 Int                    @default(0)
  // Fuel tank capacity in gallons (2026-06-10, fixes backlog #51). Drives the
  // FUEL_REFILL fee: gallons = (fuelOut - fuelIn, quantized to 1/8) × capacity.
  // Nullable — resolveTankCapacity() falls back to 15 gal (+ warn) when unset.
  fuelTankCapacityGallons Decimal?               @db.Decimal(4, 1)
  // Vehicle Profile pack (2026-06-10, plan doc/vehicle-profile-pack-plan):
  // registration tracking + acquisition/value/rotation. All informational —
  // none of these feed billing. currentValue is COMPUTED (declining balance),
  // never stored. Rotation rule (TIME|MILEAGE) lives in AppSetting per tenant.
  registrationExpiresAt   DateTime?
  registrationDocumentUrl String?
  acquisitionCost         Decimal?               @db.Decimal(12, 2)
  acquisitionDate         DateTime?
  depreciationAnnualPct   Decimal?               @db.Decimal(5, 2)
  targetFleetMonths       Int?
  targetFleetMiles        Int?
  status                  VehicleStatus          @default(AVAILABLE)
  fleetMode               VehicleFleetMode       @default(RENTAL_ONLY)
  // Program partition — see VehicleProgramCategory enum docs.
  // Existing vehicles default to BOTH (no behavior change at write time);
  // tenants with a loaner program (e.g. Triangle) tag their loaner units
  // as LOANER_ONLY so the public rental search hides them. Filter rule:
  //   public rental search       → programCategory IN (RENTAL_ONLY, BOTH)
  //   dealership-loaner intake  → programCategory IN (LOANER_ONLY, BOTH)
  programCategory         VehicleProgramCategory @default(BOTH)

  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  homeLocationId String?
  homeLocation   Location? @relation("VehicleHomeLocation", fields: [homeLocationId], references: [id])

  // "Last odometer wins" provenance (2026-05-28). When the dejavoo
  // checkout redesign writes odometerOut or check-in writes odometerIn,
  // we also flip Vehicle.mileage AND stamp this column with the source
  // (e.g. "CHECKOUT_RES-742838" / "CHECKIN_RES-742838") so we can audit
  // which workflow last touched the odometer.
  lastOdometerSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations          Reservation[]
  maintenanceJobs       MaintenanceJob[]
  rentalAgreements      RentalAgreement[]
  hostListing           HostVehicleListing?
  hostVehicleSubmission HostVehicleSubmission?
  tollTransactions      TollTransaction[]
  tollAssignments       TollAssignment[]
  citations             Citation[]
  citationAssignments   CitationAssignment[]
  availabilityBlocks    VehicleAvailabilityBlock[]
  telematicsDevices     VehicleTelematicsDevice[]
  telematicsEvents      VehicleTelematicsEvent[]
  loanerAgreements      LoanerAgreement[]
  mileageEntries        VehicleMileageEntry[]
  inventoryItems        InventoryItem[]
  reconciliationFlags   FleetReconciliationFlag[]
  customerInspections   CustomerInspection[]
  damageReports         VehicleDamageReport[]
  repairOrders          RepairOrder[]
  serviceSchedules      ServiceSchedule[]

  @@unique([tenantId, plate])
  @@unique([tenantId, internalNumber])
  @@index([tenantId, status])
  @@index([tenantId, programCategory])
}

// Per-vehicle odometer history (2026-06-09). Every check-out, check-in, manual
// correction, and telematics ping that touches the odometer appends one row
// here. "Last entry wins": the most recent row (by recordedAt) is the value
// mirrored onto Vehicle.mileage + Vehicle.lastOdometerSource, so the vehicle
// profile can show the full timeline AND which workflow set the current number.
// Append-only by design — corrections are NEW rows (source = MANUAL), never edits.
model VehicleMileageEntry {
  id        String  @id @default(cuid())
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  mileage Int
  source  MileageEntrySource

  // Provenance — denormalized reservation number so the timeline reads cleanly
  // even after a reservation/agreement is archived. IDs kept for joins.
  reservationId     String?
  rentalAgreementId String?
  reservationNumber String?

  note        String?
  actorUserId String?

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([tenantId, vehicleId])
}

enum MileageEntrySource {
  CHECKOUT
  CHECKIN
  MANUAL
  TELEMATICS
  IMPORT
}

// Inventory Helper (2026-06-09). A guided fleet-inventory wizard: one resumable
// session per tenant snapshots the whole fleet into items, agents confirm each
// vehicle (scan + photos + checklist for at-lot, status note for maintenance),
// status mismatches are flagged, and completion produces a saved PDF report.
// See doc/inventory-helper-plan-2026-06-09.md.
model InventorySession {
  id                String                 @id @default(cuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  status            InventorySessionStatus @default(IN_PROGRESS)
  startedByUserId   String?
  startedAt         DateTime               @default(now())
  lastActivityAt    DateTime               @default(now())
  completedByUserId String?
  completedAt       DateTime?
  abandonedAt       DateTime?
  abandonedReason   String?
  // Denormalized counts (total / confirmed / exception / mismatch) so the
  // launch + progress UI can render without re-aggregating every item.
  totalsJson        Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  items  InventoryItem[]
  report InventoryReport?

  @@index([tenantId, status])
}

// One row per vehicle in a session. State is persisted as agents confirm, so
// leaving (e.g. to fix a mismatch via check-in) and returning resumes exactly.
model InventoryItem {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenantId  String?
  vehicleId String
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Snapshot at session start — what the system believed when inventory began.
  expectedStatus  VehicleStatus
  expectedMileage Int?

  state         InventoryItemState      @default(PENDING)
  locatedStatus InventoryLocatedStatus?
  confirmMethod InventoryConfirmMethod?
  confirmReason String?

  // At-lot verification checklist.
  tiresOk          Boolean?
  brakesOk         Boolean?
  lightsOk         Boolean?
  fluidsOk         Boolean?
  cleanOk          Boolean?
  mileageConfirmed Boolean?
  reportedMileage  Int?

  photosJson      Json?
  note            String?
  maintenanceNote String?

  mismatchType           InventoryMismatchType?
  mismatchResolved       Boolean                @default(false)
  mismatchResolutionNote String?

  reservationId     String?
  confirmedByUserId String?
  confirmedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, vehicleId])
  @@index([sessionId, state])
  @@index([tenantId, vehicleId])
}

// Saved PDF report (persisted artifact, unlike the on-the-fly reports module).
// Listed under Reports → Inventory reports, downloaded via a signed URL.
model InventoryReport {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  sessionId         String           @unique
  session           InventorySession @relation(fields: [sessionId], references: [id])
  title             String
  generatedByUserId String?
  generatedAt       DateTime         @default(now())
  storageBucket     String?
  storagePath       String?
