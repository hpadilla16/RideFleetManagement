<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la ventana mientras arranca el proceso: la aurora de Ride.
         windowBackground es lo ÚNICO que se ve hasta el primer frame de
         Flutter, y ese primer frame es la misma aurora (SplashScreen). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Iconos de la barra de estado en CLARO sobre la aurora oscura —
             el mismo criterio que AnnotatedRegion en SplashScreen (GD
             MUST-3). Sin esto, el arranque muestra medio segundo de iconos
             negros ilegibles sobre morado oscuro. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ride_aurora_start</item>
    </style>

    <!-- Tema de la ventana YA con el proceso vivo. FlutterActivity cambia a
         este tema en onCreate, o sea ANTES del primer frame de Flutter: lo
         que se ponga aquí es lo que se ve en ese hueco.

         Honestidad sobre la evidencia (review GD-S8): en API 36 este hueco
         NO se ve, porque el splash del sistema lo tapa hasta que Flutter
         dibuja — se comprobó en el AVD y con blanco aquí tampoco hubo
         destello. Se pone el morado igual por los aparatos API 24-30, donde
         no hay splash del sistema y este color SÍ queda a la vista entre el
         cambio de tema y el primer frame; ahí blanco sí parpadearía contra
         la aurora. Eso NO está verificado en aparato: no hay AVD viejo en
         esta máquina, y va anotado como tal en el reporte.

         Después del primer frame no se ve en ninguna versión: la vista de
         Flutter es opaca y cubre la ventana entera. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ride_aurora_center</item>
    </style>
</resources>
